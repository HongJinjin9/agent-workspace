+            var demo = Api.demo.getProject(summary.id);
+            url = demo ? demoPosterUrl(demo) : '';
+        } else if (summary.rendered && (summary.rendered.posterUrl || summary.rendered.posterPath)) {
+            url = fileUrl(summary.rendered.posterUrl || summary.rendered.posterPath);
