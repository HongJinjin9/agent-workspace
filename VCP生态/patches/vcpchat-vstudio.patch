+                if (menu && !menu.hidden) { menu.hidden = true; return; }
+                if (state.annotateMode) toggleAnnotate(false);
+                return;
+            }
+            if (typing) return;
+            if (!state.project) return;
+            if (e.code === 'Space') { e.preventDefault(); togglePlay(); }
+            else if (e.key === 'ArrowLeft') { e.preventDefault(); if (state.playing) setPlayState(false); setFrame(state.frame - (e.shiftKey ? state.fps : 1)); }
+            else if (e.key === 'ArrowRight') { e.preventDefault(); if (state.playing) setPlayState(false); setFrame(state.frame + (e.shiftKey ? state.fps : 1)); }
+            else if (e.key === 'Home') { e.preventDefault(); setFrame(0); }
+            else if (e.key === 'End') { e.preventDefault(); setFrame(state.totalFrames - 1); }
+            else if (e.key === 'b' || e.key === 'B') { e.preventDefault(); toggleAnnotate(); }
+        });
+    }
