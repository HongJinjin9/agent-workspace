diff --git a/modules/ipc/vstudioHandlers.js b/modules/ipc/vstudioHandlers.js
new file mode 100644
index 00000000..1b598ae8
--- /dev/null
+++ b/modules/ipc/vstudioHandlers.js
@@ -0,0 +1,634 @@
+// modules/ipc/vstudioHandlers.js
+// V视听（VStudio）视频协同工坊的主进程桥。
+//
+// 职责边界：
+//   - 窗口注册与托盘入口在 modules/ipc/desktopHandlers.js、modules/trayManager.js；
+//   - 本文件只做「渲染端 IPC → VCPToolBox 插件核心」的转发，以及「批注交给 AI」的注入；
+//   - 后端核心由 vstudio-backend 并行实现：/app/VCPToolBox/Plugin/VStudio/VStudioCore.js。
+//     require 失败时所有 handler 统一返回 { success:false, error:'VStudio 后端未安装' }，
+//     绝不让主进程崩溃，也不影响其它窗口。
+'use strict';
+
+const { ipcMain: defaultIpcMain, BrowserWindow, dialog, shell } = require('electron');
+const path = require('path');
+const fs = require('fs');
+const { pathToFileURL } = require('url');
+
+// 后端核心的契约路径（与 task 描述一致）；再按常见部署位置兜底，方便非 /app 部署。
+const DEFAULT_CORE_PATH = '/app/VCPToolBox/Plugin/VStudio/VStudioCore.js';
+const PROJECT_ROOT = path.resolve(__dirname, '..', '..'); // /app/VCPChat
+
+// 所有 IPC 通道：统一返回 { success:true, data } / { success:false, error }
+const CHANNELS = Object.freeze([
+    'vstudio:list-projects',
+    'vstudio:get-project',
+    'vstudio:create-project',
+    'vstudio:update-project',
+    'vstudio:save-project',
+    'vstudio:add-annotation',
+    'vstudio:update-annotation',
+    'vstudio:delete-annotation',
+    'vstudio:list-assets',
+    'vstudio:import-asset',
+    'vstudio:pick-media',
+    'vstudio:render',
+    'vstudio:render-status',
+    'vstudio:send-to-agent',
+    'vstudio:open-project-dir',
+]);
+
+const MEDIA_FILTERS = Object.freeze([
+    { name: '媒体文件', extensions: ['mp4', 'mov', 'webm', 'mkv', 'mp3', 'wav', 'm4a', 'aac', 'flac', 'png', 'jpg', 'jpeg', 'webp', 'gif', 'svg'] },
+    { name: '所有文件', extensions: ['*'] },
+]);
+
+let ipcMain = defaultIpcMain;
+let getMainWindowRef = () => null;
+let coreModule = null; // 后端核心模块缓存；require 成功后复用同一模块实例
+
+function resolveCorePath() {
+    // 端到端测试/离线部署可显式指定核心文件（其它情况不要设置）
+    const override = typeof process.env.VSTUDIO_CORE_PATH === 'string' ? process.env.VSTUDIO_CORE_PATH.trim() : '';
+    if (override) return override;
+
+    const candidates = [DEFAULT_CORE_PATH];
+    if (typeof process.env.VCPTOOLBOX_DIR === 'string' && process.env.VCPTOOLBOX_DIR.trim()) {
+        candidates.push(path.join(process.env.VCPTOOLBOX_DIR.trim(), 'Plugin', 'VStudio', 'VStudioCore.js'));
+    }
+    candidates.push(path.join(PROJECT_ROOT, '..', 'VCPToolBox', 'Plugin', 'VStudio', 'VStudioCore.js'));
+    candidates.push(path.resolve(process.cwd(), '..', 'VCPToolBox', 'Plugin', 'VStudio', 'VStudioCore.js'));
+
+    for (const candidate of candidates) {
+        try {
+            if (candidate && fs.existsSync(candidate)) return candidate;
+        } catch (_) { /* 忽略不可访问的候选路径 */ }
+    }
+    return candidates[0];
+}
+
+function loadCore() {
+    if (coreModule) return coreModule;
+    const corePath = resolveCorePath();
+    try {
+        coreModule = require(corePath);
+    } catch (error) {
+        // 只记录日志，不把异常抛给主进程初始化流程；调用方统一收到「后端未安装」。
+        console.error(`[VStudio] 无法加载后端核心 ${corePath}:`, error?.message || error);
+        throw new Error('VStudio 后端未安装');
+    }
+    return coreModule;
+}
+
+function callCore(method, ...args) {
+    const core = loadCore();
+    if (typeof core[method] !== 'function') {
+        throw new Error(`VStudio 后端缺少 ${method}()`);
+    }
+    return core[method](...args);
+}
+
+// 与 modules/ipc/projectForgeHandlers.js 相同的包装：任何异常都变成 { success:false, error }
+function wrap(handler) {
+    return async (event, ...args) => {
+        try {
+            return { success: true, data: await handler(event, ...args) };
+        } catch (error) {
+            const message = error?.message || String(error);
+            console.warn('[VStudio] IPC 处理失败:', message);
+            return { success: false, error: message };
+        }
+    };
+}
+
+function projectIdOf(value) {
+    if (!value) return '';
+    if (typeof value === 'string') return value;
+    if (typeof value === 'object') {
+        return value.id || value.projectId || value.project?.id || '';
+    }
+    return '';
+}
+
+// ---------------------------------------------------------------------------
+// 媒体路径 enrich（主进程出口，浅拷贝增强，不改 core 数据、不写盘）
+//
+// 后端核心（VStudioCore.js）的 getProject/listProjects/listAssets/render 返回的是「工程内相对路径」：
+//   rendered.path = 'renders/final.mp4'、rendered.posterPath = 'renders/poster.jpg'、
+//   scenes[].src = 'assets/clip.mp4'、audio.tracks[].src = 'assets/voice.mp3'、asset.src = 'assets/x.png'。
+// 渲染进程的 <video>/<img> 需要 file:// URL，所以在这里统一补：
+//   project.dir、project.rendered.videoUrl/posterUrl、scenes[].srcUrl、audio.tracks[].srcUrl、
+//   asset.url、render 返回值的 videoUrl/posterUrl。
+// 真实后端把工程存在 <core.homeDir()>/projects/<projectId>，homeDir 是核心的辅助导出（函数或字符串都兼容），
+// 所以这里不需要额外 IO 就能拼出绝对路径；非标准后端再退回 resolveProjectDir 兜底。
+// ---------------------------------------------------------------------------
+
+const URL_LIKE_PATTERN = /^(?:file|https?|data|blob):/i;
+
+function isUrlLike(value) {
+    return typeof value === 'string' && URL_LIKE_PATTERN.test(value);
+}
+
+// 绝对路径 → 可安全放进 <video src> / <img src> 的 file:// URL；已是 URL 则原样返回。
+function toFileUrl(absolutePath) {
+    if (typeof absolutePath !== 'string' || !absolutePath) return '';
+    if (isUrlLike(absolutePath)) return absolutePath;
+    try {
+        return pathToFileURL(absolutePath).href;
+    } catch (error) {
+        console.warn('[VStudio] 生成 file:// URL 失败:', error?.message || error);
+        return '';
+    }
+}
+
+// 工程目录（同步）：优先 <core.homeDir()>/projects/<id>，其次核心辅助 getProjectDir（非契约）。
+function projectDirOf(projectId) {
+    const id = String(projectId || '');
+    if (!id) return '';
+    try {
+        const core = loadCore();
+        const home = typeof core.homeDir === 'function' ? core.homeDir() : core.homeDir;
+        if (typeof home === 'string' && home) return path.join(home, 'projects', id);
+        if (typeof core.getProjectDir === 'function') {
+            const dir = core.getProjectDir(id);
+            if (typeof dir === 'string' && dir) return dir;
+        }
+    } catch (error) {
+        console.warn('[VStudio] 推导工程目录失败:', error?.message || error);
+    }
+    return '';
+}
+
+// 异步兜底：同步推导失败时再走 resolveProjectDir（会读工程数据，只在非标准后端用到）。
+async function projectDirOfAsync(projectId) {
+    const dir = projectDirOf(projectId);
+    if (dir) return dir;
+    try {
+        return (await resolveProjectDir(String(projectId || ''))) || '';
+    } catch (_) {
+        return '';
+    }
+}
+
+function resolveSrcUrl(dir, src) {
+    if (typeof src !== 'string' || !src) return '';
+    if (isUrlLike(src)) return src; // 已经是可用 URL：原样
+    if (path.isAbsolute(src)) return toFileUrl(src);
+    return dir ? toFileUrl(path.resolve(dir, src)) : '';
+}
+
+function toAbsolutePath(dir, value) {
+    if (typeof value !== 'string' || !value) return '';
+    if (isUrlLike(value)) return value;
+    if (path.isAbsolute(value)) return value;
+    return dir ? path.resolve(dir, value) : '';
+}
+
+function enrichRendered(rendered, dir) {
+    if (!rendered || typeof rendered !== 'object') return rendered;
+    const enriched = { ...rendered };
+    if (!enriched.videoUrl) {
+        const video = enriched.absolutePath || enriched.path;
+        const url = toFileUrl(toAbsolutePath(dir, video));
+        if (url) enriched.videoUrl = url;
+    }
+    if (!enriched.posterUrl) {
+        const poster = enriched.posterAbsolutePath || enriched.posterPath;
+        const url = toFileUrl(toAbsolutePath(dir, poster));
+        if (url) enriched.posterUrl = url;
+    }
+    return enriched;
+}
+
+// 工程浅拷贝：加 dir / rendered.videoUrl、posterUrl / scenes[].srcUrl / audio.tracks[].srcUrl。
+function enrichProject(project, dirOverride) {
+    if (!project || typeof project !== 'object') return project;
+    const dir = dirOverride || projectDirOf(projectIdOf(project)) || (typeof project.dir === 'string' ? project.dir : '');
+    const enriched = { ...project, dir: dir || project.dir || '' };
+    if (project.rendered && typeof project.rendered === 'object') {
+        enriched.rendered = enrichRendered(project.rendered, dir);
+    }
+    if (Array.isArray(project.scenes)) {
+        enriched.scenes = project.scenes.map((scene) => {
+            if (!scene || typeof scene !== 'object') return scene;
+            const srcUrl = resolveSrcUrl(dir, scene.src);
+            return srcUrl ? { ...scene, srcUrl } : { ...scene };
+        });
+    }
+    if (project.audio && typeof project.audio === 'object' && Array.isArray(project.audio.tracks)) {
+        enriched.audio = {
+            ...project.audio,
+            tracks: project.audio.tracks.map((track) => {
+                if (!track || typeof track !== 'object') return track;
+                const srcUrl = resolveSrcUrl(dir, track.src);
+                return srcUrl ? { ...track, srcUrl } : { ...track };
+            }),
+        };
+    }
+    return enriched;
+}
+
+// 素材浅拷贝：加 url（核心 asset 形状：{name,file,src:'assets/x.png',type,mime,size,width,height,duration,...}）。
+function enrichAsset(asset, dir) {
+    if (!asset || typeof asset !== 'object') return asset;
+    const enriched = { ...asset };
+    if (!enriched.url) {
+        const known = firstDefined(enriched.absolutePath, enriched.sourcePath);
+        let target = '';
+        if (typeof known === 'string' && known) {
+            target = known;
+        } else {
+            const relative = firstDefined(enriched.src, enriched.file, enriched.path);
+            if (typeof relative === 'string' && relative) {
+                target = path.isAbsolute(relative) || isUrlLike(relative) ? relative : (dir ? path.resolve(dir, relative) : '');
+            }
+        }
+        const url = toFileUrl(target);
+        if (url) enriched.url = url;
+    }
+    return enriched;
+}
+
+// render 返回：核心给的是 { path, absolutePath, posterPath, posterAbsolutePath, ... }（路径为工程内相对路径）。
+function enrichRenderResult(result, projectId) {
+    if (!result || typeof result !== 'object') return result;
+    const dir = projectDirOf(projectId || projectIdOf(result)) || '';
+    const enriched = { ...result };
+    if (dir && !enriched.dir) enriched.dir = dir;
+    if (!enriched.videoUrl) {
+        const url = toFileUrl(toAbsolutePath(dir, firstDefined(enriched.absolutePath, enriched.path)));
+        if (url) enriched.videoUrl = url;
+    }
+    if (!enriched.posterUrl) {
+        const url = toFileUrl(toAbsolutePath(dir, firstDefined(enriched.posterAbsolutePath, enriched.posterPath)));
+        if (url) enriched.posterUrl = url;
+    }
+    return enriched;
+}
+
+// 每次写操作后向所有窗口广播：VStudio 窗口刷新工程，主窗口侧栏等也可按需感知。
+// 这里按 task 契约用 BrowserWindow.getAllWindows() 直接广播（不走按窗口订阅表）。
+function broadcastChanged(projectId) {
+    const payload = { projectId: String(projectId || '') };
+    for (const win of BrowserWindow.getAllWindows()) {
+        if (!win || win.isDestroyed()) continue;
+        try {
+            win.webContents.send('vstudio:changed', payload);
+        } catch (error) {
+            console.warn('[VStudio] 广播变更失败:', error?.message || error);
+        }
+    }
+}
+
+function findMainWindow() {
+    const fromOwner = getMainWindowRef();
+    if (fromOwner && !fromOwner.isDestroyed?.()) return fromOwner;
+    const windows = BrowserWindow.getAllWindows();
+    return windows.find(win => {
+        if (!win || win.isDestroyed()) return false;
+        try {
+            const url = win.webContents.getURL();
+            return url.includes('main.html') && !url.includes('desktop.html');
+        } catch (_) {
+            return false;
+        }
+    }) || null;
+}
+
+function firstDefined(...values) {
+    for (const value of values) {
+        if (value !== undefined && value !== null && value !== '') return value;
+    }
+    return undefined;
+}
+
+function formatValue(value) {
+    if (typeof value === 'string') return value;
+    try {
+        return JSON.stringify(value);
+    } catch (_) {
+        return String(value);
+    }
+}
+
+function truncate(value, limit) {
+    const text = String(value);
+    return text.length > limit ? `${text.slice(0, limit)}…（已截断）` : text;
+}
+
+/**
+ * 拼装「交给 AI」的完整转交文本：工程 id、批注帧号/区域/target/text 与明确指令必须齐全。
+ * context 由 VStudio 页面传入（结构化批注对象，字段名未知时原样放进上下文）。
+ */
+function buildAgentHandoffText({ projectId, text, context }) {
+    const lines = ['【V视听 · 批注交办】'];
+    const contextObject = context && typeof context === 'object' ? context : null;
+    const projectName = contextObject && typeof contextObject.projectName === 'string' ? contextObject.projectName.trim() : '';
+    lines.push(projectName ? `工程：${projectName}（id：${projectId || '未提供'}）` : `工程 id：${projectId || '（未提供）'}`);
+
+    const body = typeof text === 'string' ? text.trim() : '';
+    const annotation = contextObject && contextObject.annotation && typeof contextObject.annotation === 'object'
+        ? contextObject.annotation
+        : contextObject;
+
+    let located = false;
+    if (annotation) {
+        const frame = firstDefined(annotation.frame, annotation.frameIndex, annotation.frameNumber, annotation.frameNo);
+        const region = firstDefined(annotation.region, annotation.area, annotation.rect);
+        const target = firstDefined(annotation.target, annotation.targetSelector);
+        // VStudioModules/vstudio.js 的 context 用 annotationText；其它调用方可能用 text/content/comment/note
+        const noteText = firstDefined(annotation.text, annotation.annotationText, annotation.content, annotation.comment, annotation.note);
+        const timecode = firstDefined(annotation.timecode, contextObject?.timecode);
+        if (frame !== undefined) {
+            lines.push(`批注帧号：第 ${frame} 帧${timecode ? `（时间码 ${timecode}）` : ''}`);
+            located = true;
+        }
+        if (region !== undefined) {
+            lines.push(`批注区域：${formatValue(region)}`);
+            located = true;
+        }
+        if (target !== undefined) {
+            lines.push(`target：${formatValue(target)}`);
+            located = true;
+        }
+        if (noteText !== undefined && !(body && body.includes(String(noteText)))) {
+            lines.push(`批注内容：${formatValue(noteText)}`);
+            located = true;
+        }
+        if (!located) {
+            // 字段名不认识时原样转交，避免丢信息
+            lines.push(`批注上下文：${truncate(formatValue(contextObject), 2000)}`);
+        }
+    }
+
+    if (body) {
+        lines.push('', '转交指令：', body);
+    } else if (annotation && located) {
+        lines.push('', '转交指令：请按以上批注修改工程。');
+    }
+
+    lines.push('', '请按以上批注修改 V视听（VStudio）工程的对应场景/字幕/音轨/标注实现，完成后调用 vstudioSaveProject 保存工程。');
+    return lines.join('\n');
+}
+
+/**
+ * 在主窗口页面上下文里执行的自包含脚本：把转交文本填进聊天输入框并聚焦。
+ * 优先复用主聊天自己登记的 composer.insert-text 命令（负责追加、自动撑高、派发 input、聚焦），
+ * 命令不可用时退回直接写 #messageInput（行为与 modules/renderer/composerCommands.js 一致）。
+ * 注意：只填入 + 提示，不自动发送——主聊天的发送会受流式会话/禁用状态影响，
+ * 由用户按回车确认更安全，也不改动既有发送逻辑。
+ */
+function buildComposerInjectionScript(text) {
+    return `(() => {
+  try {
+    const text = ${JSON.stringify(String(text))};
+    const input = document.getElementById('messageInput');
+    if (!input || input.disabled) return { ok: false, reason: 'no-composer' };
+    const commands = window.VCPContributions && window.VCPContributions.commands;
+    let inserted = false;
+    if (commands && typeof commands.execute === 'function') {
+      try {
+        const result = commands.execute('composer.insert-text', text, { gap: 'paragraph' });
+        inserted = Boolean(result && result.inserted);
+      } catch (error) { inserted = false; }
+    }
+    if (!inserted) {
+      const current = input.value || '';
+      input.value = current.trim() ? current.trim() + '\\n\\n' + text : text;
+      input.dispatchEvent(new Event('input', { bubbles: true }));
+      input.focus();
+    }
+    try {
+      if (window.uiHelperFunctions && typeof window.uiHelperFunctions.showToastNotification === 'function') {
+        window.uiHelperFunctions.showToastNotification('V视听批注已填入输入框，按回车发送', 'success');
+      } else if (typeof Notification === 'function') {
+        new Notification('V视听 · 批注已转交', { body: '批注已填入输入框，按回车发送' });
+      }
+    } catch (error) { /* 提示失败不影响填入 */ }
+    return { ok: true, mode: inserted ? 'command' : 'direct' };
+  } catch (error) {
+    return { ok: false, reason: 'exception', message: String((error && error.message) || error) };
+  }
+})()`;
+}
+
+async function sendToAgent(projectId, text, context) {
+    const mainWin = findMainWindow();
+    if (!mainWin) throw new Error('主窗口未就绪，无法转交批注');
+    const handoffText = buildAgentHandoffText({ projectId, text, context });
+    let result = null;
+    try {
+        result = await mainWin.webContents.executeJavaScript(buildComposerInjectionScript(handoffText), true);
+    } catch (error) {
+        throw new Error(`主窗口尚未就绪：${error?.message || error}`);
+    }
+    if (!result || result.ok !== true) {
+        if (result && result.reason === 'no-composer') {
+            throw new Error('主窗口聊天输入框未就绪（请先在主窗口选择 Agent 与话题）');
+        }
+        throw new Error((result && result.message) || '主窗口聊天输入框未就绪');
+    }
+    // 用户点了「交给 AI」，把主窗口带到前台让用户确认并回车发送
+    try {
+        if (mainWin.isMinimized?.()) mainWin.restore?.();
+        if (!mainWin.isVisible?.()) mainWin.show?.();
+        mainWin.focus?.();
+    } catch (_) { /* 聚焦失败不影响转交 */ }
+    return { projectId: String(projectId || ''), inserted: true, mode: result.mode || 'direct' };
+}
+
+function isDirectory(target) {
+    try {
+        return fs.statSync(target).isDirectory();
+    } catch (_) {
+        return false;
+    }
+}
+
+// 工程目录：后端契约里没有专门的 getProjectDir，按能力探测 + 真实后端的存储约定 + getProject 常见字段兜底。
+// 真实后端（/app/VCPToolBox/Plugin/VStudio/VStudioCore.js）把工程放在 <homeDir>/projects/<projectId>，
+// homeDir() 是核心的辅助导出（非契约，供主进程/测试使用），所以主进程直接用它可以准确定位工程目录。
+async function resolveProjectDir(projectId) {
+    const core = loadCore();
+    const id = String(projectId || '');
+    if (typeof core.getProjectDir === 'function') {
+        const dir = await core.getProjectDir(id);
+        if (typeof dir === 'string' && isDirectory(dir)) return dir;
+    }
+
+    // 先校验工程存在（getProject 会做 ID 合法性/数据完整性检查），失败信息最后再抛
+    let project = null;
+    let projectError = null;
+    try {
+        project = await core.getProject(id);
+    } catch (error) {
+        projectError = error;
+        console.warn('[VStudio] 读取工程失败，尝试从后端存储约定推导目录:', error?.message || error);
+    }
+
+    if (typeof core.homeDir === 'function') {
+        try {
+            const dir = path.join(core.homeDir(), 'projects', id);
+            if (isDirectory(dir)) return dir;
+        } catch (error) {
+            console.warn('[VStudio] homeDir() 不可用:', error?.message || error);
+        }
+    }
+
+    const candidates = project && typeof project === 'object'
+        ? [project.dir, project.projectDir, project.folder, project.absolutePath, project.path, project.root]
+        : [];
+    for (const candidate of candidates) {
+        if (typeof candidate !== 'string' || !candidate) continue;
+        const dir = isDirectory(candidate) ? candidate : path.dirname(candidate);
+        if (isDirectory(dir)) return dir;
+    }
+
+    // 兜底：部分后端把 resolveMediaPath(id, <工程内相对路径>) 解析为绝对路径，取工程内已知素材的目录
+    if (typeof core.resolveMediaPath === 'function' && project && Array.isArray(project.scenes)) {
+        for (const scene of project.scenes) {
+            if (!scene || typeof scene.src !== 'string' || !scene.src) continue;
+            try {
+                const resolved = await core.resolveMediaPath(id, scene.src);
+                if (typeof resolved === 'string' && resolved) {
+                    const dir = path.dirname(resolved);
+                    if (isDirectory(dir)) return dir;
+                }
+            } catch (_) { /* 继续尝试下一个场景 */ }
+        }
+    }
+
+    if (projectError) throw projectError;
+    return null;
+}
+
+async function openProjectDir(projectId) {
+    const id = String(projectId || '');
+    if (!id) throw new Error('缺少工程 id');
+    const dir = await resolveProjectDir(id);
+    if (!dir) throw new Error('无法定位工程目录');
+    const openError = await shell.openPath(dir);
+    if (openError) throw new Error(`打开工程目录失败：${openError}`);
+    return { dir };
+}
+
+async function pickMedia(event, options) {
+    const opts = options && typeof options === 'object' ? options : {};
+    const filters = Array.isArray(opts.filters) && opts.filters.length ? opts.filters : MEDIA_FILTERS;
+    const dialogOptions = {
+        title: typeof opts.title === 'string' && opts.title ? opts.title : '选择媒体文件',
+        properties: opts.multiple === false ? ['openFile'] : ['openFile', 'multiSelections'],
+        filters,
+    };
+    const parent = BrowserWindow.fromWebContents?.(event?.sender) || null;
+    const result = parent
+        ? await dialog.showOpenDialog(parent, dialogOptions)
+        : await dialog.showOpenDialog(dialogOptions);
+    const filePaths = Array.isArray(result?.filePaths) ? result.filePaths : [];
+    // filePaths 是契约字段；paths/files 是 VStudioModules/vstudio.js 读取的兼容别名（vstudio.js: picked.data.paths）。
+    return { canceled: Boolean(result?.canceled), filePaths, paths: filePaths, files: filePaths };
+}
+
+/**
+ * @param {object} [options]
+ * @param {object} [options.ipcMain] 默认使用 electron.ipcMain；便于测试注入假对象
+ * @param {() => object|null} [options.getMainWindow] 主窗口引用（desktopHandlers 传入 () => mainWindow）
+ */
+function initialize(options = {}) {
+    ipcMain = options.ipcMain || defaultIpcMain;
+    getMainWindowRef = typeof options.getMainWindow === 'function' ? options.getMainWindow : () => null;
+
+    // 重复初始化（主窗口重建）时先移除旧 handler，避免 duplicate handle
+    CHANNELS.forEach(channel => ipcMain.removeHandler(channel));
+
+    // —— 只读 ——
+    // —— 只读（出口 enrich：把工程内相对路径补成 file:// URL，见 enrichProject/enrichAsset）——
+    ipcMain.handle('vstudio:list-projects', wrap(async () => {
+        const projects = await callCore('listProjects');
+        if (!Array.isArray(projects)) return projects;
+        return projects.map(project => enrichProject(project, projectDirOf(projectIdOf(project))));
+    }));
+    ipcMain.handle('vstudio:get-project', wrap(async (_event, projectId) => {
+        const id = String(projectId || '');
+        const project = await callCore('getProject', id);
+        return enrichProject(project, await projectDirOfAsync(id));
+    }));
+    ipcMain.handle('vstudio:render-status', wrap((_event, projectId) => callCore('renderStatus', String(projectId || ''))));
+    ipcMain.handle('vstudio:list-assets', wrap(async (_event, projectId) => {
+        const id = String(projectId || '');
+        const assets = await callCore('listAssets', id);
+        if (!Array.isArray(assets)) return assets;
+        const dir = await projectDirOfAsync(id);
+        return assets.map(asset => enrichAsset(asset, dir));
+    }));
+
+    // —— 写操作：执行后向所有窗口广播 vstudio:changed ——
+    ipcMain.handle('vstudio:create-project', wrap(async (_event, payload) => {
+        const data = await callCore('createProject', payload && typeof payload === 'object' ? payload : {});
+        broadcastChanged(projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:update-project', wrap(async (_event, projectId, patch) => {
+        const id = String(projectId || '');
+        const data = await callCore('updateProject', id, patch && typeof patch === 'object' ? patch : {});
+        broadcastChanged(id || projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:save-project', wrap(async (_event, project) => {
+        const payload = project && typeof project === 'object' ? project : {};
+        const data = await callCore('saveProject', payload);
+        broadcastChanged(projectIdOf(data) || projectIdOf(payload));
+        return data;
+    }));
+    ipcMain.handle('vstudio:add-annotation', wrap(async (_event, projectId, annotation) => {
+        const id = String(projectId || '');
+        const data = await callCore('addAnnotation', id, annotation && typeof annotation === 'object' ? annotation : {});
+        broadcastChanged(id || projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:update-annotation', wrap(async (_event, projectId, annotationId, patch) => {
+        const id = String(projectId || '');
+        const data = await callCore('updateAnnotation', id, String(annotationId || ''), patch && typeof patch === 'object' ? patch : {});
+        broadcastChanged(id || projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:delete-annotation', wrap(async (_event, projectId, annotationId) => {
+        const id = String(projectId || '');
+        const data = await callCore('removeAnnotation', id, String(annotationId || ''));
+        broadcastChanged(id || projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:import-asset', wrap(async (_event, projectId, payload) => {
+        const id = String(projectId || '');
+        const data = await callCore('importAsset', id, payload && typeof payload === 'object' ? payload : {});
+        broadcastChanged(id || projectIdOf(data));
+        return data;
+    }));
+    ipcMain.handle('vstudio:render', wrap(async (_event, projectId) => {
+        const id = String(projectId || '');
+        const data = await callCore('render', id);
+        broadcastChanged(id || projectIdOf(data));
+        // render 返回绝对路径字段（absolutePath/posterAbsolutePath），出口补 videoUrl/posterUrl 供 <video> 直接用
+        return enrichRenderResult(data, id || projectIdOf(data));
+    }));
+
+    // —— 主进程本地能力（不经过后端）——
+    ipcMain.handle('vstudio:pick-media', wrap(pickMedia));
+    ipcMain.handle('vstudio:send-to-agent', wrap((_event, projectId, text, context) => sendToAgent(projectId, text, context)));
+    ipcMain.handle('vstudio:open-project-dir', wrap((_event, projectId) => openProjectDir(projectId)));
+}
+
+module.exports = {
+    CHANNELS,
+    initialize,
+    // 供测试与排障使用
+    _internal: {
+        resolveCorePath,
+        buildAgentHandoffText,
+        buildComposerInjectionScript,
+        toFileUrl,
+        enrichProject,
+        enrichAsset,
+        enrichRenderResult,
+        projectDirOf,
+    },
+};
