+    function updatePreviewMedia() {
+        var p = state.project;
+        var video = $('#preview-video');
+        var poster = $('#poster-img');
+        var canvas = $('#demo-poster');
+        var empty = $('#stage-empty');
+        if (!p) {
+            if (video) { video.hidden = true; video.removeAttribute('src'); try { video.load(); } catch (e) {} }
+            if (poster) { poster.hidden = true; poster.removeAttribute('src'); }
+            if (canvas) canvas.hidden = true;
+            if (empty) empty.hidden = false;
+            setStageEmpty('尚未选择工程', '选择左侧工程，或新建一个 V视听 工程');
+            state.videoOk = false;
+            state.videoKey = '';
+            return;
+        }
+        var rendered = p.rendered || {};
+        var demo = state.demoMode;
+        var videoUrl = demo ? '' : fileUrl(rendered.videoUrl || rendered.path);
+        var posterUrl = demo ? '' : fileUrl(rendered.posterUrl || rendered.posterPath);
+
+        if (videoUrl && rendered.status === 'ready') {
+            if (video) {
+                var key = videoUrl + '|' + (rendered.at || rendered.status);
+                if (state.videoKey !== key) {
+                    state.videoKey = key;
+                    state.videoOk = false;
+                    video.hidden = false;
+                    try { video.poster = posterUrl || ''; } catch (e) {}
+                    video.src = Api.cacheBust(videoUrl);
+                    try { video.load(); } catch (e) {}
+                }
+                video.hidden = false;
+            }
+            if (poster) poster.hidden = true;
+            if (canvas) canvas.hidden = true;
+            if (empty) empty.hidden = true;
+        } else if (posterUrl) {
+            if (video) { video.hidden = true; state.videoOk = false; }
+            if (canvas) canvas.hidden = true;
+            if (poster) {
+                poster.hidden = false;
+                poster.src = Api.cacheBust(posterUrl);
+            }
+            if (empty) empty.hidden = true;
+            state.videoKey = '';
+        } else if (demo) {
+            if (video) { video.hidden = true; state.videoOk = false; }
+            if (poster) poster.hidden = true;
+            if (canvas) {
+                canvas.hidden = false;
+                demoPosterCache[p.id] = demoPosterCache[p.id] || '';
+                paintFrame(canvas, p, state.frame, false);
+            }
+            if (empty) empty.hidden = true;
+            state.videoKey = '';
+        } else {
+            if (video) { video.hidden = true; state.videoOk = false; }
+            if (poster) { poster.hidden = true; poster.removeAttribute('src'); }
+            if (canvas) canvas.hidden = true;
+            if (empty) empty.hidden = false;
+            setStageEmpty('尚未渲染', '点击右上「渲染」生成视频，渲染后即可播放并逐帧批注');
+            state.videoKey = '';
