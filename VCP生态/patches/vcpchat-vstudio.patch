+/*
+ * V视听 · VCP 视频协同工坊 —— 视觉样式
+ *
+ * 直接复用 VCPChat 的主题变量（styles/themes.css：--primary-bg / --secondary-bg /
+ * --border-color / --primary-text / --highlight-text / --success-color …），
+ * 观感对齐 ProjectForge 施工图与 Scriptorium 文坊：工业石墨底、磨砂面板、
+ * 琥珀强调、铜绿状态色、12px 圆角、Segoe UI 字体。
+ */
+
+:root {
+    --vs-bg: var(--primary-bg, #171a1d);
+    --vs-bg-2: var(--secondary-bg, #20252a);
+    --vs-panel: var(--panel-bg, rgba(32, 37, 42, 0.86));
+    --vs-panel-solid: #1a1f23;
+    --vs-border: var(--border-color, #3b4449);
+    --vs-text: var(--primary-text, #f2f0e9);
+    --vs-sub: var(--secondary-text, #a7afb1);
+    --vs-amber: var(--highlight-text, #f2a900);
+    --vs-teal: var(--success-color, #76bfae);
+    --vs-danger: var(--danger-color, #e06c5f);
+    --vs-violet: #c98cff;
+    --vs-blue: #8ab4ff;
+    --vs-radius: 12px;
+    --vs-hover: rgba(255, 255, 255, 0.055);
+    --vs-sunk: rgba(0, 0, 0, 0.22);
+    --vs-font: 'Segoe UI', 'Segoe UI Variable', 'Microsoft YaHei', 'PingFang SC', system-ui, sans-serif;
+    --vs-mono: 'Cascadia Code', Consolas, 'SFMono-Regular', monospace;
+    --tl-label-w: 118px;
+}
+
+* { box-sizing: border-box; }
+
+html, body {
+    width: 100%;
+    height: 100%;
+    margin: 0;
+    overflow: hidden;
+}
+
+body {
+    display: flex;
+    flex-direction: column;
+    color: var(--vs-text);
+    background-color: var(--vs-bg);
+    background-image:
+        radial-gradient(1100px 620px at 82% 4%, rgba(242, 169, 0, 0.07), transparent 62%),
+        radial-gradient(900px 560px at 8% 96%, rgba(118, 191, 174, 0.055), transparent 60%),
+        repeating-linear-gradient(90deg, transparent 0 119px, rgba(59, 68, 73, 0.07) 120px),
+        linear-gradient(158deg, rgba(23, 26, 29, 0.97), rgba(32, 37, 42, 0.92));
+    background-size: auto, auto, auto, auto;
+    font-family: var(--vs-font);
+    font-size: 13px;
+    line-height: 1.4;
+    user-select: none;
+    -webkit-font-smoothing: antialiased;
+}
+
+button, input, select, textarea { font: inherit; color: inherit; }
