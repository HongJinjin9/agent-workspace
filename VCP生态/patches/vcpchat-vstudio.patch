+        tracks.push({
+            id: uid('track'),
+            name: asset.name.replace(/\.[^.]+$/, ''),
+            kind: kind,
+            src: asset.path,
+            start: 0,
+            duration: Math.min(p.duration, 8),
+            volume: 0.6,
+            fadeIn: 0.3,
+            fadeOut: 0.5
+        });
+        var ok = await patchProject({ audio: { tracks: tracks } });
+        if (!ok) return;
+        if (state.demoMode) {
+            p.audio = p.audio || { tracks: [] };
+            p.audio.tracks = tracks.map(function (t) { return Object.assign({}, t); });
+            toast('示例模式：素材已加入音轨（仅本地演示）', 'success');
+            updateAll();
+        } else {
