+/*
+ * V视听 · VCP 视频协同工坊 —— 主进程 API 适配层
+ *
+ * 只做三件事：
+ *  1) 探测 window.utilityAPI 上的 vstudio* 方法（缺失时绝不抛异常）；
+ *  2) 统一 {success,data|error} 返回，统一把 file:// URL 归一化；
+ *  3) 后端未注册时提供一份示例数据（仅内存，操作不落盘），保证页面不白屏。
+ *
+ * 页面只依赖 window.VStudioApi，不直接摸 window.utilityAPI。
+ */
+(function () {
+    'use strict';
+
+    var API_METHODS = [
+        'vstudioListProjects', 'vstudioGetProject', 'vstudioCreateProject',
+        'vstudioUpdateProject', 'vstudioSaveProject',
+        'vstudioAddAnnotation', 'vstudioUpdateAnnotation', 'vstudioDeleteAnnotation',
+        'vstudioListAssets', 'vstudioImportAsset', 'vstudioPickMedia',
+        'vstudioRender', 'vstudioRenderStatus', 'vstudioSendToAgent',
+        'vstudioOpenProjectDir', 'onVstudioChanged'
+    ];
+
+    var REQUIRED = ['vstudioListProjects', 'vstudioGetProject'];
+
+    function bridge() {
+        try {
+            return window.utilityAPI || window.electronAPI || null;
+        } catch (err) {
+            return null;
+        }
+    }
+
+    function findFn(name) {
+        var b = bridge();
+        if (!b) return null;
+        try {
+            return typeof b[name] === 'function' ? b[name].bind(b) : null;
+        } catch (err) {
+            return null;
+        }
+    }
+
+    var available = {};
+    API_METHODS.forEach(function (name) { available[name] = !!findFn(name); });
+    var ready = REQUIRED.every(function (name) { return available[name]; });
+
+    if (!ready) {
+        var missing = API_METHODS.filter(function (n) { return !available[n]; });
+        // 只打印一次，便于主进程/证据审计 console 无报错
+        console.warn(
+            '[VStudio] window.utilityAPI.vstudio* 未就绪，进入示例数据模式（仅本地演示，不写磁盘）。' +
+            '缺失方法: ' + missing.slice(0, 6).join(', ') + (missing.length > 6 ? ' …' : '')
+        );
+    }
+
+    /** 统一调用。永不 reject，永远返回 {success,data|error}。 */
+    async function invoke(name) {
+        var args = Array.prototype.slice.call(arguments, 1);
+        var fn = findFn(name);
+        if (!fn) {
+            return { success: false, error: '后端未就绪：' + name + ' 未注册' };
+        }
+        try {
+            var res = await fn.apply(null, args);
+            if (res && typeof res === 'object' && ('success' in res)) return res;
+            if (res && typeof res === 'object' && ('data' in res) && !('error' in res)) {
+                return { success: true, data: res.data };
+            }
+            return { success: true, data: res };
+        } catch (err) {
+            var msg = (err && (err.message || err.toString())) || '未知错误';
+            console.error('[VStudio] ' + name + ' 调用失败：', msg);
+            return { success: false, error: msg };
+        }
+    }
+
+    /** 磁盘路径 / 相对路径 → 可直接给 <img>/<video> 的 URL。主进程返回的 file:// 原样使用。 */
+    function resolveMediaUrl(raw) {
+        if (!raw) return '';
+        var s = String(raw);
+        if (/^(file|https?|data|blob):/i.test(s)) return s;
+        s = s.replace(/\\/g, '/');
+        if (s.charAt(0) === '/') return 'file://' + encodeURI(s);
+        return s;
+    }
+
+    function cacheBust(url) {
+        if (!url) return '';
+        return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'v=' + Date.now();
+    }
+
+    /** 订阅主进程变更推送；返回取消订阅函数（无后端时为空函数）。 */
+    function onChanged(cb) {
+        var fn = findFn('onVstudioChanged');
+        if (!fn) return function () {};
+        try {
+            var off = fn(function (payload) {
+                try { cb(payload || {}); } catch (err) { console.error('[VStudio] onVstudioChanged 回调异常', err); }
+            });
+            return typeof off === 'function' ? off : function () {};
+        } catch (err) {
+            console.warn('[VStudio] 订阅 onVstudioChanged 失败：', err && err.message);
+            return function () {};
+        }
+    }
+
+    // ─────────────────────────── 示例数据（无后端时可看可点） ───────────────────────────
