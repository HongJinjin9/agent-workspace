+    function bindStage() {
+        var media = $('#stage-media');
+        if (!media) return;
+
+        media.addEventListener('pointerdown', function (e) {
+            if (!state.annotateMode || !state.project) return;
+            if (e.button !== 0) return;
+            if (e.target.closest('.ann-pin, .ann-region-box, #ann-form, .stage-hint')) return;
+            var rect = media.getBoundingClientRect();
+            if (!rect.width || !rect.height) return;
+            if (state.playing) setPlayState(false);
+            var start = {
+                x: clamp((e.clientX - rect.left) / rect.width, 0, 1),
+                y: clamp((e.clientY - rect.top) / rect.height, 0, 1)
+            };
+            state.drag = { start: start, current: start, rect: rect, moved: false };
+            try { media.setPointerCapture(e.pointerId); } catch (err) {}
+            setDraftRect({ x: start.x, y: start.y, w: 0, h: 0, point: true });
+            e.preventDefault();
+        });
+
+        media.addEventListener('pointermove', function (e) {
+            if (!state.drag) return;
+            var r = state.drag.rect;
+            var cur = {
+                x: clamp((e.clientX - r.left) / r.width, 0, 1),
+                y: clamp((e.clientY - r.top) / r.height, 0, 1)
+            };
+            state.drag.current = cur;
+            if (Math.abs(cur.x - state.drag.start.x) > 0.008 || Math.abs(cur.y - state.drag.start.y) > 0.008) state.drag.moved = true;
+            if (state.drag.moved) {
+                var x = Math.min(state.drag.start.x, cur.x);
+                var y = Math.min(state.drag.start.y, cur.y);
+                setDraftRect({ x: x, y: y, w: Math.abs(cur.x - state.drag.start.x), h: Math.abs(cur.y - state.drag.start.y), point: false });
+            }
+        });
+
+        function endDrag(e) {
+            if (!state.drag) return;
+            var drag = state.drag;
+            state.drag = null;
+            try { media.releasePointerCapture(e.pointerId); } catch (err) {}
+            var draft;
+            if (drag.moved) {
+                var x = Math.min(drag.start.x, drag.current.x);
+                var y = Math.min(drag.start.y, drag.current.y);
+                draft = { x: x, y: y, w: Math.abs(drag.current.x - drag.start.x), h: Math.abs(drag.current.y - drag.start.y), point: false };
+            } else {
+                draft = { x: drag.start.x, y: drag.start.y, w: 0, h: 0, point: true };
+            }
+            openAnnForm(draft);
+        }
+        media.addEventListener('pointerup', endDrag);
+        media.addEventListener('pointercancel', function (e) {
+            if (state.drag) {
+                state.drag = null;
+                setDraftRect(null);
+            }
+            try { media.releasePointerCapture(e.pointerId); } catch (err) {}
+        });
+
+        var layer = $('#annotation-layer');
+        if (layer) {
+            layer.addEventListener('click', function (e) {
