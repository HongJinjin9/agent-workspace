+        if (maxEnd > duration) duration = maxEnd;
+
+        var rendered = summary.rendered;
+        return {
+            id: summary.id,
+            name: summary.name,
+            createdAt: raw.createdAt || null,
+            updatedAt: summary.updatedAt,
+            width: summary.width,
+            height: summary.height,
+            fps: fps,
+            duration: duration,
+            status: raw.status || 'draft',
+            scenes: scenes,
+            audio: { tracks: tracks },
+            annotations: anns,
+            rendered: rendered
+        };
+    }
+
+    function normalizeAsset(raw, index) {
+        if (!raw) return null;
+        var name = raw.name || (raw.path ? String(raw.path).split(/[\\/]/).pop() : '素材-' + index);
+        var rawPath = raw.absolutePath || raw.path || raw.sourcePath || raw.file || '';
+        if (!rawPath && raw.url && /^file:/i.test(raw.url)) {
+            try { rawPath = decodeURIComponent(raw.url.replace(/^file:\/\//i, '')); } catch (e) { rawPath = raw.url; }
+        }
+        return {
+            name: name,
+            path: rawPath || raw.url || '',
+            url: raw.url || raw.srcUrl || '',
+            kind: kindOfAsset(raw),
+            size: num(raw.size, 0) || 0
+        };
+    }
+
+    // ────────────────────────────── 预览占位画面（示例模式） ──────────────────────────────
+    var demoPosterCache = {};
+
+    function palettes() {
+        return [
+            { sky1: '#0a141b', sky2: '#20343f', glow: 'rgba(242,169,0,0.55)', accent: '#f2a900', tint: '#76bfae' },
+            { sky1: '#150f1c', sky2: '#33223d', glow: 'rgba(198,132,255,0.45)', accent: '#c98cff', tint: '#f2a900' },
+            { sky1: '#0a1512', sky2: '#1d352d', glow: 'rgba(118,191,174,0.45)', accent: '#76bfae', tint: '#f2a900' }
+        ];
+    }
+
+    function paintFrame(canvas, project, frame, compact) {
+        if (!canvas || !canvas.getContext) return;
+        var ctx = canvas.getContext('2d');
+        if (!ctx) return;
+        var w = canvas.width;
+        var h = canvas.height;
+        var seed = hashStr((project && project.id) || 'vstudio');
+        var pal = palettes()[seed % palettes().length];
+        var rnd = function () {
+            seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+            return seed / 0x7fffffff;
+        };
+
+        ctx.clearRect(0, 0, w, h);
+
+        // 夜空渐变
+        var sky = ctx.createLinearGradient(0, 0, 0, h);
+        sky.addColorStop(0, pal.sky1);
+        sky.addColorStop(0.55, pal.sky2);
+        sky.addColorStop(1, '#05080a');
+        ctx.fillStyle = sky;
+        ctx.fillRect(0, 0, w, h);
+
+        // 光晕
+        var glow = ctx.createRadialGradient(w * 0.7, h * 0.34, h * 0.02, w * 0.7, h * 0.34, h * 0.6);
+        glow.addColorStop(0, pal.glow);
+        glow.addColorStop(1, 'rgba(0,0,0,0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, w, h);
+
+        // 星点
+        var starCount = compact ? 18 : 42;
+        for (var i = 0; i < starCount; i++) {
+            var sx = rnd() * w;
+            var sy = rnd() * h * 0.5;
+            var sr = rnd() * (compact ? 1.2 : 1.8) + 0.4;
+            ctx.fillStyle = 'rgba(242,240,233,' + (0.16 + rnd() * 0.5).toFixed(2) + ')';
+            ctx.beginPath();
+            ctx.arc(sx, sy, sr, 0, Math.PI * 2);
+            ctx.fill();
+        }
+
+        // 天际线剪影 + 窗灯
+        var horizon = h * (compact ? 0.62 : 0.58);
+        var x = 0;
+        var buildings = [];
+        while (x < w) {
+            var bw = w * (0.035 + rnd() * 0.06);
+            var bh = h * (0.1 + rnd() * 0.30);
+            buildings.push({ x: x, w: bw, h: bh });
+            ctx.fillStyle = 'rgba(8, 13, 17, 0.94)';
+            ctx.fillRect(x, horizon - bh, bw, bh + h * 0.08);
+            // 窗灯
+            var cols = Math.max(1, Math.floor(bw / (compact ? 9 : 14)));
+            var rows = Math.max(1, Math.floor(bh / (compact ? 12 : 18)));
+            for (var c = 0; c < cols; c++) {
+                for (var r = 0; r < rows; r++) {
+                    if (rnd() < 0.62) continue;
+                    ctx.fillStyle = rnd() < 0.7
+                        ? 'rgba(242,169,0,' + (0.18 + rnd() * 0.5).toFixed(2) + ')'
+                        : 'rgba(118,191,174,' + (0.16 + rnd() * 0.35).toFixed(2) + ')';
+                    ctx.fillRect(
+                        x + (c + 0.25) * (bw / cols),
+                        horizon - bh + (r + 0.25) * (bh / rows),
+                        Math.max(1.5, bw / cols * 0.32),
+                        Math.max(1.5, bh / rows * 0.3)
+                    );
+                }
+            }
+            x += bw + w * 0.006;
+        }
+
+        // 地面反光
+        var ground = ctx.createLinearGradient(0, horizon, 0, h);
+        ground.addColorStop(0, 'rgba(20, 32, 38, 0.9)');
+        ground.addColorStop(1, 'rgba(4, 7, 9, 1)');
+        ctx.fillStyle = ground;
+        ctx.fillRect(0, horizon, w, h - horizon);
+        var reflCount = compact ? 8 : 20;
+        for (var k = 0; k < reflCount; k++) {
+            var rx = rnd() * w;
+            var ry = horizon + rnd() * (h - horizon) * 0.7;
+            var rw = w * (0.02 + rnd() * 0.14);
+            ctx.fillStyle = rnd() < 0.6
+                ? 'rgba(242,169,0,' + (0.03 + rnd() * 0.08).toFixed(3) + ')'
+                : 'rgba(118,191,174,' + (0.03 + rnd() * 0.06).toFixed(3) + ')';
+            ctx.fillRect(rx, ry, rw, 1.5);
+        }
+
+        if (!compact) {
+            // 移动车灯（随当前帧前进，示例模式里让播放可见）
+            var ratio = 0;
+            if (project && project.duration) ratio = ((frame || 0) / (project.fps || 30)) / project.duration;
+            ratio = clamp(ratio, 0, 1);
+            var lightX = w * (0.05 + ratio * 0.9);
+            var lightY = h * 0.72;
+            var trail = ctx.createLinearGradient(lightX - w * 0.18, 0, lightX, 0);
+            trail.addColorStop(0, 'rgba(242,169,0,0)');
+            trail.addColorStop(1, 'rgba(242,169,0,0.55)');
+            ctx.fillStyle = trail;
+            ctx.fillRect(lightX - w * 0.18, lightY, w * 0.18, 2.2);
+            ctx.fillStyle = 'rgba(255, 215, 130, 0.95)';
+            ctx.fillRect(lightX, lightY - 1.5, 5, 5.2);
+
+            // 顶部标签
+            ctx.font = '500 20px "Segoe UI", "Microsoft YaHei", sans-serif';
+            ctx.fillStyle = 'rgba(242, 240, 233, 0.72)';
+            ctx.fillText('V视听 · 示例画面', w * 0.045, h * 0.09);
+            ctx.fillStyle = 'rgba(242, 169, 0, 0.92)';
+            ctx.font = '600 14px "Segoe UI", "Microsoft YaHei", sans-serif';
+            ctx.fillText('DEMO PREVIEW', w * 0.045, h * 0.135);
+
+            // 标题
+            var title = (project && project.name) || 'V视听 工程';
+            var titleMain = title.split('·')[0].trim();
+            ctx.textAlign = 'center';
+            ctx.fillStyle = 'rgba(0,0,0,0.35)';
+            ctx.font = '700 66px "Segoe UI", "Microsoft YaHei", sans-serif';
+            ctx.fillText(titleMain, w / 2 + 3, h * 0.46 + 3);
+            ctx.fillStyle = 'rgba(242, 240, 233, 0.96)';
+            ctx.fillText(titleMain, w / 2, h * 0.46);
+            ctx.font = '400 22px "Segoe UI", "Microsoft YaHei", sans-serif';
+            ctx.fillStyle = 'rgba(167, 175, 177, 0.95)';
+            ctx.fillText('尚未渲染 · AI 制作完成后可逐帧播放与批注', w / 2, h * 0.535);
+            ctx.textAlign = 'left';
+
+            // 右上时间码
+            var tc = fmtTimecode(frame || 0, (project && project.fps) || 30);
+            ctx.font = '500 18px "Cascadia Code", Consolas, monospace';
+            ctx.fillStyle = 'rgba(242, 169, 0, 0.9)';
+            ctx.textAlign = 'right';
+            ctx.fillText(tc, w * 0.955, h * 0.09);
+            ctx.textAlign = 'left';
+
+            // 底部进度条
+            ctx.fillStyle = 'rgba(255,255,255,0.1)';
+            ctx.fillRect(w * 0.045, h * 0.925, w * 0.91, 3);
+            ctx.fillStyle = pal.accent;
+            ctx.fillRect(w * 0.045, h * 0.925, w * 0.91 * ratio, 3);
+            ctx.font = '400 15px "Segoe UI", "Microsoft YaHei", sans-serif';
+            ctx.fillStyle = 'rgba(167, 175, 177, 0.8)';
+            ctx.fillText('示例数据 · 操作仅本地演示', w * 0.045, h * 0.975);
+            ctx.textAlign = 'right';
+            ctx.fillText((project ? project.width + '×' + project.height + ' · ' + project.fps + 'fps' : ''), w * 0.955, h * 0.975);
+            ctx.textAlign = 'left';
+
+            // 暗角
+            var vig = ctx.createRadialGradient(w / 2, h / 2, h * 0.35, w / 2, h / 2, h * 0.95);
+            vig.addColorStop(0, 'rgba(0,0,0,0)');
+            vig.addColorStop(1, 'rgba(0,0,0,0.5)');
+            ctx.fillStyle = vig;
+            ctx.fillRect(0, 0, w, h);
+        } else {
+            ctx.fillStyle = 'rgba(242, 169, 0, 0.85)';
+            ctx.fillRect(0, h * 0.5, w * 0.18, 2);
+        }
+    }
+
+    function demoPosterUrl(project) {
+        if (!project || !project.id) return '';
+        if (demoPosterCache[project.id]) return demoPosterCache[project.id];
+        try {
+            var c = document.createElement('canvas');
+            c.width = 480;
+            c.height = 270;
+            paintFrame(c, project, 0, true);
+            var url = c.toDataURL('image/png');
+            demoPosterCache[project.id] = url;
+            return url;
+        } catch (err) {
+            return '';
+        }
+    }
