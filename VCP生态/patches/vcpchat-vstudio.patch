+}
+.toast.success { border-color: rgba(118, 191, 174, 0.55); }
+.toast.warn { border-color: rgba(242, 169, 0, 0.55); }
+.toast.error { border-color: rgba(224, 108, 95, 0.6); }
+.toast-dot { flex: 0 0 7px; width: 7px; height: 7px; margin-top: 4px; border-radius: 50%; background: var(--vs-sub); }
+.toast.success .toast-dot { background: var(--vs-teal); }
+.toast.warn .toast-dot { background: var(--vs-amber); }
+.toast.error .toast-dot { background: var(--vs-danger); }
+.toast.leaving { opacity: 0; transform: translateY(6px); transition: opacity 0.3s ease, transform 0.3s ease; }
+
+@keyframes vs-spin { to { transform: rotate(360deg); } }
+@keyframes vs-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
+@keyframes vs-toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
+
+/* 窄窗口兜底：保持 1440×900 完整，最小 1100 宽时压缩侧栏 */
+@media (max-width: 1280px) {
+    .app-main { grid-template-columns: 236px minmax(0, 1fr) 300px; }
