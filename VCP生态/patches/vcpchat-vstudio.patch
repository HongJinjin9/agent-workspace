+'use strict';
+
+// V视听（VStudio）视频协同工坊：工程/场景/批注/素材的读写、渲染、选择媒体文件，
+// 以及把批注指令「交给 AI」（主进程填入主窗口聊天输入框）。
+// 主进程：modules/ipc/vstudioHandlers.js（直接 require VCPToolBox 插件核心，见该文件头注释）
+// 渲染端：VStudioModules/（子窗口用 utility 角色 preload）
+const { invoke, on } = require('../core/define');
+
+module.exports = {
+    handlers: ['modules/ipc/vstudioHandlers.js'],
+    roles: ['utility', 'chat'],
+    api: {
+        // —— 工程 ——
+        vstudioListProjects: invoke('vstudio:list-projects'),
+        vstudioGetProject: invoke('vstudio:get-project', 'projectId'),
+        vstudioCreateProject: invoke('vstudio:create-project', 'payload'),
+        vstudioUpdateProject: invoke('vstudio:update-project', 'projectId', 'patch'),
+        vstudioSaveProject: invoke('vstudio:save-project', 'project'),
+
+        // —— 批注 ——
+        vstudioAddAnnotation: invoke('vstudio:add-annotation', 'projectId', 'annotation'),
+        vstudioUpdateAnnotation: invoke('vstudio:update-annotation', 'projectId', 'annotationId', 'patch'),
+        vstudioDeleteAnnotation: invoke('vstudio:delete-annotation', 'projectId', 'annotationId'),
+
+        // —— 素材与媒体 ——
+        vstudioListAssets: invoke('vstudio:list-assets', 'projectId'),
+        vstudioImportAsset: invoke('vstudio:import-asset', 'projectId', 'payload'),
+        vstudioPickMedia: invoke('vstudio:pick-media', 'options'),
+
+        // —— 渲染 ——
+        vstudioRender: invoke('vstudio:render', 'projectId'),
+        vstudioRenderStatus: invoke('vstudio:render-status', 'projectId'),
+
+        // —— 交给 AI / 工程目录 ——
+        vstudioSendToAgent: invoke('vstudio:send-to-agent', 'projectId', 'text', 'context'),
+        vstudioOpenProjectDir: invoke('vstudio:open-project-dir', 'projectId'),
+
+        // 主进程在每次写操作后广播，VStudio 窗口据此刷新工程列表/画布
+        onVstudioChanged: on('vstudio:changed'),
+    },
+};
