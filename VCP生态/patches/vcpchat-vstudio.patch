+/*
+ * V视听 —— DAW 风格多轨时间线（独立模块）
+ *
+ * 对外接口：
+ *   window.VStudioTimeline.init({ onSeek, onSelectAnnotation, onVolumeChange })
+ *   window.VStudioTimeline.render(project)   // 场景 / 音轨 / 批注 marker 全量重绘
+ *   window.VStudioTimeline.setFrame(frame)   // 仅移动播放头 + 高亮 marker
+ *   window.VStudioTimeline.clear()           // 无工程时的空态
+ *   window.VStudioTimeline.getTotalFrames()
+ *
+ * 时间线横轴按工程时长铺满轨道宽度（不横向滚动、不溢出）；缩放靠窗口宽度自适应。
+ */
+(function () {
+    'use strict';
+
+    var TARGET_LABEL = { frame: '内容', element: '元素', layout: '布局' };
+    var TYPE_META = {
+        title: { glyph: 'T', label: '标题卡' },
+        image: { glyph: '▣', label: '图片' },
+        video: { glyph: '▶', label: '视频' },
+        color: { glyph: '■', label: '纯色' }
+    };
+    var KIND_META = {
+        voice: { glyph: '◍', label: '旁白' },
+        bgm: { glyph: '♪', label: 'BGM' },
+        sfx: { glyph: '✳', label: '音效' }
+    };
+
+    var opts = {};
+    var project = null;
+    var fps = 30;
+    var duration = 1;
+    var totalFrames = 1;
+    var lastFrame = 0;
+    var inited = false;
+
+    function $(sel) { return document.querySelector(sel); }
+
+    function esc(s) {
+        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
+            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+    }
+
+    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
+
+    function fmtClock(sec) {
+        sec = Math.max(0, sec || 0);
+        var m = Math.floor(sec / 60);
+        var s = Math.floor(sec % 60);
+        var cs = Math.floor((sec - Math.floor(sec)) * 100);
+        return pad2(m) + ':' + pad2(s) + '.' + pad2(cs);
+    }
+
+    function fmtTC(frame) {
+        frame = Math.max(0, Math.round(frame || 0));
+        var total = frame / fps;
+        var h = Math.floor(total / 3600);
+        var m = Math.floor((total % 3600) / 60);
+        var s = Math.floor(total % 60);
+        var f = Math.floor(frame % fps);
+        return pad2(h) + ':' + pad2(m) + ':' + pad2(s) + ':' + pad2(f);
+    }
+
+    function pct(v) { return (Math.max(0, Math.min(1, v)) * 100).toFixed(4) + '%'; }
+
+    function hashStr(s) {
+        var h = 2166136261;
+        s = String(s || '');
+        for (var i = 0; i < s.length; i++) {
+            h ^= s.charCodeAt(i);
+            h = Math.imul(h, 16777619);
+        }
+        return Math.abs(h);
+    }
+
+    function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
+
+    /** 场景/音轨的绝对时间归一化（后端 start 可能缺省，按 order 累计） */
+    function sceneSpans(p) {
+        var list = (p.scenes || []).slice().sort(function (a, b) { return (a.order || 0) - (b.order || 0); });
+        var cursor = 0;
+        return list.map(function (s, i) {
+            var start = Number(s.start);
+            if (!isFinite(start)) start = cursor;
+            var dur = Number(s.duration);
+            if (!isFinite(dur) || dur <= 0) dur = 3;
+            cursor = Math.max(cursor, start + dur);
+            return { scene: s, start: start, duration: dur, index: i };
+        });
+    }
+
+    function renderTicks() {
+        var ticks = $('#tl-ticks');
+        if (!ticks) return;
+        var candidates = [0.5, 1, 2, 5, 10, 15, 30, 60, 120];
+        var step = candidates[candidates.length - 1];
+        for (var i = 0; i < candidates.length; i++) {
+            if (duration / candidates[i] <= 12) { step = candidates[i]; break; }
+        }
+        var html = [];
+        var minor = step / 4;
+        for (var t = 0; t <= duration + 1e-6; t += minor) {
+            var isMajor = Math.abs(t / step - Math.round(t / step)) < 1e-6;
+            var left = pct(t / duration);
+            if (isMajor) {
+                var label = t >= 60
+                    ? Math.floor(t / 60) + ':' + pad2(Math.round(t % 60))
+                    : (Math.round(t * 10) / 10) + 's';
+                html.push('<span class="tl-tick major" style="left:' + left + '"><b>' + label + '</b></span>');
+            } else {
+                html.push('<span class="tl-tick minor" style="left:' + left + '"></span>');
+            }
+        }
+        html.push('<span class="tl-tick major end" style="left:100%"><b>' + fmtClock(duration) + '</b></span>');
+        ticks.innerHTML = html.join('');
+    }
+
+    function waveformBars(trackId) {
+        var seed = hashStr(trackId || 'wave');
+        var count = 56;
+        var bars = [];
+        for (var i = 0; i < count; i++) {
+            seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+            var ratio = 0.18 + ((seed >> 7) % 1000) / 1000 * 0.82;
+            bars.push('<span style="height:' + (ratio * 100).toFixed(1) + '%"></span>');
+        }
+        return bars.join('');
+    }
+
+    function sceneThumb(span, p) {
+        var s = span.scene;
+        var meta = TYPE_META[s.type] || TYPE_META.image;
+        var thumb = null;
+        if (s.type === 'image' && (s.srcUrl || s.src)) {
+            var rawSrc = s.srcUrl || s.src;
+            var url = window.VStudioApi && window.VStudioApi.resolveMediaUrl ? window.VStudioApi.resolveMediaUrl(rawSrc) : '';
+            if (/^(file|data|https?|blob):/i.test(url)) thumb = url;
+        } else if (s.type === 'video' && p.rendered && p.rendered.posterUrl) {
+            thumb = p.rendered.posterUrl;
+        }
+        var style = thumb ? ' style="background-image:url(' + encodeURI(thumb).replace(/"/g, '%22') + ')"' : '';
+        return '<span class="clip-thumb tone-' + (span.index % 4) + '"' + style + '>' +
+            (thumb ? '' : '<i>' + meta.glyph + '</i>') + '</span>';
+    }
+
+    function renderRows() {
+        var rows = $('#tl-rows');
+        if (!rows) return;
+        if (!project) { rows.innerHTML = '<div class="tl-empty">选择工程后显示场景 / 音轨 / 批注轨道</div>'; return; }
+
+        var spans = sceneSpans(project);
+        var html = [];
+
+        // ① 视频场景行
+        html.push('<div class="tl-row scene-row">');
+        html.push('<div class="tl-row-label"><span class="row-icon">▤</span><span class="row-name">视频场景</span><span class="row-meta">' + spans.length + '</span></div>');
+        html.push('<div class="tl-lane" data-lane="scene">');
+        if (!spans.length) {
+            html.push('<span class="lane-empty">暂无场景 · 从素材库加入，或交给 AI 生成</span>');
+        }
+        spans.forEach(function (span) {
+            var s = span.scene;
+            var left = pct(span.start / duration);
+            var width = pct(Math.min(span.duration, Math.max(0.05, duration - span.start)) / duration);
+            var meta = TYPE_META[s.type] || TYPE_META.image;
+            var title = s.title || meta.label || '场景';
+            var tip = title + ' · ' + fmtClock(span.start) + ' – ' + fmtClock(span.start + span.duration) + ' · ' + meta.label;
+            html.push(
+                '<button type="button" class="scene-clip type-' + esc(s.type || 'image') + '" data-scene-id="' + esc(s.id) + '"' +
+                ' data-start="' + span.start.toFixed(3) + '" style="left:' + left + ';width:' + width + '" title="' + esc(tip) + '">' +
+                sceneThumb(span, project) +
+                '<span class="clip-copy"><b>' + esc(title) + '</b><small>' + fmtClock(span.start) + ' – ' + fmtClock(span.start + span.duration) + '</small></span>' +
+                '</button>'
+            );
+        });
+        html.push('</div></div>');
+
+        // ② 音频轨行（旁白 / BGM / SFX …）
+        var tracks = (project.audio && project.audio.tracks) || [];
+        if (!tracks.length) {
+            html.push('<div class="tl-row audio-row">');
+            html.push('<div class="tl-row-label"><span class="row-icon">♪</span><span class="row-name">音频轨</span></div>');
+            html.push('<div class="tl-lane" data-lane="audio"><span class="lane-empty">暂无音轨 · 导入素材后可加入旁白 / BGM / 音效</span></div>');
+            html.push('</div>');
+        }
+        tracks.forEach(function (track) {
+            var km = KIND_META[track.kind] || KIND_META.bgm;
+            var start = clamp(Number(track.start) || 0, 0, duration);
+            var dur = Number(track.duration);
+            if (!isFinite(dur) || dur <= 0) dur = Math.max(0.5, duration - start);
+            dur = Math.min(dur, Math.max(0.2, duration - start));
+            var vol = isFinite(Number(track.volume)) ? clamp(Number(track.volume), 0, 1) : 0.6;
+            html.push('<div class="tl-row audio-row" data-track-id="' + esc(track.id) + '">');
+            html.push('<div class="tl-row-label"><span class="row-icon kind-' + esc(track.kind || 'bgm') + '">' + km.glyph + '</span>' +
+                '<span class="row-name">' + esc(track.name || km.label) + '</span>' +
+                '<input type="range" class="vol-slider" min="0" max="100" step="1" value="' + Math.round(vol * 100) + '"' +
+                ' data-track-id="' + esc(track.id) + '" title="音量 ' + Math.round(vol * 100) + '%" aria-label="' + esc((track.name || km.label) + ' 音量') + '"></div>');
+            html.push('<div class="tl-lane" data-lane="audio" data-track-id="' + esc(track.id) + '">');
+            html.push(
+                '<div class="audio-clip kind-' + esc(track.kind || 'bgm') + '" data-track-id="' + esc(track.id) + '" data-start="' + start.toFixed(3) + '"' +
+                ' style="left:' + pct(start / duration) + ';width:' + pct(dur / duration) + '" title="' + esc((track.name || km.label) + ' · ' + fmtClock(start) + ' – ' + fmtClock(start + dur) + ' · 音量 ' + Math.round(vol * 100) + '%') + '">' +
+                '<span class="waveform" aria-hidden="true">' + waveformBars(track.id || track.name) + '</span>' +
+                '<span class="audio-clip-name">' + esc(track.name || km.label) + '</span>' +
+                '<span class="audio-clip-vol mono">' + Math.round(vol * 100) + '%</span>' +
+                '</div>'
+            );
+            html.push('</div></div>');
+        });
+
+        // ③ 批注 marker 轨
+        html.push('<div class="tl-row ann-row">');
+        html.push('<div class="tl-row-label"><span class="row-icon">◈</span><span class="row-name">批注</span><span class="row-meta">' + ((project.annotations || []).length) + '</span></div>');
+        html.push('<div class="tl-lane" data-lane="ann">');
+        if (!(project.annotations || []).length) {
+            html.push('<span class="lane-empty">暂无批注 marker</span>');
+        } else {
+            project.annotations.slice().sort(function (a, b) { return a.frame - b.frame; }).forEach(function (ann, i) {
+                var left = pct(clamp(ann.frame, 0, totalFrames) / totalFrames);
+                html.push('<button type="button" class="tl-ann-pin target-' + esc(ann.target) + ' status-' + esc(ann.status) + '"' +
+                    ' data-ann-id="' + esc(ann.id) + '" style="left:' + left + '"' +
+                    ' title="帧 ' + ann.frame + ' · ' + fmtTC(ann.frame) + ' · ' + (TARGET_LABEL[ann.target] || '内容') + ' · ' + esc(ann.text || '') + '">' +
+                    '<span>' + (i + 1) + '</span></button>');
+            });
+        }
+        html.push('</div></div>');
+
+        rows.innerHTML = html.join('');
+    }
+
+    function renderMarkers() {
+        var wrap = $('#tl-markers');
+        if (!wrap) return;
+        if (!project || !(project.annotations || []).length) { wrap.innerHTML = ''; return; }
+        var html = [];
+        project.annotations.slice().sort(function (a, b) { return a.frame - b.frame; }).forEach(function (ann, i) {
+            var left = pct(clamp(ann.frame, 0, totalFrames) / totalFrames);
+            html.push('<button type="button" class="ruler-marker target-' + esc(ann.target) + ' status-' + esc(ann.status) + '"' +
+                ' data-ann-id="' + esc(ann.id) + '" style="left:' + left + '"' +
+                ' title="帧 ' + ann.frame + ' · ' + fmtTC(ann.frame) + ' · ' + esc(ann.text || '') + '" aria-label="批注 ' + (i + 1) + '">' +
+                '<span>' + (i + 1) + '</span></button>');
+        });
+        wrap.innerHTML = html.join('');
+    }
+
+    function updateHead() {
+        var head = $('#tl-playhead');
+        if (!head) return;
+        if (!project) { head.hidden = true; return; }
+        head.hidden = false;
+        var ratio = totalFrames > 1 ? lastFrame / totalFrames : 0;
+        head.style.setProperty('--ph', clamp(ratio, 0, 1).toFixed(5));
+        head.setAttribute('data-frame', String(lastFrame));
+    }
+
+    function highlight(frame) {
+        lastFrame = frame;
+        updateHead();
+        var rows = $('#tl-rows');
+        if (rows) rows.querySelectorAll('.tl-ann-pin').forEach(function (el) {
+            el.classList.toggle('current', Math.abs(Number(el.dataset.frame || -1) - frame) <= 2);
+        });
+    }
+
+    function frameFromEvent(e, laneEl) {
+        var rect = laneEl.getBoundingClientRect();
+        if (!rect.width) return 0;
+        var ratio = clamp((e.clientX - rect.left) / rect.width, 0, 1);
+        return Math.round(ratio * totalFrames);
+    }
+
+    function laneElementFor(target) {
+        var el = target && target.closest ? target.closest('.tl-lane, .tl-ruler') : null;
+        return el || null;
+    }
+
+    function bindOnce() {
+        if (inited) return;
+        inited = true;
+        var ruler = $('#tl-ruler');
+        var rows = $('#tl-rows');
+
+        // 标尺 / 轨道空白处拖动定位
+        function attachScrub(container) {
+            if (!container) return;
+            var scrubbing = false;
+            container.addEventListener('pointerdown', function (e) {
+                if (e.button !== 0) return;
+                var lane = laneElementFor(e.target);
+                if (!lane) return;
+                if (e.target.closest('button.scene-clip, button.tl-ann-pin, .ruler-marker, .audio-clip, .vol-slider')) return;
+                if (!project) return;
+                scrubbing = true;
+                try { container.setPointerCapture(e.pointerId); } catch (err) {}
+                var f = frameFromEvent(e, lane);
+                if (opts.onSeek) opts.onSeek(f);
+                e.preventDefault();
+            });
+            container.addEventListener('pointermove', function (e) {
+                if (!scrubbing || !project) return;
+                var lane = laneElementFor(e.target) || container.querySelector('.tl-lane');
+                if (!lane) return;
+                if (opts.onSeek) opts.onSeek(frameFromEvent(e, lane));
+            });
+            function end(e) {
+                if (!scrubbing) return;
+                scrubbing = false;
+                try { container.releasePointerCapture(e.pointerId); } catch (err) {}
+            }
+            container.addEventListener('pointerup', end);
+            container.addEventListener('pointercancel', end);
+        }
+        attachScrub(ruler);
+        attachScrub(rows);
+
+        // 点击轨道内的 clip / marker
+        if (rows) {
+            rows.addEventListener('click', function (e) {
+                var annPin = e.target.closest('.tl-ann-pin');
+                if (annPin) {
+                    if (opts.onSelectAnnotation) opts.onSelectAnnotation(annPin.dataset.annId, true);
+                    return;
+                }
+                var sceneClip = e.target.closest('.scene-clip');
+                if (sceneClip) {
+                    if (opts.onSeek) opts.onSeek(Math.round((Number(sceneClip.dataset.start) || 0) * fps));
+                    return;
+                }
+                var audioClip = e.target.closest('.audio-clip');
+                if (audioClip) {
+                    if (opts.onSeek) opts.onSeek(Math.round((Number(audioClip.dataset.start) || 0) * fps));
+                }
+            });
+            // 音量滑杆
+            rows.addEventListener('input', function (e) {
+                if (!e.target.classList.contains('vol-slider')) return;
+                var trackId = e.target.dataset.trackId;
+                var value = clamp(Number(e.target.value) / 100, 0, 1);
+                var row = e.target.closest('.audio-row');
+                if (row) {
+                    var volBadge = row.querySelector('.audio-clip-vol');
+                    if (volBadge) volBadge.textContent = Math.round(value * 100) + '%';
+                    e.target.title = '音量 ' + Math.round(value * 100) + '%';
+                }
+                if (opts.onVolumeChange) opts.onVolumeChange(trackId, value);
+            });
+        }
+
+        // 标尺上的 marker
+        var markers = $('#tl-markers');
+        if (markers) {
+            markers.addEventListener('click', function (e) {
+                var m = e.target.closest('.ruler-marker');
+                if (m && opts.onSelectAnnotation) opts.onSelectAnnotation(m.dataset.annId, true);
+            });
+        }
+    }
+
+    window.VStudioTimeline = {
+        init: function (o) {
+            opts = o || {};
+            bindOnce();
+            var ruler = $('#tl-ruler');
+            if (ruler) {
+                ruler.addEventListener('keydown', function (e) {
+                    if (!project) return;
+                    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
+                        var delta = (e.key === 'ArrowLeft' ? -1 : 1) * (e.shiftKey ? fps : 1);
+                        e.preventDefault();
+                        if (opts.onSeek) opts.onSeek(clamp(lastFrame + delta, 0, totalFrames - 1));
+                    }
+                });
+            }
+        },
+        render: function (p) {
+            project = p || null;
+            if (!project) { this.clear(); return; }
+            fps = Number(project.fps) || 30;
+            duration = Math.max(0.1, Number(project.duration) || 0.1);
+            totalFrames = Math.max(1, Math.round(duration * fps));
+            var meta = $('#timeline-duration');
+            if (meta) {
+                var m = Math.floor(duration / 60);
+                var s = Math.floor(duration % 60);
+                meta.textContent = pad2(m) + ':' + pad2(s) + ' · ' + totalFrames + ' 帧';
+            }
+            var tm = $('#timeline-meta');
+            if (tm) tm.textContent = ((project.scenes || []).length) + ' 场景 · ' + (((project.audio && project.audio.tracks) || []).length) + ' 音轨 · ' + ((project.annotations || []).length) + ' 批注';
+            renderTicks();
+            renderRows();
+            renderMarkers();
+            updateHead();
+        },
+        setFrame: function (frame) {
+            if (!project) return;
+            lastFrame = clamp(Math.round(frame || 0), 0, totalFrames);
+            updateHead();
+            var rows = $('#tl-rows');
+            if (rows) {
+                // 用 marker 的 left 百分比回算所在帧，高亮当前帧附近的批注 marker
+                rows.querySelectorAll('.tl-ann-pin').forEach(function (el) {
+                    var left = parseFloat(el.style.left) || 0;
+                    var annFrame = Math.round(left / 100 * totalFrames);
+                    el.classList.toggle('current', Math.abs(annFrame - lastFrame) <= 2);
+                });
+            }
+            var markers = $('#tl-markers');
+            if (markers) {
+                markers.querySelectorAll('.ruler-marker').forEach(function (el) {
+                    var left = parseFloat(el.style.left) || 0;
+                    var annFrame = Math.round(left / 100 * totalFrames);
+                    el.classList.toggle('current', Math.abs(annFrame - lastFrame) <= 2);
+                });
+            }
+            var ruler = $('#tl-ruler');
+            if (ruler) ruler.setAttribute('aria-valuenow', String(lastFrame));
+        },
+        getTotalFrames: function () { return totalFrames; },
+        getFrame: function () { return lastFrame; },
+        clear: function () {
+            project = null;
+            var rows = $('#tl-rows');
+            if (rows) rows.innerHTML = '<div class="tl-empty">选择工程后显示场景 / 音轨 / 批注轨道</div>';
+            var ticks = $('#tl-ticks');
+            if (ticks) ticks.innerHTML = '';
+            var markers = $('#tl-markers');
+            if (markers) markers.innerHTML = '';
+            var head = $('#tl-playhead');
+            if (head) head.hidden = true;
+            var meta = $('#timeline-duration');
+            if (meta) meta.textContent = '—';
+            var tm = $('#timeline-meta');
+            if (tm) tm.textContent = '场景 · 音轨 · 批注';
+        }
+    };
+})();
diff --git a/VStudioModules/vstudio.css b/VStudioModules/vstudio.css
