+    // ────────────────────────────── 渲染：工程列表 / 菜单 ──────────────────────────────
+    function projectedProjects() {
+        var keyword = ($('#project-search') && $('#project-search').value || '').trim().toLowerCase();
+        return state.projects.filter(function (p) {
