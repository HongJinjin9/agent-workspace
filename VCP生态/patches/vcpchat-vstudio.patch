+    // ────────────────────────────── 渲染：预览 ──────────────────────────────
+    function stageAspect() {
+        var p = state.project;
+        if (!p || !p.width || !p.height) return 16 / 9;
+        return p.width / p.height;
+    }
+
+    function fitStage() {
+        var stage = $('#stage');
+        var media = $('#stage-media');
+        if (!stage || !media) return;
+        var rect = stage.getBoundingClientRect();
+        var padX = 24;
+        var padY = 20;
+        var availW = Math.max(80, rect.width - padX);
+        var availH = Math.max(60, rect.height - padY);
+        var aspect = stageAspect();
+        var w = availW;
+        var h = w / aspect;
+        if (h > availH) { h = availH; w = h * aspect; }
+        media.style.width = Math.round(w) + 'px';
+        media.style.height = Math.round(h) + 'px';
+    }
