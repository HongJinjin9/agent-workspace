+    align-items: flex-start;
+    gap: 7px;
+    padding: 8px 11px;
+    border-radius: 9px;
+    border: 1px solid rgba(59, 68, 73, 0.95);
+    background: rgba(26, 31, 35, 0.975);
+    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.55);
+    color: var(--vs-text);
