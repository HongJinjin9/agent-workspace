+        state.render.active = true;
+        var tick = async function () {
+            if (!state.projectId || !state.render.active) return;
+            var res = await Api.renderStatus(state.projectId);
+            var data = res.success ? (res.data || {}) : {};
+            var status = normalizeRenderStatus(data.status || (data.rendered && data.rendered.status) || 'rendering');
+            var progress = num(data.progress, num(data.rendered && data.rendered.progress, 0)) || 0;
+            if (res.success && (status === 'ready' || status === 'error')) {
+                stopRenderPolling();
+                state.render = { status: status, progress: status === 'ready' ? 100 : progress, error: data.error || null, active: false };
+                renderRenderChip();
+                if (status === 'ready') {
+                    await refreshProject({ force: true, silent: true });
+                    state.videoKey = '';
