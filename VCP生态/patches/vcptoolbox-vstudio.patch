@@ -0,0 +1,2146 @@
+'use strict';
+
+/**
+ * VStudioCore.js —— VCP「V视听」视频工程共享核心
+ * =====================================================================
+ * 纯 Node.js 实现，零第三方依赖。可以被两类调用方共同使用：
+ *   1. VCPToolBox 同步插件 Plugin/VStudio/VStudio.js（stdio 工具协议）
+ *   2. VCPChat Electron 主进程直接 require（进程内调用，无子进程开销）
+ *
+ * 数据目录（VSTUDIO_HOME，默认 /app/VCPChat/AppData/VStudio）：
+ *   projects/<id>/project.json     工程描述
+ *   projects/<id>/assets/           素材（importAsset 拷贝进来的文件）
+ *   projects/<id>/renders/          成片 final.mp4 + 封面 poster.jpg
+ *   projects/<id>/work/             渲染中间产物（渲染结束后清理）
+ *
+ * 渲染实现要点（本机 ffmpeg 7.0.2 静态构建无 drawtext，但 libass 可用）：
+ *   - 所有文字（标题/副标题/overlay）通过 ASS 字幕 + `ass` 滤镜渲染（支持中文）
+ *   - image 场景用 zoompan 做 Ken Burns 缩放/平移
+ *   - video 场景裁剪/循环补时
+ *   - title/color 场景用 color / gradients lavfi 源做底色
+ *   - 场景 layout 归一化矩形用于画中画（PiP）
+ *   - 每个场景先渲染成统一分辨率/fps 的片段，再按 cut 分组：
+ *       cut 边界 -> concat demuxer -c copy
+ *       非 cut 边界 -> xfade 单次重编码
+ *   - 音频多轨 amix（voice/bgm/sfx，每轨 start/duration/volume/fadeIn/fadeOut）
+ *   - 输出 H.264 MP4 (+faststart) 与 poster.jpg
+ *   - 渲染期间 project.json 实时写 rendered.status='rendering' 与 progress
+ *   - 文件级渲染锁 .render.lock，防止同一工程并发渲染
+ */
+
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const { spawn } = require('child_process');
+
+const SCHEMA_VERSION = 1;
+const DEFAULT_HOME = '/app/VCPChat/AppData/VStudio';
+
+// ===========================================================================
+// 一、配置加载（config.env 只在环境变量未设置时兜底，不覆盖调用方）
+// ===========================================================================
+
+function loadEnvFile(filePath) {
+  try {
+    const text = fs.readFileSync(filePath, 'utf8');
+    for (const rawLine of text.split(/\r?\n/)) {
+      const line = rawLine.trim();
+      if (!line || line.startsWith('#')) continue;
+      const eq = line.indexOf('=');
+      if (eq <= 0) continue;
+      const key = line.slice(0, eq).trim();
+      let value = line.slice(eq + 1).trim();
+      if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
+        value = value.slice(1, -1);
+      }
+      if (process.env[key] === undefined && value !== '') process.env[key] = value;
+    }
+  } catch {
+    /* 没有 config.env 是正常情况 */
+  }
+}
+loadEnvFile(path.join(__dirname, 'config.env'));
+
+function firstExistingPath(candidates) {
+  for (const candidate of candidates) {
+    if (!candidate) continue;
+    try {
+      if (fs.existsSync(candidate)) return candidate;
+    } catch {
+      /* ignore */
+    }
+  }
+  return null;
+}
+
+function envNumber(name, fallback) {
+  const value = Number(process.env[name]);
+  return Number.isFinite(value) ? value : fallback;
+}
+
+const CONFIG = Object.freeze({
+  home: path.resolve(process.env.VSTUDIO_HOME || DEFAULT_HOME),
+  ffmpeg:
+    (process.env.FFMPEG_PATH && process.env.FFMPEG_PATH.trim()) ||
