+  const durationMatch = /Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)/.exec(text);
+  const duration = durationMatch
+    ? Number(durationMatch[1]) * 3600 + Number(durationMatch[2]) * 60 + Number(durationMatch[3])
+    : 0;
+  const videoLine = /Stream #\d+:\d+[^\n]*: Video: [^\n]*/.exec(text);
+  let width = 0;
+  let height = 0;
+  let fps = 0;
+  if (videoLine) {
+    const dimension = /(\d{2,5})x(\d{2,5})/.exec(videoLine[0]);
+    if (dimension) {
+      width = Number(dimension[1]);
+      height = Number(dimension[2]);
+    }
+    const fpsMatch = /([\d.]+)\s*fps/.exec(videoLine[0]);
+    if (fpsMatch) fps = Number(fpsMatch[1]);
+  }
+  return {
+    duration: round3(duration),
+    width,
+    height,
+    fps,
+    hasVideo: !!videoLine,
+    hasAudio: /Stream #\d+:\d+[^\n]*: Audio:/.test(text),
+  };
+}
+
+// ===========================================================================
+// 六、进程执行（ffmpeg / edge-tts 统一入口，带超时与并发槽位）
+// ===========================================================================
+
+const ffmpegSlots = { active: 0, waiting: [] };
+
+function acquireFfmpegSlot() {
+  if (ffmpegSlots.active < CONFIG.ffmpegConcurrency) {
+    ffmpegSlots.active += 1;
+    return Promise.resolve();
+  }
+  return new Promise((resolve) => ffmpegSlots.waiting.push(resolve));
+}
+
+function releaseFfmpegSlot() {
+  const next = ffmpegSlots.waiting.shift();
+  if (next) next();
+  else ffmpegSlots.active -= 1;
+}
+
+function runProcess(command, args, options = {}) {
+  return new Promise((resolve, reject) => {
+    let child;
+    try {
+      child = spawn(command, args, { stdio: ['ignore', 'pipe', 'pipe'] });
+    } catch (error) {
+      if (options.allowFail) return resolve({ code: -1, stdout: '', stderr: String(error && error.message) });
+      return reject(new Error(`${options.label || '命令'}启动失败：${error.message}`));
+    }
+    let stdout = '';
+    let stderr = '';
+    let settled = false;
+    const timeoutMs = num(options.timeoutMs, 120000);
+    const timer = setTimeout(() => {
+      if (settled) return;
+      settled = true;
+      try {
+        child.kill('SIGKILL');
+      } catch {
+        /* ignore */
+      }
+      const message = `${options.label || '命令'}超时（${timeoutMs}ms）`;
+      if (options.allowFail) resolve({ code: -1, stdout, stderr, timedOut: true });
+      else reject(new Error(message));
+    }, timeoutMs);
+    const onData = (chunk) => {
+      const text = String(chunk);
+      stdout += text;
+      if (stdout.length > 4_000_000) stdout = stdout.slice(-2_000_000);
+    };
+    const onErr = (chunk) => {
+      const text = String(chunk);
+      stderr += text;
+      if (stderr.length > 4_000_000) stderr = stderr.slice(-2_000_000);
+    };
+    if (child.stdout) child.stdout.on('data', onData);
+    if (child.stderr) child.stderr.on('data', onErr);
+    child.on('error', (error) => {
+      clearTimeout(timer);
+      if (settled) return;
+      settled = true;
+      if (options.allowFail) resolve({ code: -1, stdout, stderr: `${stderr}${error.message}` });
+      else reject(new Error(`${options.label || '命令'}启动失败：${error.message}`));
+    });
+    child.on('close', (code) => {
+      clearTimeout(timer);
+      if (settled) return;
+      settled = true;
+      if (code === 0 || options.allowFail) {
+        resolve({ code, stdout, stderr });
+      } else {
+        const tail = stderr.trim().split('\n').filter(Boolean).slice(-10).join('\n');
+        reject(new Error(`${options.label || '命令'}失败（退出码 ${code}）：${tail || '无错误输出'}`));
+      }
+    });
+  });
+}
+
+async function runFfmpeg(args, options = {}) {
+  await acquireFfmpegSlot();
+  try {
+    return await runProcess(CONFIG.ffmpeg, args, { label: options.label || 'ffmpeg', timeoutMs: options.timeoutMs, allowFail: options.allowFail });
+  } finally {
+    releaseFfmpegSlot();
+  }
+}
+
+// ===========================================================================
+// 七、工程 CRUD
+// ===========================================================================
+
+function summaryOf(project) {
+  return {
+    id: project.id,
+    name: project.name,
+    createdAt: project.createdAt,
+    updatedAt: project.updatedAt,
+    width: project.width,
+    height: project.height,
+    fps: project.fps,
+    duration: project.duration,
+    status: project.status,
+    sceneCount: project.scenes.length,
+    annotationCount: project.annotations.length,
+    openAnnotationCount: project.annotations.filter((item) => item.status !== 'resolved').length,
+    trackCount: project.audio.tracks.length,
+    rendered: project.rendered,
+  };
+}
+
+function listProjects() {
+  const root = projectsRoot();
+  if (!fs.existsSync(root)) return [];
+  const summaries = [];
+  for (const entry of fs.readdirSync(root, { withFileTypes: true })) {
+    if (!entry.isDirectory()) continue;
+    const file = path.join(root, entry.name, 'project.json');
+    if (!fs.existsSync(file)) continue;
+    try {
+      const raw = readJsonFile(file, null);
+      if (!raw || typeof raw !== 'object') continue;
+      summaries.push(summaryOf(normalizeProject(raw, { fromStorage: true })));
+    } catch {
+      /* 损坏的工程跳过，不影响列表 */
+    }
+  }
+  summaries.sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt)));
+  return summaries;
+}
+
+function getProject(id) {
+  const file = projectFile(id);
+  if (!fs.existsSync(file)) throw new Error(`工程不存在：${id}`);
+  let raw;
+  try {
+    raw = readJsonFile(file, null);
+  } catch (error) {
+    throw new Error(`工程数据损坏：${id}（${error.message}）`);
+  }
+  if (!raw || typeof raw !== 'object') throw new Error(`工程数据损坏：${id}`);
+  const project = normalizeProject(raw, { fromStorage: true });
+  // 上次渲染进程已退出但状态还停在 rendering：自动标记为 error，避免前端永久卡住
+  if (project.rendered.status === 'rendering' && !isRenderLockAlive(project.id)) {
+    project.rendered.status = 'error';
+    project.rendered.progress = 0;
+    project.rendered.error = '上次渲染被中断（渲染进程已退出）';
+    project.rendered.at = nowIso();
+    try {
+      writeJsonAtomic(file, project);
+    } catch {
+      /* ignore */
+    }
+  }
+  return project;
+}
+
+function createProject(payload = {}) {
+  if (payload === null || typeof payload !== 'object') throw new Error('创建工程失败：参数必须是对象');
+  const input = { ...payload };
+  if (!input.id) {
+    let candidate = uid('proj');
+    while (fs.existsSync(path.join(projectsRoot(), candidate))) candidate = uid('proj');
+    input.id = candidate;
+  }
+  input.createdAt = input.createdAt || nowIso();
+  input.updatedAt = nowIso();
+  const project = normalizeProject(input);
+  ensureProjectDirs(project.id);
+  writeJsonAtomic(projectFile(project.id), project);
+  return project;
+}
+
+function saveProject(project) {
+  if (!project || typeof project !== 'object') throw new Error('保存工程失败：工程数据无效');
+  if (!project.id) throw new Error('保存工程失败：缺少工程 ID');
+  // 整工程保存语义：scene.start 是「计算产物」而不是输入；只有显式携带 startOverride 才覆盖时间线。
+  // 这样前端把 getProject 的结果回传保存时，拖动重排 order 后时间线会自动重算，不会被旧 start 钉死。
+  const normalized = normalizeProject({ ...project, updatedAt: nowIso() }, { fromStorage: true });
+  ensureProjectDirs(normalized.id);
+  writeJsonAtomic(projectFile(normalized.id), normalized);
+  return normalized;
+}
+
+function updateProject(id, patch) {
+  const project = getProject(id);
+  if (!patch || typeof patch !== 'object') throw new Error('更新工程失败：patch 必须是对象');
+  const merged = { ...project };
+  if (patch.name !== undefined) merged.name = patch.name;
+  if (patch.width !== undefined) merged.width = patch.width;
+  if (patch.height !== undefined) merged.height = patch.height;
+  if (patch.fps !== undefined) merged.fps = patch.fps;
+  if (patch.scenes !== undefined) {
+    if (!Array.isArray(patch.scenes)) throw new Error('更新工程失败：scenes 必须是数组');
+    merged.scenes = patch.scenes;
+  }
+  if (patch.audio !== undefined) {
+    if (patch.audio && Array.isArray(patch.audio.tracks)) merged.audio = { ...project.audio, tracks: patch.audio.tracks };
+    else if (Array.isArray(patch.audio)) merged.audio = { tracks: patch.audio };
+  }
+  if (patch.annotations !== undefined) {
+    if (!Array.isArray(patch.annotations)) throw new Error('更新工程失败：annotations 必须是数组');
+    merged.annotations = patch.annotations;
+  }
+  if (patch.rendered !== undefined) {
+    // 只允许外部显式重置渲染状态（例如前端清除错误），渲染相关字段以服务端为准
+    merged.rendered = { ...project.rendered, ...(patch.rendered && typeof patch.rendered === 'object' ? patch.rendered : {}) };
+  }
+  return saveProject(merged);
+}
+
+function deleteProject(id) {
+  const dir = projectDir(id);
+  if (!fs.existsSync(dir)) throw new Error(`工程不存在：${id}`);
+  const lock = readRenderLock(id);
+  if (lock) throw new Error(`工程正在渲染中（进程 ${lock.pid}），无法删除`);
+  fs.rmSync(dir, { recursive: true, force: true });
+  return { id, deleted: true };
+}
+
+// ===========================================================================
+// 八、场景管理
+// ===========================================================================
+
+function addScene(id, scene) {
+  if (!scene || typeof scene !== 'object') throw new Error('新增场景失败：缺少场景数据');
+  const project = getProject(id);
+  const normalized = normalizeScene(scene, { fromStorage: false });
+  const ordered = [...project.scenes];
+  let insertAt = ordered.length;
+  if (scene.order !== undefined && scene.order !== null && Number.isFinite(Number(scene.order))) {
+    insertAt = clamp(Math.round(Number(scene.order)), 0, ordered.length);
+  }
+  if (ordered.some((item) => item.id === normalized.id)) normalized.id = uid('scene');
+  ordered.splice(insertAt, 0, normalized);
+  ordered.forEach((item, index) => {
+    item.order = index;
+  });
+  project.scenes = ordered;
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function updateScene(id, sceneId, patch) {
+  if (!sceneId) throw new Error('更新场景失败：缺少 sceneId');
+  if (!patch || typeof patch !== 'object') throw new Error('更新场景失败：patch 必须是对象');
+  const project = getProject(id);
+  const index = project.scenes.findIndex((item) => item.id === String(sceneId));
+  if (index < 0) throw new Error(`场景不存在：${sceneId}`);
+  const merged = { ...project.scenes[index], ...patch };
+  if (patch.start !== undefined) merged.startOverride = patch.start === null ? null : Math.max(0, num(patch.start, 0));
+  if (patch.startOverride !== undefined) merged.startOverride = patch.startOverride === null ? null : Math.max(0, num(patch.startOverride, 0));
+  project.scenes[index] = normalizeScene(merged, { fromStorage: false });
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function removeScene(id, sceneId) {
+  if (!sceneId) throw new Error('删除场景失败：缺少 sceneId');
+  const project = getProject(id);
+  const next = project.scenes.filter((item) => item.id !== String(sceneId));
+  if (next.length === project.scenes.length) throw new Error(`场景不存在：${sceneId}`);
+  next.forEach((item, index) => {
+    item.order = index;
+  });
+  project.scenes = next;
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function reorderScenes(id, order) {
+  if (!Array.isArray(order) || order.length === 0) throw new Error('重排场景失败：order 必须是非空数组');
+  const project = getProject(id);
+  const ids = project.scenes.map((item) => item.id);
+  const resolved = order.map((value) => (typeof value === 'number' ? ids[value] : String(value)));
+  if (resolved.some((value) => value === undefined)) throw new Error('重排场景失败：order 中存在无效的场景索引');
+  const unique = new Set(resolved);
+  if (resolved.length !== ids.length || unique.size !== ids.length || !ids.every((item) => unique.has(item))) {
+    throw new Error('重排场景失败：order 必须恰好包含全部场景 ID 且不能重复');
+  }
+  const map = new Map(project.scenes.map((item) => [item.id, item]));
+  project.scenes = resolved.map((sceneId, index) => ({ ...map.get(sceneId), order: index }));
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+// ===========================================================================
+// 九、音轨管理
+// ===========================================================================
+
+function addAudioTrack(id, track) {
+  if (!track || typeof track !== 'object') throw new Error('新增音轨失败：缺少音轨数据');
+  const project = getProject(id);
+  const normalized = normalizeTrack(track);
+  if (project.audio.tracks.some((item) => item.id === normalized.id)) normalized.id = uid('track');
+  project.audio.tracks.push(normalized);
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function updateAudioTrack(id, trackId, patch) {
+  if (!trackId) throw new Error('更新音轨失败：缺少 trackId');
+  if (!patch || typeof patch !== 'object') throw new Error('更新音轨失败：patch 必须是对象');
+  const project = getProject(id);
+  const index = project.audio.tracks.findIndex((item) => item.id === String(trackId));
+  if (index < 0) throw new Error(`音轨不存在：${trackId}`);
+  project.audio.tracks[index] = normalizeTrack({ ...project.audio.tracks[index], ...patch });
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function removeAudioTrack(id, trackId) {
+  if (!trackId) throw new Error('删除音轨失败：缺少 trackId');
+  const project = getProject(id);
+  const next = project.audio.tracks.filter((item) => item.id !== String(trackId));
+  if (next.length === project.audio.tracks.length) throw new Error(`音轨不存在：${trackId}`);
+  project.audio.tracks = next;
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+// ===========================================================================
+// 十、素材导入 / 列表
+// ===========================================================================
+
+function assetIndexFile(id) {
+  return path.join(assetsDir(id), '.index.json');
+}
+
+function updateAssetIndex(id, asset) {
+  try {
+    const index = readJsonFile(assetIndexFile(id), {}) || {};
+    index[asset.file] = asset;
+    writeJsonAtomic(assetIndexFile(id), index);
+  } catch {
+    /* 索引只是加速，失败可忽略 */
+  }
+}
+
+async function parseDataUrl(value) {
+  const match = /^data:([^;,]+)?(;base64)?,(.*)$/s.exec(String(value));
+  if (!match) throw new Error('导入素材失败：dataUrl 格式无效');
+  const mime = match[1] || 'application/octet-stream';
+  const data = match[2] ? Buffer.from(match[3], 'base64') : Buffer.from(decodeURIComponent(match[3]), 'utf8');
+  return { mime, buffer: data };
+}
+
+function extFromMime(mime) {
+  const map = {
+    'image/png': '.png',
+    'image/jpeg': '.jpg',
+    'image/webp': '.webp',
+    'video/mp4': '.mp4',
+    'video/quicktime': '.mov',
+    'audio/mpeg': '.mp3',
+    'audio/mp3': '.mp3',
+    'audio/wav': '.wav',
+    'audio/x-wav': '.wav',
+  };
+  return map[mime] || '';
+}
+
+async function importAsset(id, payload) {
+  if (!payload || typeof payload !== 'object') throw new Error('导入素材失败：payload 必须是对象');
+  getProject(id); // 校验工程存在
+  ensureDirSync(assetsDir(id));
+  const projectDirPath = projectDir(id);
+  const params = payload;
+  let fileName = params.name ? safeFileName(params.name) : '';
+  let buffer = null;
+  let mime = params.mime ? String(params.mime) : '';
+
+  const sourcePath = params.sourcePath || params.path || params.filePath;
+  if (sourcePath) {
+    const absolute = path.isAbsolute(String(sourcePath)) ? String(sourcePath) : path.resolve(projectDirPath, String(sourcePath));
+    if (!fs.existsSync(absolute)) throw new Error(`导入素材失败：源文件不存在 ${sourcePath}`);
+    const stat = fs.statSync(absolute);
+    if (!stat.isFile()) throw new Error(`导入素材失败：源路径不是文件 ${sourcePath}`);
+    buffer = fs.readFileSync(absolute);
+    if (!fileName) fileName = path.basename(absolute);
+    if (!mime) mime = mimeFromName(fileName);
+  } else if (params.dataUrl || (typeof params.url === 'string' && params.url.startsWith('data:'))) {
+    const parsed = await parseDataUrl(params.dataUrl || params.url);
+    buffer = parsed.buffer;
+    mime = mime || parsed.mime;
+  } else if (params.base64) {
+    buffer = Buffer.from(String(params.base64), 'base64');
+  } else if (params.url) {
+    const url = String(params.url);
+    if (!/^https?:\/\//i.test(url)) throw new Error('导入素材失败：url 只支持 http/https 或 data: URL');
+    let response;
+    try {
+      response = await fetch(url, { signal: AbortSignal.timeout(60000) });
+    } catch (error) {
+      throw new Error(`导入素材失败：下载 ${url} 失败（${error.message}）`);
+    }
+    if (!response.ok) throw new Error(`导入素材失败：下载 ${url} 返回 HTTP ${response.status}`);
+    buffer = Buffer.from(await response.arrayBuffer());
+    mime = mime || response.headers.get('content-type') || mimeFromName(url);
+    if (!fileName) {
+      try {
+        fileName = safeFileName(decodeURIComponent(new URL(url).pathname.split('/').pop() || 'asset'));
+      } catch {
+        fileName = 'asset';
+      }
+    }
+    if (!fileName) fileName = `asset-${Date.now()}${extFromMime(mime)}`;
+  } else if (params.content !== undefined) {
+    buffer = Buffer.from(String(params.content), 'utf8');
+    if (!fileName) fileName = `note-${Date.now()}.txt`;
+    mime = mime || 'text/plain';
+  } else {
+    throw new Error('导入素材失败：需要 sourcePath / url / dataUrl / base64 / content 之一');
+  }
+
+  if (!fileName) fileName = `asset-${Date.now()}${extFromMime(mime)}`;
+  fileName = uniqueFileName(assetsDir(id), safeFileName(fileName));
+  const absoluteOut = path.join(assetsDir(id), fileName);
+  fs.writeFileSync(absoluteOut, buffer);
+
+  let meta = { width: 0, height: 0, duration: 0, hasVideo: false, hasAudio: false };
+  try {
+    meta = await probeMedia(absoluteOut);
+  } catch {
+    /* 非媒体文件或探测失败：仍允许作为普通素材导入 */
+  }
+  const type = mediaTypeFromName(fileName);
+  const asset = {
+    name: fileName,
+    file: fileName,
+    src: `assets/${fileName}`,
+    path: `assets/${fileName}`,
+    absolutePath: absoluteOut,
+    type,
+    mime: mime || mimeFromName(fileName),
+    size: buffer.length,
+    width: meta.width || null,
+    height: meta.height || null,
+    duration: meta.duration ? round3(meta.duration) : null,
+    hasVideo: !!meta.hasVideo,
+    hasAudio: !!meta.hasAudio,
+    importedAt: nowIso(),
+  };
+  updateAssetIndex(id, asset);
+  return asset;
+}
+
+function listAssets(id) {
+  const dir = assetsDir(id);
+  if (!fs.existsSync(dir)) return [];
+  const index = readJsonFile(assetIndexFile(id), {}) || {};
+  return fs
+    .readdirSync(dir)
+    .filter((name) => !name.startsWith('.'))
+    .map((name) => {
+      const absolute = path.join(dir, name);
+      let stat = null;
+      try {
+        stat = fs.statSync(absolute);
+      } catch {
+        return null;
+      }
+      if (!stat.isFile()) return null;
+      const cached = index[name] || {};
+      return {
+        name,
+        file: name,
+        src: `assets/${name}`,
+        path: `assets/${name}`,
+        absolutePath: absolute,
+        type: mediaTypeFromName(name),
+        mime: cached.mime || mimeFromName(name),
+        size: stat.size,
+        width: cached.width || null,
+        height: cached.height || null,
+        duration: cached.duration || null,
+        importedAt: cached.importedAt || stat.mtime.toISOString(),
+        modifiedAt: stat.mtime.toISOString(),
+      };
+    })
+    .filter(Boolean)
+    .sort((a, b) => String(b.importedAt).localeCompare(String(a.importedAt)));
+}
+
+// ===========================================================================
+// 十一、批注
+// ===========================================================================
+
+function addAnnotation(id, annotation) {
+  if (!annotation || typeof annotation !== 'object') throw new Error('新增批注失败：缺少批注数据');
+  const project = getProject(id);
+  const normalized = normalizeAnnotation(annotation);
+  if (project.annotations.some((item) => item.id === normalized.id)) normalized.id = uid('ann');
+  project.annotations.push(normalized);
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function updateAnnotation(id, annotationId, patch) {
+  if (!annotationId) throw new Error('更新批注失败：缺少 annotationId');
+  if (!patch || typeof patch !== 'object') throw new Error('更新批注失败：patch 必须是对象');
+  const project = getProject(id);
+  const index = project.annotations.findIndex((item) => item.id === String(annotationId));
+  if (index < 0) throw new Error(`批注不存在：${annotationId}`);
+  const merged = { ...project.annotations[index], ...patch };
+  if (patch.status !== undefined) {
+    merged.status = patch.status;
+    merged.resolvedAt = patch.status === 'resolved' ? patch.resolvedAt || nowIso() : null;
+  }
+  project.annotations[index] = normalizeAnnotation(merged);
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+function removeAnnotation(id, annotationId) {
+  if (!annotationId) throw new Error('删除批注失败：缺少 annotationId');
+  const project = getProject(id);
+  const next = project.annotations.filter((item) => item.id !== String(annotationId));
+  if (next.length === project.annotations.length) throw new Error(`批注不存在：${annotationId}`);
+  project.annotations = next;
+  project.updatedAt = nowIso();
+  return saveProject(project);
+}
+
+// ===========================================================================
+// 十二、edge-tts 配音
+// ===========================================================================
+
+async function ttsVoiceover(id, options = {}) {
+  const project = getProject(id);
