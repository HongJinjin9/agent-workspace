+  const imagePath = path.join(MEDIA_DIR, 'smoke-image.png');
+  const videoPath = path.join(MEDIA_DIR, 'smoke-clip.mp4');
+  const audioPath = path.join(MEDIA_DIR, 'smoke-bgm.wav');
+  if (!fs.existsSync(imagePath)) {
+    runFfmpeg(['-f', 'lavfi', '-i', 'gradients=s=960x540:d=1:c0=0x1e3a8a:c1=0x7c3aed', '-frames:v', '1', imagePath], '生成测试图片');
+  }
+  if (!fs.existsSync(videoPath)) {
+    runFfmpeg(['-f', 'lavfi', '-i', 'testsrc2=s=640x360:d=2:r=30', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', videoPath], '生成测试视频');
+  }
+  if (!fs.existsSync(audioPath)) {
+    runFfmpeg(['-f', 'lavfi', '-i', 'sine=frequency=440:duration=3', '-c:a', 'pcm_s16le', audioPath], '生成测试音频');
+  }
+  step('准备测试素材');
+
