+  assert.equal(result.posterPath, 'renders/poster.jpg');
+  assert.ok(Math.abs(result.duration - current.duration) < 0.35, `成片时长 ${result.duration}s 应接近工程时长 ${current.duration}s`);
+  assert.ok(posterSize > 500, '封面应有效');
+  assert.match(absolutePoster, /poster\.jpg$/);
+
+  const probe = await core.probeMedia(absoluteVideo);
+  assert.equal(probe.hasVideo, true, '成片应包含视频流');
