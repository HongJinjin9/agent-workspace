+#!/usr/bin/env node
+/**
+ * VStudio 健壮性 / 安全 / 边界测试
+ * =====================================================================
+ * 覆盖：
+ *   1. 非法工程 ID / 目录穿越 / 越界媒体路径
+ *   2. 缺失场景素材的渲染错误（中文）
+ *   3. 损坏 project.json：getProject 报错、listProjects 跳过
+ *   4. 渲染锁：活锁拒绝并发、stale 锁自动失效
+ *   5. 中断的 rendering 状态自动修复为 error
+ *   6. saveProject 整工程保存时 timeline 按 order 重算（不被旧 start 钉死）
+ *   7. 缺失音轨素材 -> 渲染成功 + warnings（不中断成片）
+ *   8. 参数校验：reorderScenes / importAsset / ttsVoiceover / updateScene
+ *   9. project.json schema 关键字段齐全
+ *
+ * 运行：node test/robustness.mjs（默认 <30s）
+ */
+
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { execFileSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const require = createRequire(import.meta.url);
+const PLUGIN_DIR = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
+const TEST_ROOT = process.env.VSTUDIO_ROBUST_ROOT || '/tmp/vstudio-backend-test';
+const HOME = path.join(TEST_ROOT, 'robust-home');
+const FFMPEG = process.env.FFMPEG_PATH || '/home/admin/.local/bin/ffmpeg';
+
+process.env.VSTUDIO_HOME = HOME;
+const core = require(path.join(PLUGIN_DIR, 'VStudioCore.js'));
+
+let passed = 0;
+async function check(name, fn) {
+  try {
+    await fn();
+    passed += 1;
+    console.log(`✅ ${name}`);
+  } catch (error) {
+    console.error(`❌ ${name}`);
+    throw error;
+  }
+}
+
+function runFfmpeg(args) {
+  execFileSync(FFMPEG, ['-hide_banner', '-loglevel', 'error', '-y', ...args], { stdio: ['ignore', 'pipe', 'pipe'] });
+}
+
+async function main() {
+  fs.rmSync(HOME, { recursive: true, force: true });
+  const mediaDir = path.join(TEST_ROOT, 'robust-media');
+  fs.mkdirSync(mediaDir, { recursive: true });
+  const imagePath = path.join(mediaDir, 'r-image.png');
+  const audioPath = path.join(mediaDir, 'r-audio.wav');
+  if (!fs.existsSync(imagePath)) runFfmpeg(['-f', 'lavfi', '-i', 'gradients=s=640x360:d=1:c0=0x112233:c1=0x445566', '-frames:v', '1', imagePath]);
+  if (!fs.existsSync(audioPath)) runFfmpeg(['-f', 'lavfi', '-i', 'sine=frequency=330:duration=2', '-c:a', 'pcm_s16le', audioPath]);
+
+  // 通用小工程工厂
+  async function makeProject(name = '健壮性测试') {
+    const project = core.createProject({ name, width: 320, height: 180, fps: 25 });
+    const image = await core.importAsset(project.id, { sourcePath: imagePath });
+    return { id: project.id, image };
+  }
+
+  // 1. 非法 ID / 目录穿越
+  await check('非法工程 ID 抛中文错误', async () => {
+    await assert.rejects(async () => core.getProject('../etc/passwd'), /非法工程 ID/);
+    await assert.rejects(async () => core.getProject('bad id!'), /非法工程 ID/);
+    await assert.rejects(async () => core.getProject(''), /非法工程 ID/);
+  });
+
+  await check('resolveMediaPath 拒绝目录穿越与越界绝对路径', async () => {
+    const { id } = await makeProject('路径安全');
+    await assert.rejects(async () => core.resolveMediaPath(id, '../../etc/passwd'), /媒体路径越界/);
+    await assert.rejects(async () => core.resolveMediaPath(id, '/etc/passwd'), /媒体路径越界/);
+    await assert.rejects(async () => core.resolveMediaPath(id, ''), /媒体路径为空/);
+    const inside = core.resolveMediaPath(id, 'assets/a.png');
+    assert.ok(inside.startsWith(core.getProjectDir(id)));
+  });
+
+  // 2. 缺失素材渲染报错
+  await check('缺失场景素材渲染抛中文错误', async () => {
+    const { id } = await makeProject('缺素材');
+    core.addScene(id, { type: 'image', src: 'assets/not-exist.png', duration: 0.4 });
+    await assert.rejects(async () => core.render(id, { preset: 'ultrafast' }), /找不到图片素材/);
+    const project = core.getProject(id);
+    assert.equal(project.rendered.status, 'error');
+    assert.match(project.rendered.error, /找不到图片素材/);
+    assert.equal(core.renderStatus(id).running, false);
+  });
+
+  // 3. 损坏 project.json
+  await check('损坏的 project.json 不污染列表，getProject 抛中文错误', async () => {
+    const { id } = await makeProject('待损坏');
+    const file = path.join(core.getProjectDir(id), 'project.json');
+    fs.writeFileSync(file, '{ this is not json', 'utf8');
+    await assert.rejects(async () => core.getProject(id), /工程数据损坏/);
+    const list = core.listProjects();
+    assert.ok(!list.some((item) => item.id === id), '损坏工程不应出现在列表');
+    fs.rmSync(core.getProjectDir(id), { recursive: true, force: true });
+  });
+
+  // 4. 渲染锁
+  await check('活渲染锁拒绝并发渲染；stale 锁自动失效', async () => {
+    const { id } = await makeProject('渲染锁');
+    core.addScene(id, { type: 'color', color: '#123456', duration: 0.4 });
+    const lockFile = path.join(core.getProjectDir(id), '.render.lock');
+    // 先放一个「活锁」（当前进程 pid）——同进程第二次 render 也应被拒绝
+    fs.writeFileSync(lockFile, JSON.stringify({ pid: process.pid, at: Date.now(), host: 'test' }));
+    assert.equal(core.isRenderLockAlive(id), true);
+    await assert.rejects(async () => core.render(id, { preset: 'ultrafast' }), /正在渲染中/);
+    // 改成死进程 pid 的 stale 锁 -> 应当可以渲染成功
+    fs.writeFileSync(lockFile, JSON.stringify({ pid: 999999, at: Date.now(), host: 'test' }));
+    assert.equal(core.isRenderLockAlive(id), false);
+    const result = await core.render(id, { preset: 'ultrafast' });
+    assert.ok(fs.existsSync(result.absolutePath));
+    assert.equal(core.isRenderLockAlive(id), false, '渲染结束应释放锁');
+  });
+
+  // 5. 中断的 rendering 状态修复
+  await check('中断的 rendering 状态被自动修复为 error', async () => {
+    const { id } = await makeProject('中断修复');
+    const file = path.join(core.getProjectDir(id), 'project.json');
+    const project = JSON.parse(fs.readFileSync(file, 'utf8'));
+    project.rendered = { ...project.rendered, status: 'rendering', progress: 42, error: null };
+    fs.writeFileSync(file, JSON.stringify(project, null, 2), 'utf8');
+    const repaired = core.getProject(id);
+    assert.equal(repaired.rendered.status, 'error');
+    assert.equal(repaired.rendered.progress, 0);
+    assert.match(repaired.rendered.error, /中断/);
+    assert.equal(core.renderStatus(id).status, 'error');
+  });
+
+  // 6. saveProject 时 timeline 按 order 重算
