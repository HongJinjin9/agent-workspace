+
+async function renderXfadeGroup(group, outPath, project, options) {
+  const fps = project.fps;
+  const args = [];
+  group.forEach((item) => args.push('-i', item.file));
+  const chains = [];
+  group.forEach((item, index) => {
+    chains.push(`[${index}:v]fps=${fps},settb=AVTB,format=yuv420p[in${index}]`);
+  });
+  let previous = 'in0';
+  let cumulative = group[0].duration;
+  for (let index = 1; index < group.length; index += 1) {
+    const transition = group[index - 1].transOut || { type: 'fade', duration: 0.5 };
+    const transitionDuration = Math.max(0.04, Math.min(transition.duration || 0.5, group[index - 1].duration * 0.9, group[index].duration * 0.9));
+    const offset = Math.max(0, cumulative - transitionDuration);
+    const label = `vx${index}`;
+    const xfadeType = transition.type === 'slide' ? 'slideleft' : 'fade';
+    chains.push(
+      `[${previous}][in${index}]xfade=transition=${xfadeType}:duration=${round3(transitionDuration)}:offset=${round3(offset)}[${label}]`
+    );
+    previous = label;
+    cumulative = cumulative + group[index].duration - transitionDuration;
+  }
+  args.push(
+    '-filter_complex',
+    chains.join(';'),
+    '-map',
+    `[${previous}]`,
+    '-r',
+    String(fps),
+    '-c:v',
+    'libx264',
+    '-preset',
+    options.preset,
+    '-crf',
+    String(options.crf),
+    '-pix_fmt',
+    'yuv420p',
+    '-an',
+    '-movflags',
+    '+faststart',
+    '-y',
+    outPath
+  );
+  await runFfmpeg(args, { timeoutMs: options.timeoutMs, label: '渲染转场' });
+}
+
+async function mergeSceneSegments(project, segments, basePath, workPath, options) {
+  const warnings = [];
+  const items = [];
+  const scenes = project.scenes;
+  let previousEnd = 0;
+
+  for (let index = 0; index < scenes.length; index += 1) {
+    const scene = scenes[index];
+    const segment = segments[index];
+    if (scene.start > previousEnd + 0.02) {
+      const gapDuration = round3(scene.start - previousEnd);
+      const gapPath = path.join(workPath, `gap-${String(index).padStart(3, '0')}.mp4`);
+      await renderGapSegment(project, gapDuration, gapPath, options);
+      if (items.length > 0) items[items.length - 1].transOut = { type: 'cut', duration: 0 };
+      items.push({
+        file: gapPath,
+        frames: Math.max(1, Math.round(gapDuration * project.fps)),
+        duration: gapDuration,
+        transOut: { type: 'cut', duration: 0 },
+        isGap: true,
+      });
+      previousEnd = scene.start;
+    }
+    const end = scene.start + segment.duration;
+    const nextScene = scenes[index + 1];
+    let transOut = { type: 'cut', duration: 0 };
+    const effectiveTransition = scene.transition ? num(scene.transition.effectiveDuration, 0) : 0;
+    if (nextScene && scene.transition && scene.transition.type !== 'cut' && effectiveTransition > 0.001) {
+      const overlap = end - nextScene.start;
+      const nextSegment = segments[index + 1];
+      const transitionDuration = Math.min(
+        effectiveTransition,
+        Math.max(0, overlap),
+        segment.duration * 0.9,
+        nextSegment.duration * 0.9
+      );
+      if (transitionDuration > 0.02) transOut = { type: scene.transition.type, duration: round3(transitionDuration) };
+    }
+    items.push({ file: segment.file, frames: segment.frames, duration: segment.duration, transOut });
+    previousEnd = end;
+  }
+
+  // 按 cut 边界分组
+  const groups = [];
+  let currentGroup = [];
+  for (const item of items) {
+    currentGroup.push(item);
+    if (!item.transOut || item.transOut.type === 'cut' || item.transOut.duration <= 0.001) {
+      groups.push(currentGroup);
+      currentGroup = [];
+    }
+  }
+  if (currentGroup.length > 0) groups.push(currentGroup);
+
+  const groupFiles = [];
+  for (let index = 0; index < groups.length; index += 1) {
+    const group = groups[index];
+    const output = path.join(workPath, `group-${String(index).padStart(2, '0')}.mp4`);
+    if (group.length === 1) {
+      fs.copyFileSync(group[0].file, output);
+    } else {
+      await renderXfadeGroup(group, output, project, options);
+    }
+    groupFiles.push(output);
+  }
+  if (groupFiles.length === 0) throw new Error('渲染失败：没有可拼接的场景片段');
+  if (groupFiles.length === 1) {
+    fs.copyFileSync(groupFiles[0], basePath);
+  } else {
+    const listFile = path.join(workPath, 'concat.txt');
+    const lines = groupFiles.map((file) => `file '${String(file).replace(/'/g, "'\\''")}'`);
+    fs.writeFileSync(listFile, `${lines.join('\n')}\n`, 'utf8');
+    await runFfmpeg(['-y', '-f', 'concat', '-safe', '0', '-i', listFile, '-c', 'copy', '-movflags', '+faststart', basePath], {
+      timeoutMs: options.timeoutMs,
+      label: '拼接场景',
+    });
+  }
+  return { warnings, groups: groupFiles.length };
+}
+
+async function mixAudioTracks(project, totalDuration, outPath, options) {
+  const warnings = [];
+  const total = Math.max(0.2, round3(totalDuration));
+  const args = [];
+  const chains = [];
+  let trackCount = 0;
+  let inputIndex = 0;
+
+  for (const track of project.audio.tracks) {
+    if (!track.src || !String(track.src).trim()) {
+      warnings.push(`音轨「${track.name}」没有素材，已跳过`);
+      continue;
+    }
+    const start = clamp(num(track.start, 0), 0, total);
+    if (start >= total - 0.01) {
+      warnings.push(`音轨「${track.name}」起点超出成片时长，已跳过`);
+      continue;
+    }
+    let sourcePath;
+    try {
+      sourcePath = resolveMediaPath(project.id, track.src);
+    } catch (error) {
+      warnings.push(`音轨「${track.name}」路径无效，已跳过：${error.message}`);
+      continue;
+    }
+    if (!fs.existsSync(sourcePath)) {
+      warnings.push(`音轨「${track.name}」素材不存在，已跳过：${track.src}`);
+      continue;
+    }
+    // 防御：素材必须真的含音频流，否则 ffmpeg 会因 "Stream specifier ':a' matches no streams" 整体失败
+    let sourceProbe = null;
+    try {
+      sourceProbe = await probeMedia(sourcePath);
+    } catch {
+      sourceProbe = null;
+    }
+    if (sourceProbe && !sourceProbe.hasAudio) {
+      warnings.push(`音轨「${track.name}」素材不含音频流（${track.src}），已跳过`);
+      continue;
+    }
+    let duration = track.duration && track.duration > 0 ? track.duration : total - start;
+    duration = Math.min(duration, total - start);
+    if (duration <= 0.02) {
+      warnings.push(`音轨「${track.name}」有效时长过短，已跳过`);
+      continue;
+    }
+    const volume = clamp(num(track.volume, 1), 0, 4);
+    const fadeIn = clamp(num(track.fadeIn, 0), 0, duration);
+    const fadeOut = clamp(num(track.fadeOut, 0), 0, duration);
+    args.push('-i', sourcePath);
+    let chain = `[${inputIndex}:a]atrim=0:${round3(duration)},asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=${round3(volume)}`;
+    if (fadeIn > 0.001) chain += `,afade=t=in:st=0:d=${round3(fadeIn)}`;
+    if (fadeOut > 0.001) chain += `,afade=t=out:st=${round3(duration - fadeOut)}:d=${round3(fadeOut)}`;
+    chain += `,adelay=${Math.round(start * 1000)}|${Math.round(start * 1000)}[a${trackCount}]`;
+    chains.push(chain);
+    trackCount += 1;
+    inputIndex += 1;
+  }
+
+  if (trackCount === 0) {
+    warnings.push('工程没有可用音轨，成片将使用静音音轨');
+    args.push('-f', 'lavfi', '-i', 'anullsrc=r=48000:cl=stereo');
+    chains.push(`[0:a]atrim=0:${round3(total)},asetpts=PTS-STARTPTS,apad=whole_dur=${round3(total)}[mix]`);
+  } else if (trackCount === 1) {
+    chains.push(`[a0]apad=whole_dur=${round3(total)},alimiter=limit=0.95,aformat=sample_fmts=fltp:channel_layouts=stereo[mix]`);
+  } else {
+    const labels = Array.from({ length: trackCount }, (_, index) => `[a${index}]`).join('');
+    chains.push(
+      `${labels}amix=inputs=${trackCount}:normalize=0:duration=longest:dropout_transition=0,apad=whole_dur=${round3(total)},alimiter=limit=0.95,aformat=sample_fmts=fltp:channel_layouts=stereo[mix]`
+    );
+  }
+
+  args.push(
+    '-filter_complex',
+    chains.join(';'),
+    '-map',
+    '[mix]',
+    '-t',
+    String(round3(total)),
+    '-c:a',
+    'pcm_s16le',
+    '-y',
+    outPath
+  );
+  await runFfmpeg(args, { timeoutMs: options.timeoutMs, label: '混音' });
+  return { warnings, trackCount };
+}
+
+function renderLockFile(id) {
+  return path.join(projectDir(id), '.render.lock');
+}
+
+function readRenderLock(id) {
+  try {
+    const info = readJsonFile(renderLockFile(id), null);
+    if (!info || !info.pid) return null;
+    if (Date.now() - num(info.at, 0) > 6 * 3600 * 1000) return null;
+    if (!isProcessAlive(info.pid)) return null;
+    return info;
+  } catch {
+    return null;
+  }
+}
+
+function isRenderLockAlive(id) {
+  return !!readRenderLock(id);
+}
+
+function acquireRenderLock(id) {
+  ensureDirSync(projectDir(id));
+  const existing = readRenderLock(id);
+  if (existing) throw new Error(`该工程正在渲染中（进程 ${existing.pid}），请等待完成后再试`);
+  const file = renderLockFile(id);
+  const info = { pid: process.pid, at: Date.now(), host: os.hostname() };
+  fs.writeFileSync(file, JSON.stringify(info), 'utf8');
+  return { id, file, pid: process.pid };
+}
+
+function releaseRenderLock(lock) {
+  if (!lock) return;
+  try {
+    const info = readJsonFile(lock.file, null);
+    if (info && info.pid === lock.pid) fs.rmSync(lock.file, { force: true });
+  } catch {
+    /* ignore */
+  }
+}
+
+function persistProjectSnapshot(project) {
+  try {
+    writeJsonAtomic(projectFile(project.id), project);
+  } catch {
+    /* 进度写回失败不应中断渲染 */
+  }
+}
+
+async function renderProjectInternal(project, options, ctx) {
+  const id = project.id;
+  const workPath = workDir(id);
+  const rendersPath = rendersDir(id);
+  fs.rmSync(workPath, { recursive: true, force: true });
+  ensureDirSync(workPath);
+  ensureDirSync(rendersPath);
+  // 清理上次残留临时文件
+  for (const name of fs.readdirSync(rendersPath)) {
+    if (name.startsWith('.')) {
+      try {
+        fs.rmSync(path.join(rendersPath, name), { force: true });
+      } catch {
+        /* ignore */
+      }
+    }
+  }
+
+  const width = project.width;
+  const height = project.height;
+  const fps = project.fps;
+  const renderOptions = {
+    crf: clamp(num(options.crf, CONFIG.crf), 0, 51),
+    preset: options.preset ? String(options.preset) : CONFIG.x264Preset,
+    timeoutMs: clamp(num(options.timeoutMs, CONFIG.renderTimeoutMs), 10000, 24 * 3600 * 1000),
+  };
+  const sceneCount = project.scenes.length;
+  const segments = [];
+
+  await ctx.setProgress(2, '准备渲染');
+  for (let index = 0; index < sceneCount; index += 1) {
+    const scene = project.scenes[index];
+    const prefix = `scene-${String(index).padStart(3, '0')}`;
+    const segmentPath = path.join(workPath, `${prefix}.mp4`);
+    const assPath = path.join(workPath, `${prefix}.ass`);
+    const segment = await renderSceneSegment(project, scene, segmentPath, assPath, renderOptions);
+    segments.push(segment);
+    await ctx.setProgress(2 + ((index + 1) / sceneCount) * 58, `已渲染场景 ${index + 1}/${sceneCount}`);
+  }
+
+  const basePath = path.join(workPath, 'base.mp4');
+  const mergeResult = await mergeSceneSegments(project, segments, basePath, workPath, renderOptions);
+  ctx.warnings.push(...mergeResult.warnings);
+  await ctx.setProgress(64, '场景拼接/转场完成');
+
+  let baseMeta = { duration: 0 };
+  try {
+    baseMeta = await probeMedia(basePath);
+  } catch {
+    /* ignore */
+  }
+  const totalDuration = round3(baseMeta.duration || project.duration || 0.2);
+
+  const audioPath = path.join(workPath, 'mix.wav');
+  const audioResult = await mixAudioTracks(project, totalDuration, audioPath, renderOptions);
+  ctx.warnings.push(...audioResult.warnings);
+  await ctx.setProgress(82, '多轨混音完成');
+
+  const outputName = options.outputName ? safeFileName(String(options.outputName), 'final.mp4') : 'final.mp4';
+  const finalPath = path.join(rendersPath, outputName);
+  const finalTmp = path.join(rendersPath, `.${outputName}.tmp.mp4`);
+  const muxArgs = (trim) => {
+    const args = ['-y', '-i', basePath, '-i', audioPath, '-map', '0:v:0', '-map', '1:a:0', '-c:v', 'copy', '-c:a', 'aac', '-b:a', '192k', '-movflags', '+faststart'];
+    if (trim) args.push('-t', String(totalDuration));
+    args.push(finalTmp);
+    return args;
+  };
+  await runFfmpeg(muxArgs(true), { timeoutMs: renderOptions.timeoutMs, label: '封装成片' });
+  // 防御性校验：成片时长必须与预期一致，否则重试一次（无 -t）再兜底报错
+  let finalProbe = { duration: 0 };
+  try {
+    finalProbe = await probeMedia(finalTmp);
+  } catch {
+    /* ignore */
+  }
+  if (Math.abs((finalProbe.duration || 0) - totalDuration) > 0.5) {
+    ctx.warnings.push(`成片时长校验异常（期望 ${totalDuration}s，实际 ${finalProbe.duration}s），已重试封装`);
+    await runFfmpeg(muxArgs(false), { timeoutMs: renderOptions.timeoutMs, label: '封装成片（重试）' });
+    try {
+      finalProbe = await probeMedia(finalTmp);
+    } catch {
+      finalProbe = { duration: 0 };
+    }
+    if (Math.abs((finalProbe.duration || 0) - totalDuration) > 0.75) {
+      throw new Error(`渲染失败：成片时长异常（期望 ${totalDuration}s，实际 ${finalProbe.duration}s）`);
+    }
+  }
+  fs.renameSync(finalTmp, finalPath);
+  await ctx.setProgress(93, '生成封面');
+
+  const posterTime = clamp(num(options.posterTime, Math.min(1, totalDuration * 0.5)), 0, Math.max(0, totalDuration - 0.05));
+  const posterPath = path.join(rendersPath, 'poster.jpg');
+  const posterTmp = path.join(rendersPath, '.poster.tmp.jpg');
+  await runFfmpeg(
+    ['-y', '-ss', String(round3(posterTime)), '-i', finalPath, '-frames:v', '1', '-q:v', '2', '-update', '1', posterTmp],
+    { timeoutMs: renderOptions.timeoutMs, label: '生成封面' }
+  );
+  fs.renameSync(posterTmp, posterPath);
+
+  if (!options.keepWork) fs.rmSync(workPath, { recursive: true, force: true });
+
+  return {
+    duration: totalDuration,
+    finalPath,
+    finalRelative: `renders/${path.basename(finalPath)}`,
+    posterPath,
+    posterRelative: 'renders/poster.jpg',
+    width,
+    height,
+    fps,
+    sceneCount,
+    trackCount: audioResult.trackCount,
+    warnings: ctx.warnings,
+  };
+}
+
+/**
+ * 渲染工程成片（异步）。
+ * options: { crf, preset, timeoutMs, posterTime, outputName, keepWork }
+ * 返回 Promise<{ id, path, absolutePath, posterPath, posterAbsolutePath, duration, width, height, fps, warnings }>
+ */
+async function render(id, options = {}) {
+  if (options && typeof options !== 'object') throw new Error('渲染失败：options 必须是对象');
+  const initial = getProject(id);
+  if (!initial.scenes || initial.scenes.length === 0) throw new Error('工程中没有场景，无法渲染');
+  const lock = acquireRenderLock(id);
+  const project = getProject(id);
+
+  const ctx = {
+    warnings: [],
+    lastWriteAt: 0,
+    async setProgress(percent, message) {
+      project.rendered = {
+        ...project.rendered,
+        status: 'rendering',
+        progress: round3(clamp(percent, 0, 100)),
+        at: nowIso(),
+        error: null,
+      };
+      project.status = 'draft';
+      const now = Date.now();
+      if (now - ctx.lastWriteAt > 350 || percent >= 100) {
+        ctx.lastWriteAt = now;
+        persistProjectSnapshot(project);
+      }
+      if (message) ctx.lastMessage = message;
+    },
+  };
+
+  try {
+    await ctx.setProgress(1, '开始渲染');
+    persistProjectSnapshot(project);
+    const result = await renderProjectInternal(project, options || {}, ctx);
+
+    // 渲染期间前端可能修改了工程：以磁盘最新工程为准，仅写回渲染结果
+    let latest;
+    try {
+      latest = getProject(id);
+    } catch {
+      latest = project;
+    }
+    latest.rendered = normalizeRendered({
+      ...latest.rendered,
+      path: result.finalRelative,
+      posterPath: result.posterRelative,
+      status: 'ready',
+      progress: 100,
+      at: nowIso(),
+      error: null,
+      duration: result.duration,
+      absolutePath: result.finalPath,
+      posterAbsolutePath: result.posterPath,
+    });
+    latest.status = 'ready';
+    latest.updatedAt = nowIso();
+    writeJsonAtomic(projectFile(id), latest);
+
+    return {
+      id,
+      path: result.finalRelative,
+      absolutePath: result.finalPath,
+      posterPath: result.posterRelative,
+      posterAbsolutePath: result.posterPath,
+      videoUrl: toFileUrl(result.finalPath),
+      posterUrl: toFileUrl(result.posterPath),
+      duration: result.duration,
+      width: result.width,
+      height: result.height,
+      fps: result.fps,
+      sceneCount: result.sceneCount,
+      trackCount: result.trackCount,
+      warnings: result.warnings,
+    };
+  } catch (error) {
+    const message = error && error.message ? error.message : String(error);
+    try {
+      const latest = getProject(id);
+      latest.rendered = {
+        ...latest.rendered,
+        status: 'error',
+        progress: 0,
+        error: message,
+        at: nowIso(),
+      };
+      latest.status = 'draft';
+      writeJsonAtomic(projectFile(id), latest);
+    } catch {
+      /* ignore */
+    }
+    throw error instanceof Error ? error : new Error(message);
+  } finally {
+    releaseRenderLock(lock);
+  }
+}
+
+function renderStatus(id) {
+  const project = getProject(id); // 自动修复中断的 rendering 状态
+  return {
+    id: project.id,
+    status: project.rendered.status,
+    progress: project.rendered.progress,
+    path: project.rendered.path,
+    posterPath: project.rendered.posterPath,
+    at: project.rendered.at,
+    error: project.rendered.error,
+    duration: project.rendered.duration,
+    running: isRenderLockAlive(project.id),
+    statusLabel: project.status,
+  };
+}
+
+// ===========================================================================
+// 十五、导出（契约见 task/README；全部同步，render 返回 Promise）
+// ===========================================================================
+
+module.exports = {
+  // 工程
+  listProjects,
+  getProject,
+  createProject,
+  saveProject,
+  updateProject,
+  deleteProject,
+  // 场景
+  addScene,
+  updateScene,
+  removeScene,
+  reorderScenes,
+  // 音轨
+  addAudioTrack,
+  updateAudioTrack,
+  removeAudioTrack,
+  // 素材
+  importAsset,
+  listAssets,
+  // 批注
+  addAnnotation,
+  updateAnnotation,
+  removeAnnotation,
+  // 配音
+  ttsVoiceover,
+  // 渲染
+  render,
+  renderStatus,
+  resolveMediaPath,
+  // 辅助（非契约、供主进程/测试使用）
+  probeMedia,
+  getConfig,
+  homeDir,
+  getProjectDir: projectDir,
+  getAssetsDir: assetsDir,
+  getRendersDir: rendersDir,
+  normalizeProject,
+  isRenderLockAlive,
+  SCHEMA_VERSION,
+};
diff --git a/Plugin/VStudio/config.env.example b/Plugin/VStudio/config.env.example
