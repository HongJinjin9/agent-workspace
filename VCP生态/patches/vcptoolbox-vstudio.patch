+  const hasText = sceneTextBlocks(scene).length > 0;
+  if (hasText) {
+    chains.push(`[${baseLabel}]ass=filename=${fgQuote(assPath)}:fontsdir=${fgQuote(CONFIG.fontDir)},format=yuv420p[vout]`);
+  } else {
+    chains.push(`[${baseLabel}]format=yuv420p[vout]`);
+  }
