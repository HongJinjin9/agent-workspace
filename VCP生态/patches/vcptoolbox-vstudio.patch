+  args.push(
+    '-filter_complex',
+    chains.join(';'),
+    '-map',
+    '[vout]',
+    '-r',
+    String(fps),
+    '-frames:v',
+    String(frames),
+    '-c:v',
+    'libx264',
+    '-preset',
+    options.preset,
+    '-crf',
+    String(options.crf),
+    '-pix_fmt',
+    'yuv420p',
+    '-g',
+    String(Math.max(2, Math.round(fps * 2))),
+    '-an',
+    '-y',
+    outPath
+  );
+  return { args, frames, duration };
+}
+
+async function renderSceneSegment(project, scene, segmentPath, assPath, options) {
+  buildAssFile(project, scene, assPath);
+  const command = buildSceneRenderCommand(project, scene, segmentPath, assPath, options);
+  await runFfmpeg(command.args, { timeoutMs: options.timeoutMs, label: `渲染场景 ${scene.id}` });
