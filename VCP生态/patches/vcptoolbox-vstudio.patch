+ */
+function sceneTextBlocks(scene) {
+  const blocks = [];
+  if (scene.type === 'title') {
+    if (String(scene.title || '').trim()) blocks.push({ text: scene.title, kind: 'title', position: 'center' });
+    if (String(scene.subtitle || '').trim()) blocks.push({ text: scene.subtitle, kind: 'subtitle', position: 'center' });
+  } else {
+    if (String(scene.title || '').trim()) blocks.push({ text: scene.title, kind: 'title-any', position: 'top' });
+    if (String(scene.subtitle || '').trim()) blocks.push({ text: scene.subtitle, kind: 'subtitle-any', position: 'bottom' });
+  }
+  const overlays = Array.isArray(scene.overlay) ? scene.overlay : scene.overlay && String(scene.overlay.text || '').trim() ? [scene.overlay] : [];
+  overlays.forEach((overlay) => {
+    if (!overlay || !String(overlay.text || '').trim()) return;
+    blocks.push({ text: overlay.text, kind: 'overlay', position: overlay.position || 'bottom', style: overlay.style || {} });
+  });
