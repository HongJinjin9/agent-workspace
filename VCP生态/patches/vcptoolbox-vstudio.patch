+    return {
+      x: clamp(num(position.x, 0.5), 0, 1) * width,
+      y: clamp(num(position.y, 0.5), 0, 1) * height,
+      an: num(position.an, 5),
+    };
+  }
+  const key = String(position || '').toLowerCase();
+  if (kind === 'title') return { x: width / 2, y: height * 0.44, an: 5 };
+  if (kind === 'subtitle') return { x: width / 2, y: height * 0.6, an: 5 };
+  if (kind === 'title-any') return { x: width / 2, y: height * 0.1, an: 8 };
+  if (kind === 'subtitle-any') return { x: width / 2, y: height * 0.9, an: 2 };
+  switch (key) {
+    case 'top':
+      return { x: width / 2, y: height * 0.09, an: 8 };
+    case 'center':
+      return { x: width / 2, y: height * 0.5, an: 5 };
+    case 'bottom':
+      return { x: width / 2, y: height * 0.9, an: 2 };
+    case 'top-left':
+      return { x: width * 0.05, y: height * 0.07, an: 7 };
+    case 'top-right':
+      return { x: width * 0.95, y: height * 0.07, an: 9 };
+    case 'bottom-left':
+      return { x: width * 0.05, y: height * 0.93, an: 1 };
+    case 'bottom-right':
+      return { x: width * 0.95, y: height * 0.93, an: 3 };
