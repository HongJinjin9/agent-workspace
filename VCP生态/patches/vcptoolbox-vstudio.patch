+  console.log(`🎉 VStudio 冒烟测试通过（${totalSeconds}s，阈值 60s）`);
+  console.log(`工程目录: ${path.join(SMOKE_HOME, 'projects', id)}`);
+  console.log(`成片: ${absoluteVideo} (${videoSize} 字节, ${probe.duration}s)`);
+  console.log(`封面: ${absolutePoster} (${posterSize} 字节)`);
+  console.log(`警告: ${result.warnings.length ? result.warnings.join('; ') : '无'}`);
+  console.log('============================================');
+}
+
+main().catch((error) => {
+  console.error('\n❌ VStudio 冒烟测试失败：');
+  console.error(error && error.stack ? error.stack : String(error));
+  process.exit(1);
+});
