+      else if (block.kind === 'subtitle') fontSize = Math.max(14, Math.round(height * 0.042));
+      else if (block.kind === 'subtitle-any') fontSize = Math.max(12, Math.round(height * 0.036));
+      else fontSize = Math.max(12, Math.round(height * 0.036));
