+      chain += `,fps=${fps},trim=duration=${round3(duration)},setpts=PTS-STARTPTS`;
+    }
+    chains.push(`${chain}[content]`);
+    inputIndex += 1;
+    if (fullCanvas) {
+      baseLabel = 'content';
+    } else {
+      args.push(...backgroundInputArgs(scene, width, height, fps));
+      const backgroundIndex = inputIndex;
+      inputIndex += 1;
+      chains.push(`[${backgroundIndex}:v]format=yuv420p,setsar=1[bg]`);
+      chains.push(`[bg][content]overlay=x=${layout.x}:y=${layout.y}:shortest=0:format=auto[base]`);
+      baseLabel = 'base';
+    }
+  } else {
+    args.push(...backgroundInputArgs(scene, width, height, fps));
+    const backgroundIndex = inputIndex;
+    inputIndex += 1;
+    chains.push(`[${backgroundIndex}:v]format=yuv420p,setsar=1[base]`);
+    baseLabel = 'base';
+  }
