+    const { id, image } = await makeProject('时间线重算');
+    core.addScene(id, { type: 'color', color: '#111111', duration: 1 });
+    core.addScene(id, { type: 'image', src: image.src, duration: 1 });
+    core.addScene(id, { type: 'color', color: '#222222', duration: 1 });
+    const project = core.getProject(id);
+    assert.deepEqual(project.scenes.map((s) => s.start), [0, 1, 2]);
+    // 模拟前端拿到 getProject 结果后拖动：把第 3 个场景拖到最前，但没改旧 start
+    const reordered = {
+      ...project,
+      scenes: [project.scenes[2], project.scenes[0], project.scenes[1]].map((scene, index) => ({ ...scene, order: index })),
+    };
+    const saved = core.saveProject(reordered);
+    assert.equal(saved.scenes[0].id, project.scenes[2].id);
+    assert.deepEqual(saved.scenes.map((s) => s.start), [0, 1, 2], '重排后 start 应按新 order 重算');
+    assert.equal(saved.duration, 3);
+  });
+
+  // 7. 缺失音轨素材：渲染成功 + warning
+  await check('缺失音轨素材只产生 warning，不中断成片', async () => {
+    const { id, image } = await makeProject('缺失音轨');
+    core.addScene(id, { type: 'image', src: image.src, duration: 0.5 });
+    core.addAudioTrack(id, { name: '坏音轨', kind: 'bgm', src: 'assets/nope.mp3', start: 0 });
+    const result = await core.render(id, { preset: 'ultrafast' });
+    assert.ok(result.warnings.some((item) => item.includes('坏音轨')), `warnings: ${result.warnings.join('|')}`);
+    assert.ok(fs.existsSync(result.absolutePath));
+    const probe = await core.probeMedia(result.absolutePath);
+    assert.equal(probe.hasAudio, true, '即使没有可用音轨，成片也应有静音音轨');
+  });
+
+  // 8. 参数校验
+  await check('参数校验：reorderScenes/importAsset/ttsVoiceover/updateScene', async () => {
+    const { id } = await makeProject('参数校验');
+    core.addScene(id, { type: 'color', color: '#333333', duration: 0.5 });
+    core.addScene(id, { type: 'color', color: '#444444', duration: 0.5 });
+    const sceneId = core.getProject(id).scenes[0].id;
+    await assert.rejects(async () => core.reorderScenes(id, ['only-one']), /必须恰好包含全部场景/);
+    await assert.rejects(async () => core.reorderScenes(id, []), /非空数组/);
+    await assert.rejects(async () => core.importAsset(id, {}), /需要 sourcePath/);
+    await assert.rejects(async () => core.importAsset(id, { sourcePath: '/no/such/file.png' }), /源文件不存在/);
+    await assert.rejects(async () => core.ttsVoiceover(id, { text: '   ' }), /text 不能为空/);
+    await assert.rejects(async () => core.updateScene(id, 'no-such-scene', { duration: 1 }), /场景不存在/);
+    await assert.rejects(async () => core.updateAnnotation(id, 'no-such-ann', { text: 'x' }), /批注不存在/);
+    await assert.rejects(async () => core.removeAudioTrack(id, 'no-such-track'), /音轨不存在/);
+    // 合法 start 覆盖仍然生效
+    const overridden = core.updateScene(id, sceneId, { start: 5 });
+    assert.ok(Math.abs(overridden.scenes[0].start - 5) < 1e-6);
+    assert.equal(overridden.duration, 6);
+  });
+
+  // 9. schema 字段完整性
+  await check('project.json schemaVersion=1 且关键字段齐全', async () => {
+    const { id, image } = await makeProject('schema 校验');
+    core.addScene(id, { type: 'image', src: image.src, duration: 1, transition: { type: 'fade', duration: 0.2 } });
+    core.addAudioTrack(id, { name: 'BGM', kind: 'bgm', src: image.src, start: 0 });
+    core.addAnnotation(id, { time: 0.2, text: '批注' });
+    const project = core.getProject(id);
+    for (const key of ['schemaVersion', 'id', 'name', 'createdAt', 'updatedAt', 'width', 'height', 'fps', 'duration', 'scenes', 'audio', 'annotations', 'rendered', 'status']) {
+      assert.ok(Object.prototype.hasOwnProperty.call(project, key), `缺少字段 ${key}`);
+    }
+    assert.equal(project.schemaVersion, 1);
+    const scene = project.scenes[0];
+    for (const key of ['id', 'order', 'start', 'duration', 'type', 'src', 'title', 'subtitle', 'color', 'transition', 'motion', 'layout', 'overlay']) {
+      assert.ok(Object.prototype.hasOwnProperty.call(scene, key), `场景缺少字段 ${key}`);
+    }
+    for (const key of ['path', 'posterPath', 'status', 'progress', 'at', 'error']) {
+      assert.ok(Object.prototype.hasOwnProperty.call(project.rendered, key), `rendered 缺少字段 ${key}`);
+    }
+    const track = project.audio.tracks[0];
+    for (const key of ['id', 'name', 'kind', 'src', 'start', 'duration', 'volume', 'fadeIn', 'fadeOut']) {
+      assert.ok(Object.prototype.hasOwnProperty.call(track, key), `音轨缺少字段 ${key}`);
+    }
+    const ann = project.annotations[0];
+    for (const key of ['id', 'frame', 'time', 'region', 'target', 'text', 'author', 'status', 'createdAt', 'resolvedAt', 'reply']) {
+      assert.ok(Object.prototype.hasOwnProperty.call(ann, key), `批注缺少字段 ${key}`);
+    }
+  });
+
+  console.log(`\n🎉 VStudio 健壮性测试通过：${passed} 项（数据目录 ${HOME}）`);
+}
+
+main().catch((error) => {
+  console.error('\n❌ VStudio 健壮性测试失败：');
+  console.error(error && error.stack ? error.stack : String(error));
+  process.exit(1);
+});
