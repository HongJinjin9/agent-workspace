+#!/usr/bin/env node
+/**
+ * VStudio 冒烟测试（端到端）
+ * =====================================================================
+ * 覆盖：工程创建 → 素材导入 → 加场景（title/image/video/color）→ 转场 →
+ *      画中画 layout → ASS 中文字幕 / overlay → 多轨音频 → 批注全生命周期 →
+ *      场景重排/更新 → 渲染（320x180，总时长 <2s）→ 产物存在 → 渲染锁 →
+ *      project.json 渲染状态写回 → 插件 stdio 协议（VStudio.js）。
+ *
+ * 运行：node test/smoke.mjs
+ * 环境：默认 VSTUDIO_HOME=/tmp/vstudio-backend-test/smoke-home（可用环境变量覆盖）
+ * 要求：ffmpeg 可用（默认 /home/admin/.local/bin/ffmpeg，可用 FFMPEG_PATH 覆盖）
+ * 预期：<60s 内完成。
+ */
+
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { execFileSync, spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+
+const require = createRequire(import.meta.url);
+const PLUGIN_DIR = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
+const TEST_ROOT = process.env.VSTUDIO_SMOKE_ROOT || '/tmp/vstudio-backend-test';
+const SMOKE_HOME = process.env.VSTUDIO_HOME || path.join(TEST_ROOT, 'smoke-home');
+const MEDIA_DIR = path.join(TEST_ROOT, 'smoke-media');
+const FFMPEG = process.env.FFMPEG_PATH || '/home/admin/.local/bin/ffmpeg';
+
+process.env.VSTUDIO_HOME = SMOKE_HOME;
+const core = require(path.join(PLUGIN_DIR, 'VStudioCore.js'));
+
+const startedAt = Date.now();
+const steps = [];
+function step(name) {
+  const elapsed = ((Date.now() - startedAt) / 1000).toFixed(2);
+  steps.push({ name, elapsed });
+  console.log(`✅ [${elapsed}s] ${name}`);
+}
+
+function runFfmpeg(args, label) {
+  try {
+    execFileSync(FFMPEG, ['-hide_banner', '-loglevel', 'error', '-y', ...args], { stdio: ['ignore', 'pipe', 'pipe'] });
+  } catch (error) {
+    throw new Error(`${label} 失败：${error.stderr ? String(error.stderr).slice(-800) : error.message}`);
+  }
+}
+
+function assertMedia(file) {
+  assert.ok(fs.existsSync(file), `产物不存在：${file}`);
+  const size = fs.statSync(file).size;
+  assert.ok(size > 1024, `产物过小（${size} 字节）：${file}`);
+  return size;
+}
+
+async function main() {
+  // 0. 干净环境 + 测试素材
