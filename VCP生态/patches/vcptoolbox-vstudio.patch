@@ -0,0 +1,158 @@
+{
+  "manifestVersion": "1.0.0",
+  "name": "VStudio",
+  "displayName": "V「视听」视频工程",
+  "pluginType": "synchronous",
+  "version": "1.0.0",
+  "description": "V「视听」人机协同视频制作插件：管理视频工程（场景/多轨音频/批注），导入素材，edge-tts 中文配音，调用 ffmpeg 渲染 H.264 成片与封面。数据目录由 VSTUDIO_HOME 指定（默认 /app/VCPChat/AppData/VStudio）。",
+  "author": "VCPToolBox",
+  "license": "CC BY-NC-SA 4.0",
+  "entryPoint": {
+    "type": "nodejs",
+    "command": "node VStudio.js",
+    "timeout": 900000
+  },
+  "communication": {
+    "protocol": "stdio",
+    "timeout": 900000
+  },
+  "configSchema": {
+    "VSTUDIO_HOME": {
+      "type": "string",
+      "description": "VStudio 数据根目录（工程/素材/成片）。默认 /app/VCPChat/AppData/VStudio。",
+      "default": "/app/VCPChat/AppData/VStudio"
+    },
+    "FFMPEG_PATH": {
+      "type": "string",
+      "description": "ffmpeg 可执行文件路径（本机为 /home/admin/.local/bin/ffmpeg，静态构建，含 libass 但无 drawtext）。",
+      "default": "/home/admin/.local/bin/ffmpeg"
+    },
+    "EDGE_TTS_PATH": {
+      "type": "string",
+      "description": "edge-tts 可执行文件路径（默认 /home/admin/.local/bin/edge-tts）。",
+      "default": "/home/admin/.local/bin/edge-tts"
+    },
+    "VSTUDIO_FONTS_DIR": {
+      "type": "string",
+      "description": "libass 中文字体目录（默认 /home/admin/.fonts，内含 Noto Sans CJK SC）。",
+      "default": "/home/admin/.fonts"
+    },
+    "VSTUDIO_FONT_FAMILY": {
