+// ===========================================================================
+// 十三、ASS 字幕（中文文字渲染）
+// ===========================================================================
+
+function fgQuote(value) {
+  const text = String(value);
+  if (/^[A-Za-z0-9_./-]+$/.test(text)) return text;
+  return `'${text.replace(/\\/g, '\\\\').replace(/'/g, "'\\''")}'`;
+}
+
+function assTime(seconds) {
+  const total = Math.max(0, Number(seconds) || 0);
+  const hours = Math.floor(total / 3600);
+  const minutes = Math.floor((total % 3600) / 60);
+  const secs = Math.floor(total % 60);
+  const centis = Math.round((total - Math.floor(total)) * 100);
+  const clampedCenti = centis >= 100 ? 99 : centis;
+  return `${hours}:${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}.${String(clampedCenti).padStart(2, '0')}`;
+}
+
+function hexToAssColor(color, alpha = 0) {
+  let value = String(color === undefined || color === null ? '#FFFFFF' : color).trim();
+  value = value.replace(/^0x/i, '');
+  if (/^[0-9a-fA-F]{6}$/.test(value)) value = `#${value}`;
+  const match = /^#([0-9a-fA-F]{6})$/.exec(value);
+  if (!match) return '&H00FFFFFF';
+  const rr = match[1].slice(0, 2);
+  const gg = match[1].slice(2, 4);
+  const bb = match[1].slice(4, 6);
+  const aa = clamp(Math.round(Number(alpha) || 0), 0, 255).toString(16).padStart(2, '0');
+  return `&H${aa}${bb}${gg}${rr}`.toUpperCase();
+}
+
+function escapeAssText(text) {
+  return String(text === undefined || text === null ? '' : text)
