+  const text = options.text === null || options.text === undefined ? '' : String(options.text).trim();
+  if (!text) throw new Error('配音失败：text 不能为空');
+  if (text.length > 5000) throw new Error('配音失败：text 过长（最多 5000 字）');
+  const voice = options.voice ? String(options.voice) : 'zh-CN-XiaoxiaoNeural';
+  ensureDirSync(assetsDir(id));
+  const fileName = uniqueFileName(assetsDir(id), safeFileName(`tts-${Date.now()}.mp3`));
+  const absoluteOut = path.join(assetsDir(id), fileName);
+  const args = ['--voice', voice, '--text', text, '--write-media', absoluteOut, '--no-progress'];
+  if (options.rate) args.push('--rate', String(options.rate));
+  if (options.pitch) args.push('--pitch', String(options.pitch));
+  if (options.ttsVolume) args.push('--volume', String(options.ttsVolume));
+
+  const result = await runProcess(CONFIG.edgeTts, args, {
+    timeoutMs: CONFIG.ttsTimeoutMs,
+    allowFail: true,
+    label: 'edge-tts 配音',
+  });
+  if (result.code !== 0) {
+    const tail = (result.stderr || '').trim().split('\n').filter(Boolean).slice(-6).join('\n');
+    throw new Error(`配音失败：edge-tts 执行出错（退出码 ${result.code}）：${tail || '无错误输出'}`);
+  }
+  if (!fs.existsSync(absoluteOut) || fs.statSync(absoluteOut).size < 200) {
+    throw new Error('配音失败：edge-tts 未生成有效音频（可能网络不可用）');
+  }
+  let meta = { duration: 0 };
+  try {
+    meta = await probeMedia(absoluteOut);
+  } catch {
+    /* ignore */
+  }
+  const duration = round3(meta.duration || 0) || 1;
+  let start = 0;
+  if (options.sceneId) {
+    const scene = project.scenes.find((item) => item.id === String(options.sceneId));
+    if (!scene) throw new Error(`配音失败：场景不存在：${options.sceneId}`);
+    start = scene.start;
+  } else {
+    start = Math.max(0, num(options.start, 0));
+  }
+  const voiceCount = project.audio.tracks.filter((item) => item.kind === 'voice').length;
+  const track = normalizeTrack({
+    id: uid('track'),
+    name: options.trackName || `旁白 ${voiceCount + 1}`,
+    kind: 'voice',
+    src: `assets/${fileName}`,
+    start,
+    duration,
+    volume: num(options.volume, 1),
+    fadeIn: num(options.fadeIn, 0),
+    fadeOut: num(options.fadeOut, 0),
+  });
+  project.audio.tracks.push(track);
+  const saved = saveProject(project);
+  updateAssetIndex(id, {
+    name: fileName,
+    file: fileName,
+    src: `assets/${fileName}`,
+    type: 'audio',
+    mime: 'audio/mpeg',
+    size: fs.statSync(absoluteOut).size,
+    width: null,
+    height: null,
+    duration,
+    hasVideo: false,
+    hasAudio: true,
+    importedAt: nowIso(),
+  });
+  return { project: saved, track };
+}
