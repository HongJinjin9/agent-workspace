+
+async function renderGapSegment(project, gapDuration, outPath, options) {
+  const width = project.width;
+  const height = project.height;
+  const fps = project.fps;
+  const frames = Math.max(1, Math.round(gapDuration * fps));
+  const args = [
+    '-f',
+    'lavfi',
+    '-i',
+    `color=c=0x000000:s=${width}x${height}:r=${fps}`,
+    '-frames:v',
+    String(frames),
+    '-c:v',
+    'libx264',
+    '-preset',
+    options.preset,
+    '-crf',
+    String(options.crf),
+    '-pix_fmt',
+    'yuv420p',
+    '-g',
+    String(Math.max(2, Math.round(fps * 2))),
+    '-an',
+    '-y',
+    outPath,
+  ];
