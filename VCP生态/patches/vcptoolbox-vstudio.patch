+
+  // 2. 导入素材
+  const image = await core.importAsset(id, { sourcePath: imagePath });
+  const clip = await core.importAsset(id, { sourcePath: videoPath });
+  const bgm = await core.importAsset(id, { sourcePath: audioPath });
+  assert.equal(image.type, 'image');
+  assert.equal(clip.type, 'video');
+  assert.equal(bgm.type, 'audio');
+  assert.equal(image.width, 960);
+  assert.ok(image.src.startsWith('assets/'));
+  assert.ok(fs.existsSync(core.resolveMediaPath(id, image.src)), '素材副本未落盘');
+  const assets = core.listAssets(id);
+  assert.equal(assets.length, 3);
+  step(`导入素材 3 个（${assets.map((item) => item.type).join('/')}）`);
+
+  // 3. 加场景：title(image/video/color 齐全) + 转场 + 画中画 + overlay
+  core.addScene(id, {
+    type: 'title',
+    title: 'V视听 · 人机协同剪辑',
+    subtitle: 'VCP 视频工程 · 后端渲染',
+    duration: 0.6,
+    color: ['#0b1020', '#1e3a8a'],
+    transition: { type: 'fade', duration: 0.15 },
+  });
+  core.addScene(id, {
+    type: 'image',
+    src: image.src,
+    duration: 0.6,
+    motion: { type: 'zoom_in', zoomFrom: 1, zoomTo: 1.15 },
+    transition: { type: 'slide', duration: 0.15 },
+    overlay: { text: 'AI 批注：这里节奏再快一点', position: 'bottom', style: { box: true, fontSize: 12 } },
+  });
+  core.addScene(id, {
+    type: 'video',
+    src: clip.src,
+    duration: 0.6,
+    layout: { x: 0.58, y: 0.52, w: 0.38, h: 0.4 },
+    color: '#0b1020',
+    transition: { type: 'fade', duration: 0.15 },
+  });
+  core.addScene(id, {
+    type: 'color',
+    color: '#7c3aed',
+    duration: 0.6,
+    title: 'AI 生成字幕',
+    subtitle: '多轨混音 · xfade 转场',
+  });
+  let current = core.getProject(id);
+  assert.equal(current.scenes.length, 4);
+  assert.equal(current.scenes.filter((scene) => scene.type === 'image').length, 1);
+  assert.ok(current.scenes[0].transition.effectiveDuration > 0, 'fade 转场有效时长应 >0');
+  assert.ok(current.duration > 1.5 && current.duration < 2.5, `总时长应约 1.95s，实际 ${current.duration}`);
+  step(`添加 4 类场景，时间线 ${current.scenes.map((scene) => scene.start).join('/')}s，总长 ${current.duration}s`);
+
+  // 4. 场景重排 / 更新
+  const idsBefore = current.scenes.map((scene) => scene.id);
+  current = core.reorderScenes(id, [idsBefore[1], idsBefore[0], ...idsBefore.slice(2)]);
+  assert.equal(current.scenes[0].id, idsBefore[1]);
+  assert.equal(current.scenes[0].start, 0);
+  current = core.updateScene(id, idsBefore[2], { overlay: { text: '更新后的批注文字', position: 'top', style: { fontSize: 12 } } });
+  assert.equal(current.scenes[2].overlay.text, '更新后的批注文字');
+  current = core.reorderScenes(id, idsBefore);
+  assert.deepEqual(current.scenes.map((scene) => scene.id), idsBefore);
+  step('场景重排 + updateScene 生效');
+
+  // 5. 多轨音频（含淡入淡出）
+  core.addAudioTrack(id, { name: 'BGM 背景乐', kind: 'bgm', src: bgm.src, start: 0, duration: 2, volume: 0.3, fadeIn: 0.2, fadeOut: 0.3 });
+  core.addAudioTrack(id, { name: 'AI 旁白', kind: 'voice', src: bgm.src, start: 0.6, duration: 1.2, volume: 0.9, fadeIn: 0.1, fadeOut: 0.2 });
+  current = core.getProject(id);
+  assert.equal(current.audio.tracks.length, 2);
+  step('添加 2 条音轨（bgm + voice，含 fadeIn/fadeOut）');
+
+  // 6. 批注全生命周期
+  let withAnn = core.addAnnotation(id, { time: 0.8, region: { x: 0.1, y: 0.1, w: 0.3, h: 0.2 }, target: 'element', text: '镜头推进太快，放慢一点', author: 'human' });
+  const annId = withAnn.annotations[0].id;
