@@ -0,0 +1,28 @@
+# VStudio（V「视听」视频工程）插件配置模板
+# 复制为 config.env 后按需修改；VCPToolBox 启动插件时会自动把本文件加载为环境变量。
+# 注意：环境变量优先级高于本文件，VCPChat 主进程也可通过 process.env 覆盖。
+
+# ---- 数据目录 ----
+# 工程/素材/成片根目录。默认 /app/VCPChat/AppData/VStudio
+VSTUDIO_HOME=/app/VCPChat/AppData/VStudio
+
+# ---- 外部可执行文件 ----
+# 本机 ffmpeg 7.0.2 静态构建：含 libass(ass/subtitles) 但无 drawtext，因此文字统一走 ASS 字幕
+FFMPEG_PATH=/home/admin/.local/bin/ffmpeg
+EDGE_TTS_PATH=/home/admin/.local/bin/edge-tts
+
+# ---- 中文字体（libass 通过 fontsdir 查找） ----
+VSTUDIO_FONTS_DIR=/home/admin/.fonts
+VSTUDIO_FONT_FAMILY=Noto Sans CJK SC
+
+# ---- 渲染参数 ----
+# x264 preset：ultrafast/veryfast/faster/fast/medium/slow；小样可用 veryfast
+VSTUDIO_X264_PRESET=medium
+# CRF 越小越清晰（18-23 常用）
+VSTUDIO_CRF=20
+# 单条 ffmpeg / 单次渲染超时（毫秒）
+VSTUDIO_RENDER_TIMEOUT_MS=900000
+# 同时运行的 ffmpeg 进程上限
+VSTUDIO_FFMPEG_CONCURRENCY=2
+# edge-tts 超时（毫秒）
+VSTUDIO_TTS_TIMEOUT_MS=180000
