+#!/usr/bin/env node
+'use strict';
+
+/**
+ * VStudio.js —— VCP 同步插件入口（stdio 协议）
+ * =====================================================================
+ * 协议：stdin 一行 JSON（{command:'list_projects', ...扁平参数}）→ 执行 →
+ *       stdout 一行 JSON（VCP 标准 {status,result,error,messageForAI}）。
+ * 调试信息一律走 stderr，stdout 只允许输出一行结果 JSON。
+ *
+ * 除 VCP 主服务调用外，也支持命令行直接调试：
+ *   node VStudio.js --call '{"command":"list_projects"}'
+ *   echo '{"command":"render_status","id":"proj_x"}' | node VStudio.js
+ */
+
+const fs = require('fs');
+const path = require('path');
+const core = require('./VStudioCore.js');
+
+const PLUGIN_NAME = 'VStudio';
+
+// ---------------------------------------------------------------------------
+// 参数工具
+// ---------------------------------------------------------------------------
+
+function projectIdOf(params) {
+  const id = params.id !== undefined ? params.id : params.projectId !== undefined ? params.projectId : params.project_id;
+  if (id === undefined || id === null || String(id).trim() === '') {
+    throw new Error('缺少参数 id（工程 ID）');
+  }
+  return String(id);
+}
+
+function pickObject(params, keys) {
+  for (const key of keys) {
+    if (params[key] !== undefined && params[key] !== null) return params[key];
+  }
+  return undefined;
+}
+
+/** 平铺参数（去掉协议/定位字段）当作实体数据。 */
+function flatEntity(params, excluded) {
+  const omit = new Set(['command', 'action', 'args', 'params', 'options', 'tool_name', 'maid', 'projectId', 'project_id', ...excluded]);
+  const out = {};
+  for (const [key, value] of Object.entries(params)) {
+    if (!omit.has(key)) out[key] = value;
+  }
+  return out;
+}
+
+function extractOptions(params, fallbackKeys) {
+  if (params.options && typeof params.options === 'object') return params.options;
+  if (params.params && typeof params.params === 'object') return params.params;
+  const out = {};
+  for (const key of fallbackKeys) {
+    if (params[key] !== undefined && params[key] !== null) out[key] = params[key];
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------
+// 动作处理：action 名与 VCPChat 主进程 IPC / 前端一致（snake_case）
+// ---------------------------------------------------------------------------
+
+const ACTIONS = {
+  // ---- 工程 CRUD ----
+  list_projects: () => core.listProjects(),
+  get_project: (params) => core.getProject(projectIdOf(params)),
+  create_project: (params) => core.createProject(pickObject(params, ['project']) || flatEntity(params, ['id'])),
+  save_project: (params) => {
+    const project = pickObject(params, ['project']);
+    if (!project || typeof project !== 'object') throw new Error('save_project 需要 project 对象');
+    return core.saveProject(project);
+  },
+  update_project: (params) => {
+    const id = projectIdOf(params);
+    const patch = pickObject(params, ['patch', 'updates']) || flatEntity(params, ['id', 'projectId', 'project_id']);
+    return core.updateProject(id, patch);
+  },
+  delete_project: (params) => core.deleteProject(projectIdOf(params)),
+
+  // ---- 场景 ----
+  add_scene: (params) => {
+    const id = projectIdOf(params);
+    const scene = pickObject(params, ['scene']) || flatEntity(params, ['id', 'projectId', 'project_id']);
+    return core.addScene(id, scene);
+  },
+  update_scene: (params) => {
+    const id = projectIdOf(params);
+    const sceneId = params.sceneId !== undefined ? params.sceneId : params.scene_id;
+    const patch = pickObject(params, ['patch', 'updates']) || flatEntity(params, ['id', 'projectId', 'project_id', 'sceneId', 'scene_id']);
+    return core.updateScene(id, sceneId, patch);
+  },
+  remove_scene: (params) => {
+    const id = projectIdOf(params);
+    const sceneId = params.sceneId !== undefined ? params.sceneId : params.scene_id;
+    return core.removeScene(id, sceneId);
+  },
+  reorder_scenes: (params) => {
+    const id = projectIdOf(params);
+    const order = pickObject(params, ['order', 'sceneIds', 'scene_ids']);
+    return core.reorderScenes(id, order);
+  },
+
+  // ---- 音轨 ----
+  add_audio_track: (params) => {
+    const id = projectIdOf(params);
+    const track = pickObject(params, ['track']) || flatEntity(params, ['id', 'projectId', 'project_id']);
+    return core.addAudioTrack(id, track);
+  },
+  update_audio_track: (params) => {
+    const id = projectIdOf(params);
+    const trackId = params.trackId !== undefined ? params.trackId : params.track_id;
+    const patch = pickObject(params, ['patch', 'updates']) || flatEntity(params, ['id', 'projectId', 'project_id', 'trackId', 'track_id']);
+    return core.updateAudioTrack(id, trackId, patch);
+  },
+  remove_audio_track: (params) => {
+    const id = projectIdOf(params);
+    const trackId = params.trackId !== undefined ? params.trackId : params.track_id;
+    return core.removeAudioTrack(id, trackId);
+  },
+
+  // ---- 素材 ----
+  import_asset: (params) => {
+    const id = projectIdOf(params);
+    const payload = pickObject(params, ['asset']) || flatEntity(params, ['id', 'projectId', 'project_id']);
+    return core.importAsset(id, payload);
+  },
+  list_assets: (params) => core.listAssets(projectIdOf(params)),
+
+  // ---- 批注 ----
+  add_annotation: (params) => {
+    const id = projectIdOf(params);
+    const annotation = pickObject(params, ['annotation', 'ann']) || flatEntity(params, ['id', 'projectId', 'project_id']);
+    return core.addAnnotation(id, annotation);
+  },
+  update_annotation: (params) => {
+    const id = projectIdOf(params);
+    const annotationId = params.annotationId !== undefined ? params.annotationId : params.annId !== undefined ? params.annId : params.annotation_id;
+    const patch = pickObject(params, ['patch', 'updates']) || flatEntity(params, ['id', 'projectId', 'project_id', 'annotationId', 'annId', 'annotation_id']);
+    return core.updateAnnotation(id, annotationId, patch);
+  },
+  remove_annotation: (params) => {
+    const id = projectIdOf(params);
+    const annotationId = params.annotationId !== undefined ? params.annotationId : params.annId !== undefined ? params.annId : params.annotation_id;
+    return core.removeAnnotation(id, annotationId);
+  },
+
+  // ---- 配音 ----
+  tts_voiceover: (params) => {
+    const id = projectIdOf(params);
+    const options = extractOptions(params, ['text', 'voice', 'trackName', 'sceneId', 'start', 'rate', 'pitch', 'volume', 'fadeIn', 'fadeOut']);
+    return core.ttsVoiceover(id, options);
+  },
+
+  // ---- 渲染 ----
+  render: (params) => {
+    const id = projectIdOf(params);
+    const options = extractOptions(params, ['crf', 'preset', 'timeoutMs', 'posterTime', 'outputName', 'keepWork']);
+    return core.render(id, options);
+  },
+  render_status: (params) => core.renderStatus(projectIdOf(params)),
+
+  // ---- 辅助（非核心契约，便于 agent 自检）----
+  probe_media: async (params) => {
+    const file = params.file || params.path || params.sourcePath;
+    if (!file) throw new Error('probe_media 需要 file 参数');
+    return core.probeMedia(path.isAbsolute(file) ? file : path.resolve(process.cwd(), file));
+  },
+  get_plugin_info: () => ({
+    name: PLUGIN_NAME,
+    version: '1.0.0',
+    schemaVersion: core.SCHEMA_VERSION,
+    actions: Object.keys(ACTIONS),
+    config: core.getConfig(),
+  }),
+};
+
+// 兼容 PascalCase / camelCase 动作名（agent 偶尔写 ListProjects）
+function normalizeActionName(raw) {
+  if (!raw) return '';
+  const text = String(raw).trim();
+  if (ACTIONS[text]) return text;
+  const snake = text
+    .replace(/([a-z0-9])([A-Z])/g, '$1_$2')
+    .replace(/[\s-]+/g, '_')
+    .toLowerCase();
+  if (ACTIONS[snake]) return snake;
+  // 允许带插件名前缀，如 VStudio.list_projects
+  const tail = snake.split('.').pop();
+  return ACTIONS[tail] ? tail : snake;
+}
+
+// ---------------------------------------------------------------------------
+// 结果转 VCP 协议（content 数组 + details 结构化数据）
+// ---------------------------------------------------------------------------
+
+function projectSummaryText(project) {
+  if (!project) return '无工程数据';
+  return [
+    `工程「${project.name}」(${project.id})`,
+    `- 分辨率 ${project.width}x${project.height} @ ${project.fps}fps，时长 ${project.duration}s`,
+    `- 场景 ${project.scenes.length} 个，音轨 ${project.audio.tracks.length} 条，批注 ${project.annotations.length} 条`,
+    `- 渲染状态：${project.rendered.status}（progress ${project.rendered.progress}）`,
+  ].join('\n');
+}
+
+function buildSuccessResult(action, data) {
+  let text = '';
+  switch (action) {
+    case 'list_projects':
+      text = data.length
+        ? `共 ${data.length} 个工程：\n${data.map((item) => `- ${item.name} (${item.id}) 时长 ${item.duration}s，渲染 ${item.rendered.status}`).join('\n')}`
+        : '当前没有任何工程，可以调用 create_project 创建。';
+      break;
+    case 'get_project':
+    case 'create_project':
+    case 'save_project':
+    case 'update_project':
+    case 'add_scene':
+    case 'update_scene':
+    case 'remove_scene':
+    case 'reorder_scenes':
+    case 'add_audio_track':
+    case 'update_audio_track':
+    case 'remove_audio_track':
+    case 'add_annotation':
+    case 'update_annotation':
+    case 'remove_annotation':
+      text = projectSummaryText(data);
+      break;
+    case 'delete_project':
+      text = `工程已删除：${data.id}`;
+      break;
+    case 'import_asset':
+      text = `素材已导入：${data.src}（${data.type}，${data.size} 字节${data.duration ? `，时长 ${data.duration}s` : ''}）`;
+      break;
+    case 'list_assets':
+      text = data.length ? `共 ${data.length} 个素材：\n${data.map((item) => `- ${item.src}（${item.type}，${item.size} 字节）`).join('\n')}` : '素材库为空。';
+      break;
+    case 'tts_voiceover':
+      text = `配音完成，音轨「${data.track.name}」时长 ${data.track.duration}s，已加入工程。\n${projectSummaryText(data.project)}`;
+      break;
+    case 'render':
+      text = [
+        '渲染完成 ✅',
+        `- 成片：${data.path}（${data.duration}s，${data.width}x${data.height}@${data.fps}fps）`,
+        `- 封面：${data.posterPath}`,
+        data.warnings && data.warnings.length ? `- 警告：${data.warnings.join('；')}` : '- 无警告',
+      ].join('\n');
+      break;
+    case 'render_status':
+      text = `渲染状态：${data.statusLabel} / ${data.status}，进度 ${data.progress}%${
+        data.error ? `，错误：${data.error}` : ''
+      }${data.path ? `，成片 ${data.path}` : ''}${data.running ? '，渲染进程运行中' : ''}`;
+      break;
+    case 'probe_media':
+      text = `媒体信息：时长 ${data.duration}s，${data.width}x${data.height}${data.fps ? `@${data.fps}fps` : ''}，视频=${data.hasVideo}，音频=${data.hasAudio}`;
+      break;
+    case 'get_plugin_info':
+      text = `VStudio v${data.version}（schemaVersion=${data.schemaVersion}）\n可用动作：${data.actions.join(', ')}\n数据目录：${data.config.home}`;
+      break;
+    default:
+      text = JSON.stringify(data).slice(0, 2000);
+  }
+  return {
+    status: 'success',
+    result: {
+      content: [{ type: 'text', text }],
+      details: data,
+    },
+    messageForAI: text,
+  };
+}
+
+function buildErrorResult(error) {
+  const message = error && error.message ? error.message : String(error);
+  return {
+    status: 'error',
+    error: message,
+    messageForAI: `VStudio 工具调用失败：${message}`,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// 主流程（兼容 VCP stdio 与命令行调试）
+// ---------------------------------------------------------------------------
+
+async function dispatch(request) {
+  if (!request || typeof request !== 'object') throw new Error('请求必须是 JSON 对象');
+  const action = normalizeActionName(request.command || request.action || request.tool || request.type);
+  if (!action) throw new Error('缺少 command 字段（可执行动作见 plugin-manifest.json）');
+  if (!ACTIONS[action]) throw new Error(`未知动作：${action}（可用动作：${Object.keys(ACTIONS).join(', ')}）`);
+  let payload = request;
+  if (request.args && typeof request.args === 'object') payload = { ...request, ...request.args };
+  if (request.params && typeof request.params === 'object' && action !== 'tts_voiceover') payload = { ...request, ...request.params };
+  const data = await ACTIONS[action](payload);
+  return { action, data };
+}
+
+function readStdin() {
+  return new Promise((resolve) => {
+    if (process.stdin.isTTY) {
+      resolve('');
+      return;
+    }
+    let buffer = '';
+    process.stdin.setEncoding('utf8');
+    process.stdin.on('data', (chunk) => {
+      buffer += chunk;
+    });
+    process.stdin.on('end', () => resolve(buffer));
+    process.stdin.on('error', () => resolve(buffer));
+  });
+}
+
+async function main() {
+  const callIndex = process.argv.indexOf('--call');
+  let raw = '';
+  if (callIndex >= 0) {
+    raw = process.argv[callIndex + 1] || '';
+  } else {
+    raw = await readStdin();
+  }
+  const line = String(raw)
+    .split(/\r?\n/)
+    .map((item) => item.trim())
+    .find((item) => item.length > 0);
+  if (!line) {
+    process.stdout.write(`${JSON.stringify(buildErrorResult(new Error('stdin 为空：需要一个 JSON 请求行')))}\n`);
+    return;
+  }
+  let request;
+  try {
+    request = JSON.parse(line);
+  } catch (error) {
+    process.stdout.write(`${JSON.stringify(buildErrorResult(new Error(`请求 JSON 解析失败：${error.message}`)))}\n`);
+    return;
+  }
+  try {
+    const { action, data } = await dispatch(request);
+    process.stdout.write(`${JSON.stringify(buildSuccessResult(action, data))}\n`);
+  } catch (error) {
+    // 详细堆栈走 stderr，便于 VCPToolBox 日志排查；stdout 保持一行合法 JSON
+    process.stderr.write(`[VStudio] ${error && error.stack ? error.stack : String(error)}\n`);
+    process.stdout.write(`${JSON.stringify(buildErrorResult(error))}\n`);
+  }
+}
+
+main()
+  .catch((error) => {
+    process.stderr.write(`[VStudio] 未捕获异常：${error && error.stack ? error.stack : String(error)}\n`);
+    process.stdout.write(`${JSON.stringify(buildErrorResult(error))}\n`);
+  })
+  .finally(() => {
+    // 结果写入 stdout 后：优先让事件循环自然退出（保证大 JSON 的管道写入被完整 flush），
+    // 若宿主不关闭 stdin/存在残留句柄，2 秒后兜底强制退出，避免插件进程挂住。
+    process.exitCode = 0;
+    setTimeout(() => process.exit(0), 2000).unref();
+  });
