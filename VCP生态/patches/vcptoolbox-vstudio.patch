+// ===========================================================================
+// 十四、渲染实现
+// ===========================================================================
+
+function toLavfiColor(color) {
+  let value = String(color === undefined || color === null ? '#000000' : color).trim();
+  if (/^#[0-9a-fA-F]{6}$/.test(value)) return `0x${value.slice(1)}`;
+  if (/^#[0-9a-fA-F]{8}$/.test(value)) return `0x${value.slice(1, 7)}`;
+  if (/^0x[0-9a-fA-F]{6,8}$/.test(value)) return value;
+  if (/^[0-9a-fA-F]{6}$/.test(value)) return `0x${value}`;
+  return value; // 允许 ffmpeg 颜色名（black/white/...）
+}
+
+function parseBackground(scene) {
+  const raw = scene.color;
+  const isGradientType = scene.type === 'color' || scene.type === 'title';
+  if (Array.isArray(raw)) {
+    const colors = raw.map((item) => String(item)).filter(Boolean);
+    if (colors.length >= 2) return { gradient: true, colors: colors.slice(0, 8), angle: 0 };
+    return { gradient: false, color: colors[0] || '#0b1020' };
+  }
+  if (raw && typeof raw === 'object') {
+    const colors = Array.isArray(raw.colors) ? raw.colors.map(String).filter(Boolean) : [];
+    if (raw.type === 'gradient' || colors.length >= 2) {
+      const finalColors = colors.length >= 2 ? colors : [String(raw.from || '#0b1020'), String(raw.to || '#1e3a8a')];
+      return { gradient: true, colors: finalColors.slice(0, 8), angle: num(raw.angle, 0) };
+    }
+    return { gradient: false, color: raw.color ? String(raw.color) : '#0b1020' };
+  }
+  const text = String(raw === undefined || raw === null ? '' : raw).trim();
+  if (text.includes('|') || text.includes(',')) {
+    const colors = text.split(/[|,]/).map((item) => item.trim()).filter(Boolean);
+    if (colors.length >= 2) return { gradient: true, colors: colors.slice(0, 8), angle: 0 };
+  }
+  if (text.startsWith('gradient:')) {
+    const colors = text.slice('gradient:'.length).split(/[|,]/).map((item) => item.trim()).filter(Boolean);
+    if (colors.length >= 2) return { gradient: true, colors, angle: 0 };
+  }
+  if (!text && isGradientType) return { gradient: true, colors: ['#0b1020', '#1e3a8a'], angle: 0 };
+  return { gradient: false, color: text || '#0b1020' };
+}
+
+function gradientSource(spec, width, height, fps) {
+  const colors = spec.colors.map((item) => toLavfiColor(item));
+  const angle = num(spec.angle, 0);
+  const radians = (angle * Math.PI) / 180;
+  const dx = Math.abs(Math.cos(radians));
+  const dy = Math.abs(Math.sin(radians));
+  const x0 = 0;
+  const y0 = 0;
+  const x1 = Math.round(width * dx);
+  const y1 = Math.round(height * dy);
+  const parts = [`gradients=s=${width}x${height}:r=${fps}`];
+  colors.forEach((color, index) => parts.push(`c${index}=${color}`));
+  parts.push(`nb_colors=${colors.length}`);
+  parts.push(`x0=${x0}`, `y0=${y0}`, `x1=${x1}`, `y1=${y1}`);
+  return parts.join(':');
+}
+
+function backgroundInputArgs(scene, width, height, fps) {
+  const spec = parseBackground(scene);
+  const filter = spec.gradient ? gradientSource(spec, width, height, fps) : `color=c=${toLavfiColor(spec.color)}:s=${width}x${height}:r=${fps}`;
+  return ['-f', 'lavfi', '-i', filter];
+}
+
+function layoutToPixels(layout, width, height) {
+  const normalized = normalizeLayout(layout);
+  const w = Math.min(width, Math.max(2, evenInt(normalized.w * width)));
+  const h = Math.min(height, Math.max(2, evenInt(normalized.h * height)));
+  const x = clamp(Math.round(normalized.x * width), 0, Math.max(0, width - w));
+  const y = clamp(Math.round(normalized.y * height), 0, Math.max(0, height - h));
+  return { x, y, w, h };
+}
+
+function buildMotionExpr(motion, frames) {
+  const type = motion && Object.prototype.hasOwnProperty.call(MOTION_PRESETS, motion.type) ? motion.type : 'none';
+  const preset = MOTION_PRESETS[type];
+  const zoomFrom = clamp(num(motion && motion.zoomFrom, preset.z0), 1, 4);
+  const zoomTo = clamp(num(motion && motion.zoomTo, preset.z1), 1, 4);
+  const from = normalizePoint(motion && motion.panFrom, preset.from);
+  const to = normalizePoint(motion && motion.panTo, preset.to);
+  const denominator = Math.max(1, frames - 1);
+  const zoomExpr =
+    Math.abs(zoomTo - zoomFrom) < 1e-6
+      ? String(round3(zoomFrom))
+      : `max(1,${round3(zoomFrom)}+(${round3(zoomTo)}-${round3(zoomFrom)})*on/${denominator})`;
+  const xExpr = `(iw-iw/zoom)*(${round3(from.x)}+(${round3(to.x)}-${round3(from.x)})*on/${denominator})`;
+  const yExpr = `(ih-ih/zoom)*(${round3(from.y)}+(${round3(to.y)}-${round3(from.y)})*on/${denominator})`;
+  return { zoom: zoomExpr, x: xExpr, y: yExpr };
+}
+
+function buildSceneRenderCommand(project, scene, outPath, assPath, options) {
+  const width = project.width;
+  const height = project.height;
+  const fps = project.fps;
+  const frames = Math.max(1, Math.round(scene.duration * fps));
+  const duration = frames / fps;
+  const layout = layoutToPixels(scene.layout, width, height);
+  const fullCanvas = layout.x === 0 && layout.y === 0 && layout.w >= width && layout.h >= height;
+  const args = [];
+  const chains = [];
+  let inputIndex = 0;
+  let baseLabel = null;
