     "pitch": "0Hz",
     "pause_after": 0.16
    },
    {
     "i": 12,
     "text": "刹车时，顺序反过来：轮端推电机，电机发电，逆变器整流，电池收电。",
     "rate": "+1%",
     "pitch": "0Hz",
     "pause_after": 0.16
