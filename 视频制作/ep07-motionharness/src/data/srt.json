[
 {
  "start": 1,
  "end": 3.965,
  "text": "落地 20 万，开三年，二手只值 9 万。"
 },
 {
  "start": 4.155,
  "end": 5.384,
  "text": "价格战打了三年。"
 },
 {
  "start": 5.504,
  "end": 7.064,
  "text": "先崩的，是二手价。"
 },
 {
  "start": 7.184,
  "end": 9.249,
  "text": "这不是段子。11 月 10 日，"
 },
 {
  "start": 9.249,
  "end": 11.581,
  "text": "中国汽车流通协会刚发的报告。"
 },
 {
  "start": 11.701,
  "end": 13.307,
  "text": "报告不厚，数字很硬。"
 },
 {
  "start": 13.427,
  "end": 15.995,
  "text": "纯电，三年保值率 45.1%。"
 },
 {
  "start": 16.365,
  "end": 18.636,
  "text": "插混更狠，42.2%。"
 },
 {
  "start": 18.886,
  "end": 20.711,
  "text": "一台车，三年蒸发一半。"
 },
 {
  "start": 20.901,
  "end": 23.754,
  "text": "报告只讲一件事：三年后，还值多少。"
 },
 {
  "start": 23.944,
  "end": 25.526,
  "text": "谁在给它重新定价？"
 },
 {
  "start": 26.116,
  "end": 27.107,
  "text": "先把账摊开。"
 },
 {
  "start": 27.227,
  "end": 30.281,
  "text": "中大型 SUV 50.6%，唯一站上五成。"
 },
 {
  "start": 30.401,
  "end": 33.65,
  "text": "MPV 48.7%，小型车 48.3%。"
 },
 {
  "start": 33.77,
  "end": 36.075,
  "text": "对照燃油车：普遍 50% 以上。"
 },
 {
  "start": 36.195,
  "end": 38.32,
  "text": "日系合资，54% 以上。"
 },
 {
  "start": 38.44,
  "end": 40.34,
  "text": "保时捷，66.2%。"
 },
 {
  "start": 40.46,
  "end": 42.615,
  "text": "一边剩一半多，一边剩四成半。"
 },
 {
  "start": 42.735,
  "end": 44.5,
  "text": "同样三年，差别这么大。"
 },
 {
  "start": 44.62,
  "end": 46.828,
  "text": "20 万到 9 万，差额 11 万。"
 },
 {
  "start": 46.948,
  "end": 48.75,
  "text": "摊到每年，3.7 万。"
 },
 {
  "start": 48.87,
  "end": 51.114,
  "text": "一年 3.7 万，一个月 3000 多。"
 },
 {
  "start": 51.234,
  "end": 52.707,
  "text": "这不是一台车的事故。"
 },
 {
  "start": 52.827,
  "end": 54.799,
  "text": "是一个品类，被重新估值。"
 },
 {
  "start": 55.169,
  "end": 56.803,
  "text": "为什么？三本账。"
 },
 {
  "start": 56.923,
  "end": 57.937,
  "text": "第一本，技术。"
 },
 {
  "start": 58.057,
  "end": 59.773,
  "text": "新车发布会，一年好几场。"
 },
 {
  "start": 59.893,
  "end": 61.206,
  "text": "800V、5C 超充、"
 },
 {
  "start": 61.206,
  "end": 63.082,
  "text": "城区智驾，一年一迭代。"
 },
 {
  "start": 63.202,
  "end": 65.092,
  "text": "三年前的车，不是不能开，"
 },
 {
  "start": 65.092,
  "end": 66.352,
  "text": "是参数落后两代。"
 },
 {
  "start": 66.472,
  "end": 68.616,
  "text": "参数表上的领先，一年就旧。"
 },
 {
  "start": 68.736,
  "end": 70.654,
  "text": "老款插混更难：新款续航"
 },
 {
  "start": 70.654,
  "end": 72.223,
  "text": "能耗，直接压残值。"
 },
 {
  "start": 72.343,
  "end": 73.459,
  "text": "第二本，价格。"
 },
 {
  "start": 73.579,
  "end": 74.644,
  "text": "买家算落地价。"
 },
 {
  "start": 74.764,
  "end": 75.878,
  "text": "车商算出手价。"
 },
 {
  "start": 75.998,
  "end": 78.223,
  "text": "新车优惠一改，二手标尺就变。"
 },
 {
  "start": 78.343,
  "end": 81.224,
  "text": "今天新车降两万，昨天收的车就亏两万。"
 },
 {
  "start": 81.344,
  "end": 83.969,
  "text": "降价降的是新车价，透支的是旧车价。"
 },
 {
  "start": 84.089,
  "end": 85.806,
  "text": "二手市场，不看发布会。"
 },
 {
  "start": 85.926,
  "end": 88.027,
  "text": "收车的人，比买车的人更懂价。"
 },
 {
  "start": 88.147,
  "end": 89.371,
  "text": "第三本，电池。"
 },
 {
  "start": 89.491,
  "end": 91.411,
  "text": "电池最贵，也最不敢接。"
 },
 {
  "start": 91.531,
  "end": 93.549,
  "text": "检测没标准，衰减看不见；"
 },
 {
  "start": 93.549,
  "end": 96.071,
  "text": "多数品牌八年或十二万公里质保。"
 },
 {
  "start": 96.191,
  "end": 97.503,
  "text": "屏幕上看不见衰减。"
 },
 {
  "start": 97.623,
  "end": 99.14,
  "text": "报价里，全是衰减。"
 },
 {
  "start": 99.26,
  "end": 101.755,
  "text": "车商收车意愿一降，全折进报价。"
 },
 {
  "start": 101.875,
  "end": 103.956,
  "text": "三本账，最后都算在残值里。"
 },
 {
  "start": 104.076,
  "end": 106.046,
  "text": "传导到最后一环，是残值。"
 },
 {
  "start": 106.416,
  "end": 108.311,
  "text": "但报告还有另一半：分化。"
 },
 {
  "start": 108.431,
  "end": 109.929,
  "text": "分化，才是重点。"
 },
 {
  "start": 110.049,
  "end": 111.094,
  "text": "分化有多大？"
 },
 {
  "start": 111.214,
  "end": 115.02,
  "text": "中大型 SUV 50.6%，MPV 48.7%。"
 },
 {
  "start": 115.14,
  "end": 116.687,
  "text": "一边五成，一边三成。"
 },
 {
  "start": 116.807,
  "end": 120.024,
  "text": "豪华品牌：保时捷、雷克萨斯还硬；"
 },
 {
  "start": 120.024,
  "end": 122.215,
  "text": "沃尔沃 35.7%，捷豹 32."
 },
 {
  "start": 122.215,
  "end": 124.245,
  "text": "8%，英菲尼迪 29.1%。"
 },
 {
  "start": 124.365,
  "end": 127.433,
  "text": "合资：本田、丰田、马自达近五成；"
 },
 {
  "start": 127.433,
  "end": 130.127,
  "text": "标致、斯柯达、福特不到 43%。"
 },
 {
  "start": 130.247,
  "end": 132.629,
  "text": "自主：传祺、坦克领跑；领克、"
 },
 {
  "start": 132.629,
  "end": 134.501,
  "text": "长安欧尚、极氪还在涨。"
 },
 {
  "start": 134.621,
  "end": 136.44,
  "text": "保值率高的，往往不新。"
 },
 {
  "start": 136.56,
  "end": 138.011,
  "text": "买的人多，价才稳。"
 },
 {
  "start": 138.131,
  "end": 139.666,
  "text": "换代慢，老车才不掉。"
 },
 {
  "start": 139.786,
  "end": 141.503,
  "text": "价格稳，二手才敢收。"
 },
 {
  "start": 141.623,
  "end": 144.206,
  "text": "一年期榜单，新势力前十占八席。"
 },
 {
  "start": 144.326,
  "end": 146.595,
  "text": "一年期看热度，三年期看接盘。"
 },
 {
  "start": 146.715,
  "end": 149.41,
  "text": "第一年猛不算猛，第三年才见真章。"
 },
 {
  "start": 149.53,
  "end": 151.356,
  "text": "所以，这不是给“电车”判刑。"
 },
 {
  "start": 151.476,
  "end": 153.243,
  "text": "是给“哪台车、哪个品牌、"
 },
 {
  "start": 153.243,
  "end": 154.421,
  "text": "哪套技术”打分。"
 },
 {
  "start": 154.791,
  "end": 156.874,
  "text": "三件事，都在这张评估单上。"
 },
 {
  "start": 156.994,
  "end": 158.011,
  "text": "一件一件算。"
 },
 {
  "start": 158.131,
  "end": 159.907,
  "text": "买车：落地价不是成本，"
 },
 {
  "start": 159.907,
  "end": 162.167,
  "text": "落地价减残值加使用成本才是。"
 },
 {
  "start": 162.287,
  "end": 164.328,
  "text": "三年一换，残值就是月供。"
 },
 {
  "start": 164.448,
  "end": 166.307,
  "text": "月供之外，还有一笔折旧。"
 },
 {
  "start": 166.427,
  "end": 168.18,
  "text": "20 万电车，三年折旧 11"
 },
 {
  "start": 168.18,
  "end": 169.454,
  "text": "万，没人给你算。"
 },
 {
  "start": 169.574,
  "end": 171.981,
  "text": "造车：价格战打新车，伤旧车；"
 },
 {
  "start": 171.981,
  "end": 173.7,
  "text": "残值反噬品牌和金融。"
 },
 {
  "start": 173.82,
  "end": 175.989,
  "text": "价格战一打，二手车商先受伤。"
 },
 {
  "start": 176.109,
  "end": 178.962,
  "text": "技术：参数厂商写，保值率市场写。"
 },
 {
  "start": 179.082,
  "end": 181.363,
  "text": "技术迭代越快，老车越像旧手机。"
 },
 {
  "start": 181.483,
  "end": 183.053,
  "text": "当残值变成显性成本，"
 },
 {
  "start": 183.053,
  "end": 184.465,
  "text": "价格战就不再免费。"
 },
 {
  "start": 184.835,
  "end": 186.742,
  "text": "新车发布会，决定它卖多少钱。"
 },
 {
  "start": 186.862,
  "end": 189.484,
  "text": "三年后的二手车市场，决定它还值多少。"
 },
 {
  "start": 189.604,
  "end": 190.808,
  "text": "这不是买车建议。"
 },
 {
  "start": 190.928,
  "end": 192.279,
  "text": "是一张价签的常识。"
 },
 {
  "start": 192.399,
  "end": 194.173,
  "text": "价签会旧，判断要新。"
 },
 {
  "start": 194.293,
  "end": 196.367,
  "text": "下一次看发布会，多问一句："
 },
 {
  "start": 196.367,
  "end": 197.803,
  "text": "三年后，它值多少？"
 },
 {
  "start": 198.523,
  "end": 202.002,
  "text": "本片数据来自公开报告与公开报道；本片"
 },
 {
  "start": 202.002,
  "end": 205.287,
  "text": "为知识与观点内容，不构成购买建议。"
 },
 {
  "start": 205.287,
  "end": 208.166,
  "text": "本片画面与配音含 AI 辅助制作。"
 }
]
