{
 "source": "script-v0.2-design",
 "duration": 197.18,
 "cues": [
  {
   "start": 0,
   "end": 2.24,
   "text": "落地 20 万，开三年，二手只值 9 万。",
   "seg": "COLD"
  },
  {
   "start": 2.42,
   "end": 3.85,
   "text": "价格战打了三年。",
   "seg": "COLD"
  },
  {
   "start": 4.03,
   "end": 5.46,
   "text": "先崩的，是二手价。",
   "seg": "COLD"
  },
  {
   "start": 5.64,
   "end": 9.72,
   "text": "这不是段子。11 月 10 日，中国汽车流通协会刚发的报告。",
   "seg": "COLD"
  },
  {
   "start": 9.9,
   "end": 11.54,
   "text": "报告不厚，数字很硬。",
   "seg": "COLD"
  },
  {
   "start": 11.72,
   "end": 13.14,
   "text": "纯电，三年保值率 45.1%。",
   "seg": "COLD"
  },
  {
   "start": 13.32,
   "end": 14.14,
   "text": "插混更狠，42.2%。",
   "seg": "COLD"
  },
  {
   "start": 14.32,
   "end": 16.16,
   "text": "一台车，三年蒸发一半。",
   "seg": "COLD"
  },
  {
   "start": 16.34,
   "end": 19.2,
   "text": "报告只讲一件事：三年后，还值多少。",
   "seg": "COLD"
  },
  {
   "start": 19.38,
   "end": 21.01,
   "text": "谁在给它重新定价？",
   "seg": "COLD"
  },
  {
   "start": 21.79,
   "end": 22.81,
   "text": "先把账摊开。",
   "seg": "ACT1"
  },
  {
   "start": 22.99,
   "end": 24.82,
   "text": "中大型 SUV 50.6%，唯一站上五成。",
   "seg": "ACT1"
  },
  {
   "start": 25,
   "end": 25.62,
   "text": "MPV 48.7%，小型车 48.3%。",
   "seg": "ACT1"
  },
  {
   "start": 25.8,
   "end": 27.63,
   "text": "对照燃油车：普遍 50% 以上。",
   "seg": "ACT1"
  },
  {
   "start": 27.81,
   "end": 29.04,
   "text": "日系合资，54% 以上。",
   "seg": "ACT1"
  },
  {
   "start": 29.22,
   "end": 29.83,
   "text": "保时捷，66.2%。",
   "seg": "ACT1"
  },
  {
   "start": 30.01,
   "end": 32.46,
   "text": "一边剩一半多，一边剩四成半。",
   "seg": "ACT1"
  },
  {
   "start": 32.64,
   "end": 34.48,
   "text": "同样三年，差别这么大。",
   "seg": "ACT1"
  },
  {
   "start": 34.66,
   "end": 35.88,
   "text": "20 万到 9 万，差额 11 万。",
   "seg": "ACT1"
  },
  {
   "start": 36.06,
   "end": 37.08,
   "text": "摊到每年，3.7 万。",
   "seg": "ACT1"
  },
  {
   "start": 37.26,
   "end": 38.69,
   "text": "一年 3.7 万，一个月 3000 多。",
   "seg": "ACT1"
  },
  {
   "start": 38.87,
   "end": 40.71,
   "text": "这不是一台车的事故。",
   "seg": "ACT1"
  },
  {
   "start": 40.89,
   "end": 42.93,
   "text": "是一个品类，被重新估值。",
   "seg": "ACT1"
  },
  {
   "start": 43.71,
   "end": 44.93,
   "text": "为什么？三本账。",
   "seg": "ACT2"
  },
  {
   "start": 45.11,
   "end": 46.13,
   "text": "第一本，技术。",
   "seg": "ACT2"
  },
  {
   "start": 46.31,
   "end": 48.35,
   "text": "新车发布会，一年好几场。",
   "seg": "ACT2"
  },
  {
   "start": 48.53,
   "end": 50.78,
   "text": "800V、5C 超充、城区智驾，一年一迭代。",
   "seg": "ACT2"
  },
  {
   "start": 50.96,
   "end": 54.43,
   "text": "三年前的车，不是不能开，是参数落后两代。",
   "seg": "ACT2"
  },
  {
   "start": 54.61,
   "end": 56.85,
   "text": "参数表上的领先，一年就旧。",
   "seg": "ACT2"
  },
  {
   "start": 57.03,
   "end": 60.5,
   "text": "老款插混更难：新款续航能耗，直接压残值。",
   "seg": "ACT2"
  },
  {
   "start": 60.68,
   "end": 61.7,
   "text": "第二本，价格。",
   "seg": "ACT2"
  },
  {
   "start": 61.88,
   "end": 63.11,
   "text": "买家算落地价。",
   "seg": "ACT2"
  },
  {
   "start": 63.29,
   "end": 64.51,
   "text": "车商算出手价。",
   "seg": "ACT2"
  },
  {
   "start": 64.69,
   "end": 67.14,
   "text": "新车优惠一改，二手标尺就变。",
   "seg": "ACT2"
  },
  {
   "start": 67.32,
   "end": 70.59,
   "text": "今天新车降两万，昨天收的车就亏两万。",
   "seg": "ACT2"
  },
  {
   "start": 70.77,
   "end": 73.83,
   "text": "降价降的是新车价，透支的是旧车价。",
   "seg": "ACT2"
  },
  {
   "start": 74.01,
   "end": 75.84,
   "text": "二手市场，不看发布会。",
   "seg": "ACT2"
  },
  {
   "start": 76.02,
   "end": 78.47,
   "text": "收车的人，比买车的人更懂价。",
   "seg": "ACT2"
  },
  {
   "start": 78.65,
   "end": 79.67,
   "text": "第三本，电池。",
   "seg": "ACT2"
  },
  {
   "start": 79.85,
   "end": 81.69,
   "text": "电池最贵，也最不敢接。",
   "seg": "ACT2"
  },
  {
   "start": 81.87,
   "end": 86.77,
   "text": "检测没标准，衰减看不见；多数品牌八年或十二万公里质保。",
   "seg": "ACT2"
  },
  {
   "start": 86.95,
   "end": 88.58,
   "text": "屏幕上看不见衰减。",
   "seg": "ACT2"
  },
  {
   "start": 88.76,
   "end": 90.19,
   "text": "报价里，全是衰减。",
   "seg": "ACT2"
  },
  {
   "start": 90.37,
   "end": 93.02,
   "text": "车商收车意愿一降，全折进报价。",
   "seg": "ACT2"
  },
  {
   "start": 93.2,
   "end": 95.45,
   "text": "三本账，最后都算在残值里。",
   "seg": "ACT2"
  },
  {
   "start": 95.63,
   "end": 97.26,
   "text": "传导到最后一环，是残值。",
   "seg": "ACT2"
  },
  {
   "start": 98.04,
   "end": 100.08,
   "text": "但报告还有另一半：分化。",
   "seg": "ACT3"
  },
  {
   "start": 100.26,
   "end": 101.48,
   "text": "分化，才是重点。",
   "seg": "ACT3"
  },
  {
   "start": 101.66,
   "end": 102.68,
   "text": "分化有多大？",
   "seg": "ACT3"
  },
  {
   "start": 102.86,
   "end": 103.48,
   "text": "中大型 SUV 50.6%，MPV 48.7%。",
   "seg": "ACT3"
  },
  {
   "start": 103.66,
   "end": 105.29,
   "text": "一边五成，一边三成。",
   "seg": "ACT3"
  },
  {
   "start": 105.47,
   "end": 109.96,
   "text": "豪华品牌：保时捷、雷克萨斯还硬；沃尔沃 35.7%，捷豹 32.8%，英菲尼迪 29.1%。",
   "seg": "ACT3"
  },
  {
   "start": 110.14,
   "end": 114.43,
   "text": "合资：本田、丰田、马自达近五成；标致、斯柯达、福特不到 43%。",
   "seg": "ACT3"
  },
  {
   "start": 114.61,
   "end": 118.48,
   "text": "自主：传祺、坦克领跑；领克、长安欧尚、极氪还在涨。",
   "seg": "ACT3"
  },
  {
   "start": 118.66,
   "end": 120.5,
   "text": "保值率高的，往往不新。",
   "seg": "ACT3"
  },
  {
   "start": 120.68,
   "end": 122.11,
   "text": "买的人多，价才稳。",
   "seg": "ACT3"
  },
  {
   "start": 122.29,
   "end": 123.92,
   "text": "换代慢，老车才不掉。",
   "seg": "ACT3"
  },
  {
   "start": 124.1,
   "end": 125.73,
   "text": "价格稳，二手才敢收。",
   "seg": "ACT3"
  },
  {
   "start": 125.91,
   "end": 128.57,
   "text": "一年期榜单，新势力前十占八席。",
   "seg": "ACT3"
  },
  {
   "start": 128.75,
   "end": 131.2,
   "text": "一年期看热度，三年期看接盘。",
   "seg": "ACT3"
  },
  {
   "start": 131.38,
   "end": 134.23,
   "text": "第一年猛不算猛，第三年才见真章。",
   "seg": "ACT3"
  },
  {
   "start": 134.41,
   "end": 136.45,
   "text": "所以，这不是给“电车”判刑。",
   "seg": "ACT3"
  },
  {
   "start": 136.63,
   "end": 139.69,
   "text": "是给“哪台车、哪个品牌、哪套技术”打分。",
   "seg": "ACT3"
  },
  {
   "start": 140.47,
   "end": 141.09,
   "text": "三件事，都在这张评估单上。",
   "seg": "ACT4"
  },
  {
   "start": 141.27,
   "end": 143.51,
   "text": "一件一件算。",
   "seg": "ACT4"
  },
  {
   "start": 143.69,
   "end": 148.18,
   "text": "买车：落地价不是成本，落地价减残值加使用成本才是。",
   "seg": "ACT4"
  },
  {
   "start": 148.36,
   "end": 150.4,
   "text": "三年一换，残值就是月供。",
   "seg": "ACT4"
  },
  {
   "start": 150.58,
   "end": 152.62,
   "text": "月供之外，还有一笔折旧。",
   "seg": "ACT4"
  },
  {
   "start": 152.8,
   "end": 155.46,
   "text": "20 万电车，三年折旧 11 万，没人给你算。",
   "seg": "ACT4"
  },
  {
   "start": 155.64,
   "end": 159.72,
   "text": "造车：价格战打新车，伤旧车；残值反噬品牌和金融。",
   "seg": "ACT4"
  },
  {
   "start": 159.9,
   "end": 162.35,
   "text": "价格战一打，二手车商先受伤。",
   "seg": "ACT4"
  },
  {
   "start": 162.53,
   "end": 165.18,
   "text": "技术：参数厂商写，保值率市场写。",
   "seg": "ACT4"
  },
  {
   "start": 165.36,
   "end": 168.01,
   "text": "技术迭代越快，老车越像旧手机。",
   "seg": "ACT4"
  },
  {
   "start": 168.19,
   "end": 171.66,
   "text": "当残值变成显性成本，价格战就不再免费。",
   "seg": "ACT4"
  },
  {
   "start": 172.44,
   "end": 174.89,
   "text": "新车发布会，决定它卖多少钱。",
   "seg": "CLOSE"
  },
  {
   "start": 175.07,
   "end": 178.34,
   "text": "三年后的二手车市场，决定它还值多少。",
   "seg": "CLOSE"
  },
  {
   "start": 178.52,
   "end": 179.95,
   "text": "这不是买车建议。",
   "seg": "CLOSE"
  },
  {
   "start": 180.13,
   "end": 181.76,
   "text": "是一张价签的常识。",
   "seg": "CLOSE"
  },
  {
   "start": 181.94,
   "end": 183.57,
   "text": "价签会旧，判断要新。",
   "seg": "CLOSE"
  },
  {
   "start": 183.75,
   "end": 187.42,
   "text": "下一次看发布会，多问一句：三年后，它值多少？",
   "seg": "CLOSE"
  },
  {
   "start": 187.6,
   "end": 196.58,
   "text": "本片数据来自公开报告与公开报道；本片为知识与观点内容，不构成购买建议。本片画面与配音含 AI 辅助制作。",
   "seg": "CLOSE"
  }
 ]
}
