[
 {
  "start": 2.8,
  "end": 5.964,
  "text": "2020 年，一场关于技术路线的判决，"
 },
 {
  "start": 5.964,
  "end": 7.679,
  "text": "从一张会议桌开始。"
 },
 {
  "start": 8.999,
  "end": 10.404,
  "text": "桌边坐着两个人。"
 },
 {
  "start": 11.604,
  "end": 14.424,
  "text": "一个带着手册，一个带着账本。"
 },
 {
  "start": 17.704,
  "end": 19.548,
  "text": "2020 年 9 月 8 日，"
 },
 {
  "start": 19.548,
  "end": 21.729,
  "text": "成都，一场媒体沟通会。"
 },
 {
  "start": 22.389,
  "end": 24.896,
  "text": "大众集团中国区 CEO 冯思翰，"
 },
 {
  "start": 24.896,
  "end": 27.319,
  "text": "被问到怎么看增程式电动车。"
 },
 {
  "start": 28.399,
  "end": 31.123,
  "text": "内燃机发电，再用电驱动车轮。"
 },
 {
  "start": 32.023,
  "end": 35.147,
  "text": "中间多一道转换，能量就多丢一次。"
 },
 {
  "start": 36.107,
  "end": 38.241,
  "text": "这不是观点，这是热力学。"
 },
 {
  "start": 39.561,
  "end": 40.764,
  "text": "账不是这么算的。"
 },
 {
  "start": 41.424,
  "end": 42.148,
  "text": "那怎么算？"
 },
 {
  "start": 42.928,
  "end": 44.882,
  "text": "用户不看你中间丢了多少。"
 },
 {
  "start": 45.422,
  "end": 47.41,
  "text": "他看我一箱油能跑多远，"
 },
 {
  "start": 47.41,
  "end": 49.579,
  "text": "看我在高速上敢不敢超车。"
 },
 {
  "start": 50.419,
  "end": 51.432,
  "text": "这叫不算账。"
 },
 {
  "start": 52.392,
  "end": 53.536,
  "text": "这叫算别的账。"
 },
 {
  "start": 57.296,
  "end": 60.055,
  "text": "一年后。2021 年 11 月。"
 },
 {
  "start": 61.015,
  "end": 62.83,
  "text": "理想 ONE，单月上险——"
 },
 {
  "start": 63.43,
  "end": 65.454,
  "text": "一万三千四百三十八台。"
 },
 {
  "start": 66.294,
  "end": 66.767,
  "text": "多少？"
 },
 {
  "start": 67.427,
  "end": 71.941,
  "text": "一、万、三、千、四、百、三、十、八。"
 },
 {
  "start": 73.261,
  "end": 75.274,
  "text": "同一个月，大众旗下五"
 },
 {
  "start": 75.274,
  "end": 76.894,
  "text": "款中大型 SUV——"
 },
 {
  "start": 77.554,
  "end": 80.067,
  "text": "途昂、途锐、揽境、ID."
 },
 {
  "start": 80.067,
  "end": 82.15,
  "text": "6 X、ID.6 Crozz。"
 },
 {
  "start": 82.81,
  "end": 85.67,
  "text": "加起来，一万二千四百四十五台。"
 },
 {
  "start": 86.75,
  "end": 88.453,
  "text": "还差九百九十三台。"
 },
 {
  "start": 89.773,
  "end": 92.332,
  "text": "李想在微博上，只发了八个字。"
 },
 {
  "start": 93.232,
  "end": 94.679,
  "text": "……这一页，我记下来了。"
 },
 {
  "start": 98.559,
  "end": 99.629,
  "text": "又过了四年。"
 },
 {
  "start": 100.289,
  "end": 103.01,
  "text": "2025 年 4 月，上海车展。"
 },
 {
  "start": 103.01,
  "end": 105.288,
  "text": "大众发布三款概念车。"
 },
 {
  "start": 106.068,
  "end": 108.006,
  "text": "其中一款，是增程。"
 },
 {
  "start": 109.326,
  "end": 110.3,
  "text": "你在看什么？"
 },
 {
  "start": 111.02,
  "end": 113.155,
  "text": "我在看，当年我划的这条线。"
 },
 {
  "start": 114.715,
  "end": 117.632,
  "text": "上汽大众 ID.ERA 9X 上市。"
 },
 {
  "start": 118.292,
  "end": 121.108,
  "text": "官方对它的说法是——\"增程新王\"。"
 },
 {
  "start": 121.948,
  "end": 122.972,
  "text": "规则没有变。"
 },
 {
  "start": 123.992,
  "end": 126.426,
  "text": "变的是，谁在按规则算账。"
 },
 {
  "start": 127.866,
  "end": 129.314,
  "text": "那现在，谁赢？"
 },
 {
  "start": 130.094,
  "end": 131.19,
  "text": "这局，平。"
 },
 {
  "start": 135.07,
  "end": 136.353,
  "text": "但故事还没完。"
 },
 {
  "start": 137.193,
  "end": 140.837,
  "text": "2025 年，增程全年销量超过 123"
 },
 {
  "start": 140.837,
  "end": 144.332,
  "text": "万辆，占新能源市场超过 10%。"
 },
 {
  "start": 145.052,
  "end": 147.116,
  "text": "2026 年前五个月，"
 },
 {
  "start": 147.116,
  "end": 150.224,
  "text": "41 万辆——同比下滑 9.7%。"
 },
 {
  "start": 151.004,
  "end": 154.26,
  "text": "5 月单月，同比跌 24.9%。"
 },
 {
  "start": 155.22,
  "end": 155.782,
  "text": "……跌了。"
 },
 {
  "start": 157.042,
  "end": 157.84,
  "text": "跌了多少？"
 },
 {
  "start": 158.56,
  "end": 160.169,
  "text": "百分之二十四点九。"
 },
 {
  "start": 161.489,
  "end": 165.322,
  "text": "纯电在涨。800V 高压平台下放到十几万"
 },
 {
  "start": 165.322,
  "end": 168.589,
  "text": "的车，充电五分钟能跑四百公里。"
 },
 {
  "start": 169.309,
  "end": 172.009,
  "text": "当年逼着人选增程的那个理由，"
 },
 {
  "start": 172.009,
  "end": 173.166,
  "text": "正在被拿走。"
 },
 {
  "start": 174.486,
  "end": 176.799,
  "text": "那我这本账，是不是也算错了？"
 },
 {
  "start": 177.999,
  "end": 178.712,
  "text": "账没错。"
 },
 {
  "start": 180.032,
  "end": 182.198,
  "text": "是账本背后的东西，变了。"
 },
 {
  "start": 185.958,
  "end": 187.401,
  "text": "两个人都不说话了。"
 },
 {
  "start": 188.481,
  "end": 191.31,
  "text": "桌上，多了一本新的空白手册。"
 },
 {
  "start": 192.63,
  "end": 193.89,
  "text": "这本，还没写。"
 },
 {
  "start": 194.91,
  "end": 195.934,
  "text": "那就先空着。"
 },
 {
  "start": 197.494,
  "end": 200.367,
  "text": "2020 年，增程被判了死刑。"
 },
 {
  "start": 201.027,
  "end": 203.037,
  "text": "2021 年，它翻了案。"
 },
 {
  "start": 203.697,
  "end": 207.278,
  "text": "2025 年，判它的人，自己开始造它。"
 },
 {
  "start": 207.938,
  "end": 210.837,
  "text": "2026 年，它自己也开始退潮。"
 },
 {
  "start": 211.917,
  "end": 213.368,
  "text": "没有永远的裁判。"
 },
 {
  "start": 214.568,
  "end": 217.066,
  "text": "只有不断被重新判决的技术。"
 },
 {
  "start": 220.506,
  "end": 223.495,
  "text": "本片人物为 AI 生成的虚构形象，"
 },
 {
  "start": 223.495,
  "end": 225.501,
  "text": "不代表任何真实人物；"
 },
 {
  "start": 225.501,
  "end": 228.491,
  "text": "本片画面与配音含 AI 辅助制作。"
 }
]