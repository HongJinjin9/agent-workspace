  "segments": [
    {
      "id": "COLD",
      "name": "冷开场",
      "start": 2.8,
      "dur": 13.3039,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "2020 年，一场关于技术路线的判决，从一张会议桌开始。",
          "start": 2.8,
          "end": 7.6789
        },
        {
          "i": 2,
          "speaker": "N",
          "text": "桌边坐着两个人。",
          "start": 8.9989,
          "end": 10.4036
        },
        {
          "i": 3,
          "speaker": "N",
          "text": "一个带着手册，一个带着账本。",
          "start": 11.6036,
          "end": 14.4239
        }
      ]
    },
    {
      "id": "ACT1",
      "name": "第一幕·立判",
      "start": 17.7039,
      "dur": 37.9924,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "2020 年 9 月 8 日，成都，一场媒体沟通会。",
          "start": 17.7039,
          "end": 21.7289
        },
        {
          "i": 2,
          "speaker": "N",
          "text": "大众集团中国区 CEO 冯思翰，被问到怎么看增程式电动车。",
          "start": 22.3889,
          "end": 27.319
        },
        {
          "i": 3,
          "speaker": "M",
          "text": "内燃机发电，再用电驱动车轮。",
          "start": 28.399,
          "end": 31.1226
        },
        {
          "i": 4,
          "speaker": "M",
          "text": "中间多一道转换，能量就多丢一次。",
          "start": 32.0226,
          "end": 35.1471
        },
        {
          "i": 5,
          "speaker": "M",
          "text": "这不是观点，这是热力学。",
          "start": 36.1071,
          "end": 38.2412
        },
        {
          "i": 6,
          "speaker": "L",
          "text": "账不是这么算的。",
          "start": 39.5612,
          "end": 40.7638
        },
        {
          "i": 7,
          "speaker": "M",
          "text": "那怎么算？",
          "start": 41.4238,
          "end": 42.1483
        },
        {
          "i": 8,
          "speaker": "L",
          "text": "用户不看你中间丢了多少。",
          "start": 42.9283,
          "end": 44.8823
        },
        {
          "i": 9,
          "speaker": "L",
          "text": "他看我一箱油能跑多远，看我在高速上敢不敢超车。",
          "start": 45.4223,
          "end": 49.5794
        },
        {
          "i": 10,
          "speaker": "M",
          "text": "这叫不算账。",
          "start": 50.4194,
          "end": 51.432
        },
        {
          "i": 11,
          "speaker": "L",
          "text": "这叫算别的账。",
          "start": 52.392,
          "end": 53.5363
        }
      ]
    },
    {
      "id": "ACT2",
      "name": "第二幕·验证",
      "start": 57.2963,
      "dur": 39.6628,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "一年后。2021 年 11 月。",
          "start": 57.2963,
          "end": 60.0548
        },
        {
          "i": 2,
          "speaker": "L",
          "text": "理想 ONE，单月上险——",
          "start": 61.0148,
          "end": 62.83
        },
        {
          "i": 3,
          "speaker": "L",
          "text": "一万三千四百三十八台。",
          "start": 63.43,
          "end": 65.4545
        },
        {
          "i": 4,
          "speaker": "M",
          "text": "多少？",
          "start": 66.2945,
          "end": 66.7667
        },
        {
          "i": 5,
          "speaker": "L",
          "text": "一、万、三、千、四、百、三、十、八。",
          "start": 67.4267,
          "end": 71.9411
        },
        {
          "i": 6,
          "speaker": "N",
          "text": "同一个月，大众旗下五款中大型 SUV——",
          "start": 73.2611,
          "end": 76.8936
        },
        {
          "i": 7,
          "speaker": "N",
          "text": "途昂、途锐、揽境、ID.6 X、ID.6 Crozz。",
          "start": 77.5536,
          "end": 82.1502
        },
        {
          "i": 8,
          "speaker": "N",
          "text": "加起来，一万二千四百四十五台。",
          "start": 82.8102,
          "end": 85.6699
        },
        {
          "i": 9,
          "speaker": "L",
          "text": "还差九百九十三台。",
          "start": 86.7499,
          "end": 88.4534
        },
        {
          "i": 10,
          "speaker": "N",
          "text": "李想在微博上，只发了八个字。",
          "start": 89.7734,
          "end": 92.3324
        },
        {
          "i": 11,
          "speaker": "M",
          "text": "……这一页，我记下来了。",
          "start": 93.2324,
          "end": 94.6791
        }
      ]
    },
    {
      "id": "ACT3",
      "name": "第三幕·改判",
      "start": 98.5591,
      "dur": 34.9108,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "又过了四年。",
          "start": 98.5591,
          "end": 99.6288
        },
        {
          "i": 2,
          "speaker": "N",
          "text": "2025 年 4 月，上海车展。大众发布三款概念车。",
          "start": 100.2888,
          "end": 105.2878
        },
        {
          "i": 3,
          "speaker": "N",
          "text": "其中一款，是增程。",
          "start": 106.0678,
          "end": 108.0057
        },
        {
          "i": 4,
          "speaker": "L",
          "text": "你在看什么？",
          "start": 109.3257,
          "end": 110.2996
        },
        {
          "i": 5,
          "speaker": "M",
          "text": "我在看，当年我划的这条线。",
          "start": 111.0196,
          "end": 113.1547
        },
        {
          "i": 6,
          "speaker": "N",
          "text": "上汽大众 ID.ERA 9X 上市。",
          "start": 114.7147,
          "end": 117.632
        },
        {
          "i": 7,
          "speaker": "N",
          "text": "官方对它的说法是——\"增程新王\"。",
          "start": 118.292,
          "end": 121.108
        },
        {
          "i": 8,
          "speaker": "M",
          "text": "规则没有变。",
          "start": 121.948,
          "end": 122.9719
        },
        {
          "i": 9,
          "speaker": "M",
          "text": "变的是，谁在按规则算账。",
          "start": 123.9919,
          "end": 126.4257
        },
        {
          "i": 10,
          "speaker": "L",
          "text": "那现在，谁赢？",
          "start": 127.8657,
          "end": 129.3138
        },
        {
          "i": 11,
          "speaker": "M",
          "text": "这局，平。",
          "start": 130.0938,
          "end": 131.1899
        }
      ]
    },
    {
      "id": "ACT4",
      "name": "第四幕·再判",
      "start": 135.0699,
      "dur": 49.2885,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "但故事还没完。",
          "start": 135.0699,
          "end": 136.3528
        },
        {
          "i": 2,
          "speaker": "L",
          "text": "2025 年，增程全年销量超过 123 万辆，占新能源市场超过 10%。",
          "start": 137.1928,
          "end": 144.3319
        },
        {
          "i": 3,
          "speaker": "L",
          "text": "2026 年前五个月，41 万辆——同比下滑 9.7%。",
          "start": 145.0519,
          "end": 150.224
        },
        {
          "i": 4,
          "speaker": "L",
          "text": "5 月单月，同比跌 24.9%。",
          "start": 151.004,
          "end": 154.2596
        },
        {
          "i": 5,
          "speaker": "L",
          "text": "……跌了。",
          "start": 155.2196,
          "end": 155.7823
        },
        {
          "i": 6,
          "speaker": "M",
          "text": "跌了多少？",
          "start": 157.0423,
          "end": 157.8405
        },
        {
          "i": 7,
          "speaker": "L",
          "text": "百分之二十四点九。",
          "start": 158.5605,
          "end": 160.1692
        },
        {
          "i": 8,
          "speaker": "N",
          "text": "纯电在涨。800V 高压平台下放到十几万的车，充电五分钟能跑四百公里。",
          "start": 161.4892,
          "end": 168.5891
        },
        {
          "i": 9,
          "speaker": "N",
          "text": "当年逼着人选增程的那个理由，正在被拿走。",
          "start": 169.3091,
          "end": 173.1661
        },
        {
          "i": 10,
          "speaker": "L",
          "text": "那我这本账，是不是也算错了？",
          "start": 174.4861,
          "end": 176.7991
        },
        {
          "i": 11,
          "speaker": "M",
          "text": "账没错。",
          "start": 177.9991,
          "end": 178.7118
        },
        {
          "i": 12,
          "speaker": "M",
          "text": "是账本背后的东西，变了。",
          "start": 180.0318,
          "end": 182.1984
        }
      ]
    },
    {
      "id": "CLOSE",
      "name": "收束",
      "start": 185.9584,
      "dur": 33.7472,
      "sentences": [
        {
          "i": 1,
          "speaker": "N",
          "text": "两个人都不说话了。",
          "start": 185.9584,
          "end": 187.4011
        },
        {
          "i": 2,
          "speaker": "N",
          "text": "桌上，多了一本新的空白手册。",
          "start": 188.4811,
          "end": 191.3099
        },
        {
          "i": 3,
          "speaker": "M",
          "text": "这本，还没写。",
          "start": 192.6299,
          "end": 193.8897
        },
        {
          "i": 4,
          "speaker": "L",
          "text": "那就先空着。",
          "start": 194.9097,
          "end": 195.9341
        },
        {
          "i": 5,
          "speaker": "N",
          "text": "2020 年，增程被判了死刑。",
          "start": 197.4941,
          "end": 200.3667
        },
        {
          "i": 6,
          "speaker": "N",
          "text": "2021 年，它翻了案。",
          "start": 201.0267,
          "end": 203.0374
        },
        {
          "i": 7,
          "speaker": "N",
          "text": "2025 年，判它的人，自己开始造它。",
          "start": 203.6974,
          "end": 207.278
        },
        {
          "i": 8,
          "speaker": "N",
          "text": "2026 年，它自己也开始退潮。",
          "start": 207.938,
          "end": 210.8366
        },
        {
          "i": 9,
          "speaker": "N",
          "text": "没有永远的裁判。",
          "start": 211.9166,
          "end": 213.3677
        },
        {
          "i": 10,
          "speaker": "N",
          "text": "只有不断被重新判决的技术。",
          "start": 214.5677,
          "end": 217.0656
        }
      ]
    }
  ]
}