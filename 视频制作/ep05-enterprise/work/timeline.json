 "outro_voice": {
  "text": "最后交代一句：本片画面与配音含 AI 辅助制作；选题、核实和判断，是人做的。",
  "start": 231.7966,
  "end": 238.7651
 },
 "segments": [
  {
   "id": "S1",
   "name": "钩子",
   "start": 2.2,
   "dur": 16.6632,
   "sentences": [
    {
     "i": 1,
     "text": "你有没有在那种公司待过。",
     "start": 2.2,
     "end": 4.1173
    },
    {
     "i": 2,
     "text": "一个决定，走五个部门，签七个字。",
     "start": 4.4473,
     "end": 7.3619
    },
    {
     "i": 3,
     "text": "等批下来，当初为什么要做这件事，已经没人记得了。",
     "start": 7.6819,
     "end": 11.5828
    },
    {
     "i": 4,
     "text": "我以前以为，这是管理没做好。",
     "start": 12.3028,
     "end": 14.3828
    },
    {
     "i": 5,
     "text": "后来发现，不是。",
     "start": 14.7128,
     "end": 15.9758
    },
    {
     "i": 6,
     "text": "这是「大」本身带的病。",
     "start": 16.6958,
     "end": 18.1432
    }
   ]
  },
  {
   "id": "S2",
   "name": "组合爆炸",
   "start": 19.8632,
   "dur": 37.6225,
   "sentences": [
    {
     "i": 1,
     "text": "法国有个数学家叫格雷卡纳斯，他算过一笔账。",
     "start": 19.8632,
     "end": 23.328
    },
    {
     "i": 2,
     "text": "一个人管三个下属，要考虑的关系是几对。",
     "start": 23.648,
     "end": 26.7619
    },
    {
     "i": 3,
     "text": "管十个人，是几十对。",
     "start": 27.0819,
     "end": 28.7972
    },
    {
     "i": 4,
     "text": "管二十个人，是几百对。",
     "start": 29.1172,
     "end": 30.9942
    },
    {
     "i": 5,
     "text": "下属人数按加法的速度涨，关系数按乘法的速度涨。",
     "start": 31.3542,
     "end": 35.2649
    },
    {
     "i": 6,
     "text": "这就是为什么，人一多，沟通就开始漏。",
     "start": 35.7449,
     "end": 38.754
    },
    {
     "i": 7,
     "text": "周雪光在讲中国官僚体制的时候，给它起了个名字，叫「组织规模负效率」——",
     "start": 39.114,
     "end": 44.7572
    },
    {
     "i": 8,
     "text": "随着组织扩大、等级链条延长，信息分布就越散，不对称就越严重，效率就往下走。",
     "start": 45.2072,
     "end": 51.6679
    },
    {
     "i": 9,
     "text": "这不是哪家公司的毛病。",
     "start": 52.3879,
     "end": 54.192
    },
    {
     "i": 10,
     "text": "这是所有大组织的出厂设置。",
     "start": 54.512,
     "end": 56.7657
    }
   ]
  },
  {
   "id": "S3",
   "name": "防御性结构",
   "start": 58.4857,
   "dur": 41.8499,
   "sentences": [
    {
     "i": 1,
     "text": "那为什么有些公司活得挺好？",
     "start": 58.4857,
     "end": 60.8366
    },
    {
     "i": 2,
     "text": "差别在，它怎么对付这种复杂。",
     "start": 61.1966,
     "end": 63.5674
    },
    {
     "i": 3,
     "text": "最省事的办法是加一层。",
     "start": 63.9274,
     "end": 65.9722
    },
    {
     "i": 4,
     "text": "但加层有个副作用。",
     "start": 66.3022,
     "end": 67.7287
    },
    {
     "i": 5,
     "text": "詹姆斯·威尔逊研究官僚组织，说过一句话：",
     "start": 68.1487,
     "end": 71.7691
    },
    {
     "i": 6,
     "text": "官僚系统的本质，是一种「防御性结构」——它更擅长防止错误，而不是创造价值。",
     "start": 72.0891,
     "end": 78.4867
    },
    {
     "i": 7,
     "text": "加一层，就多一道审批；",
     "start": 79.2067,
     "end": 81.2727
    },
    {
     "i": 8,
     "text": "多一道审批，就多一个「这事不归我管」。",
     "start": 81.5927,
     "end": 84.3685
    },
    {
     "i": 9,
     "text": "唐斯说得更直接：监控者把越来越复杂的规则压给执行部门，执行部门灵活办事的能力就下降了。",
     "start": 84.7285,
     "end": 92.2379
    },
    {
     "i": 10,
     "text": "于是成了一个圈：",
     "start": 92.6579,
     "end": 93.8584
    },
    {
     "i": 11,
     "text": "复杂，就加层；",
     "start": 94.1784,
     "end": 95.6982
    },
    {
     "i": 12,
     "text": "加了层，更复杂；",
     "start": 96.0182,
     "end": 97.6741
    },
    {
     "i": 13,
     "text": "更复杂，再加层。",
     "start": 97.9941,
     "end": 99.6156
    }
   ]
  },
  {
   "id": "S4",
   "name": "职责不清的真相",
   "start": 101.3356,
   "dur": 32.8472,
   "sentences": [
    {
     "i": 1,
     "text": "所以很多公司里那个「职责不清」，是怎么来的？",
     "start": 101.3356,
     "end": 105.0803
    },
    {
     "i": 2,
     "text": "大家通常觉得，是管理没做好。",
     "start": 105.5003,
     "end": 107.9697
    },
    {
     "i": 3,
     "text": "我看恰恰相反。",
     "start": 108.3297,
     "end": 109.6334
    },
    {
     "i": 4,
     "text": "职责不清，往往是因为每个部门都管理得太「好」了。",
     "start": 110.3534,
     "end": 114.5695
    },
    {
     "i": 5,
     "text": "每个人都理性地自保，少做少错，不做不错。",
     "start": 115.2895,
     "end": 119.0937
    },
    {
     "i": 6,
     "text": "每个环节都在避免「多做多错」。",
     "start": 119.4537,
     "end": 121.7722
    },
    {
     "i": 7,
     "text": "合起来，就是谁都不越界，谁都不担责，事情卡在缝里。",
     "start": 122.1622,
     "end": 126.4513
    },
    {
     "i": 8,
     "text": "这不是谁偷懒。",
     "start": 127.1713,
     "end": 128.4572
    },
    {
     "i": 9,
     "text": "这是所有人的理性，加在一起，变成了整体的不理性。",
     "start": 128.8772,
     "end": 133.3928
    }
   ]
  },
  {
   "id": "S5",
   "name": "变革疲劳",
   "start": 135.1828,
   "dur": 47.1217,
   "sentences": [
    {
     "i": 1,
     "text": "还有一个更隐蔽的代价。",
     "start": 135.1828,
     "end": 137.0512
    },
    {
     "i": 2,
     "text": "流程老在变，人就不信了。",
     "start": 137.4112,
     "end": 139.6091
    },
    {
     "i": 3,
     "text": "管理学里有个词，叫变革疲劳。",
     "start": 140.0291,
     "end": 142.4095
    },
    {
     "i": 4,
     "text": "有研究发现，反复重组会直接导致变革疲劳，然后员工就开始抵抗下一次变革。",
     "start": 142.8295,
     "end": 149.4263
    },
    {
     "i": 5,
     "text": "Gartner 有个数字：",
     "start": 149.9063,
     "end": 151.2872
    },
    {
     "i": 6,
     "text": "员工支持企业变革的意愿，2016 年是 74%，2022 年跌到 43%。",
     "start": 151.6072,
     "end": 157.6662
    },
    {
     "i": 7,
     "text": "Gallup 的调查说，73% 的员工表示，公司过去一年经历过破坏性变革。",
     "start": 158.3862,
     "end": 164.0734
    },
    {
     "i": 8,
     "text": "Prosci 给了个很准的定义：",
     "start": 164.5234,
     "end": 166.3043
    },
    {
     "i": 9,
     "text": "变革疲劳，发生在一个人或团队，至少超过了他们承受能力一个变革项目的时候。",
     "start": 166.6243,
     "end": 172.6572
    },
    {
     "i": 10,
     "text": "戴尔·卡内基有一句话说得很实：",
     "start": 173.1372,
     "end": 175.83
    },
    {
     "i": 11,
     "text": "员工不是不愿变革，是因为他们不觉得自己被装备好、被支持、被看见。",
     "start": 176.15,
     "end": 181.5845
    }
   ]
  },
  {
   "id": "S6",
   "name": "收束",
   "start": 183.3045,
   "dur": 48.0921,
   "sentences": [
    {
     "i": 1,
     "text": "那怎么办？",
     "start": 183.3045,
     "end": 184.0725
    },
    {
     "i": 2,
     "text": "我不打算给出成功学的三条。",
     "start": 184.4325,
     "end": 186.3698
    },
    {
     "i": 3,
     "text": "只说三个我信的方向。",
     "start": 186.7298,
     "end": 188.2615
    },
    {
     "i": 4,
     "text": "第一，承认「大」本身有代价。",
     "start": 188.7115,
     "end": 191.2296
    },
    {
     "i": 5,
     "text": "不要假装可以通过管理把它消灭。",
     "start": 191.5896,
     "end": 194.0797
    },
    {
     "i": 6,
     "text": "承认它，才会防它。",
     "start": 194.4397,
     "end": 196.3667
    },
    {
     "i": 7,
     "text": "第二，少加层，多加桥。",
     "start": 197.0867,
     "end": 199.0972
    },
    {
     "i": 8,
     "text": "佐丹奴当年决策链条太长，反应慢；Zara 扁平化，供应链快，就活下来了。",
     "start": 199.4872,
     "end": 205.3856
    },
    {
     "i": 9,
     "text": "区别不在谁更聪明，在谁的路径更短。",
     "start": 205.7756,
     "end": 208.7459
    },
    {
     "i": 10,
     "text": "第三，变革要有节奏。",
     "start": 209.4659,
     "end": 211.2569
    },
    {
     "i": 11,
     "text": "不是越多越好。",
     "start": 211.6169,
     "end": 212.7154
    },
    {
     "i": 12,
     "text": "一个组织能承受的变革是有上限的，超过了，最好的方案也会被执行成最坏的结果。",
     "start": 213.1054,
     "end": 219.6809
    },
    {
     "i": 13,
     "text": "说到底，公司变大不是错。",
     "start": 220.4009,
     "end": 222.5024
    },
    {
     "i": 14,
     "text": "错的是把「加层」当成唯一的解药。",
     "start": 222.9224,
     "end": 225.3803
    },
    {
     "i": 15,
     "text": "因为每加一层，你都离那个最初想解决的问题，远了一点。",
     "start": 226.1003,
     "end": 230.5366
    }
   ]
  }
 ],
