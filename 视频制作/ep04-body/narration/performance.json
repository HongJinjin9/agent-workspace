        {"i": 1, "text": "先说第一个。减速带。", "rate": "-2%", "pitch": "0Hz", "pause_after": 0.55, "note": "节奏点，干脆"},
        {"i": 2, "text": "你有没有注意过，好车过减速带是「咚」——一声，干净利落。", "rate": "-4%", "pitch": "0Hz", "pause_after": 0.50, "note": "「咚」字轻，破折号处停一下"},
        {"i": 3, "text": "有的车是「咣当」——一下，然后还晃三晃。", "rate": "-4%", "pitch": "-1Hz", "pause_after": 0.65, "note": "「咣当」「晃三晃」带一点表演"},
        {"i": 4, "text": "差别在哪？", "rate": "-2%", "pitch": "0Hz", "pause_after": 0.62, "note": "真提问，留白"},
        {"i": 5, "text": "车身压在一根弹簧上，它有自己爱晃的频率，大概是 1 到 2 赫兹，也就是一秒晃一到两下。", "rate": "-3%", "pitch": "0Hz", "pause_after": 0.55, "note": "数字清楚但不炫技"},
        {"i": 6, "text": "车轮在弹簧下面，更轻更硬，它晃得快得多，10 到 15 赫兹。", "rate": "-3%", "pitch": "0Hz", "pause_after": 0.50, "note": "与上一句形成快慢对照"},
        {"i": 7, "text": "而人的身体，对 4 到 8 赫兹的上下振动最敏感。", "rate": "-6%", "pitch": "-1Hz", "pause_after": 0.78, "note": "本段关键事实，放慢"},
        {"i": 8, "text": "所以关键，其实不在于「软」还是「硬」。", "rate": "-8%", "pitch": "-1Hz", "pause_after": 0.62, "note": "先否定常见答案"},
        {"i": 9, "text": "关键在于阻尼——冲击来了，它能不能一次就收住。", "rate": "-10%", "pitch": "-1Hz", "pause_after": 0.82, "note": "「阻尼」放慢，全段核心"},
