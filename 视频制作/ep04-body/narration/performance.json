      "sentences": [
        {"i": 1, "text": "我一直有个想不明白的事。", "rate": "-6%", "pitch": "-1Hz", "pause_after": 0.72, "note": "轻声起句，落下来，不上扬"},
        {"i": 2, "text": "同一段路，同样一张参数表，为什么有的车坐上去，你会松一口气；", "rate": "-4%", "pitch": "-1Hz", "pause_after": 0.30, "note": "列举推进，重音在“同一段路”“参数表”"},
        {"i": 3, "text": "有的车，你会不自觉地抓紧扶手？", "rate": "-6%", "pitch": "-2Hz", "pause_after": 0.82, "note": "把问题交给观众，句尾轻微上扬"},
